-- ============================================================
-- CUSTOM HEAD ACCESSORIES (Poisoned / Fiery Horns)
-- Korblox/FX3 style: local Part + SpecialMesh + Weld to Head (no catalog load)
-- Mesh 215680403 | Poisoned tex 1744057070 | Fiery tex 215676264
-- ============================================================
do
    -- Per-item mesh/texture (wiki catalog pages)
    local HORNS = {
        Poisoned = {
            tag = "CustomHorns_Poisoned",
            mesh = "rbxassetid://215680403",
            texture = "rbxassetid://1744057070",
            fire = true,
            fireColor = Color3.fromRGB(80, 255, 40),
            fireSec = Color3.fromRGB(20, 120, 20),
            c0 = CFrame.new(0, 1.08, 0),
        },
        Fiery = {
            tag = "CustomHorns_Fiery",
            mesh = "rbxassetid://215680403",
            texture = "rbxassetid://215676264",
            fire = true,
            fireColor = Color3.fromRGB(255, 120, 20),
            fireSec = Color3.fromRGB(255, 40, 0),
            c0 = CFrame.new(0, 1.08, 0),
        },
        Valkyrie = {
            tag = "CustomHorns_Valkyrie",
            mesh = "rbxassetid://1365696",   -- Valkyrie Helm mesh
            texture = "rbxassetid://1365693", -- Valkyrie Helm texture
            fire = false,
            c0 = CFrame.new(0, 0.95, 0), -- raised to sit properly on head
        },
    }

    M._hornsConns = M._hornsConns or {}

    local function clearHornsConns(key)
        local list = M._hornsConns[key]
        if list then
            for _, c in ipairs(list) do
                pcall(function() c:Disconnect() end)
            end
        end
        M._hornsConns[key] = {}
    end

    local function addHornsConn(key, conn)
        M._hornsConns[key] = M._hornsConns[key] or {}
        table.insert(M._hornsConns[key], conn)
        return conn
    end

    local function destroyTaggedHorns(char, tag)
        if not char then return end
        for _, v in ipairs(char:GetChildren()) do
            if v.Name == tag or (typeof(v.GetAttribute) == "function" and v:GetAttribute("CustomHornsTag") == tag) then
                pcall(function() v:Destroy() end)
            end
        end
        local head = char:FindFirstChild("Head")
        if head then
            for _, v in ipairs(head:GetChildren()) do
                if v.Name == tag or (typeof(v.GetAttribute) == "function" and v:GetAttribute("CustomHornsTag") == tag) then
                    pcall(function() v:Destroy() end)
                end
            end
        end
    end

    local function tryLoadCatalogAccessory(catalogId)
        local acc = nil
        pcall(function()
            if typeof(game.GetObjects) == "function" then
                local objs = game:GetObjects("rbxassetid://" .. tostring(catalogId))
                if objs and objs[1] then acc = objs[1] end
            end
        end)
        if not acc then
            pcall(function()
                local model = game:GetService("InsertService"):LoadAsset(catalogId)
                if model then
                    acc = model:FindFirstChildOfClass("Accessory")
                        or model:FindFirstChildWhichIsA("Accessory", true)
                        or model:FindFirstChildOfClass("Hat")
                    if not acc and model:IsA("Accessory") then acc = model end
                end
            end)
        end
        if acc and not acc:IsA("Accessory") and not acc:IsA("Hat") then
            local nested = acc:FindFirstChildOfClass("Accessory") or acc:FindFirstChildWhichIsA("Accessory", true)
            if nested then
                nested = nested:Clone()
                pcall(function() acc:Destroy() end)
                acc = nested
            end
        end
        return acc
    end

    -- Build like KorbloxLeg: Part + SpecialMesh + Weld, OR load catalog accessory
    local function buildHornsPart(info, head)
        local char = head.Parent
        local hum = char and char:FindFirstChildOfClass("Humanoid")

        -- UGC / catalog path (Star Crown etc.)
        if info.catalogId then
            local acc = tryLoadCatalogAccessory(info.catalogId)
            if acc then
                acc.Name = info.tag
                pcall(function() acc:SetAttribute("CustomHornsTag", info.tag) end)
                if hum then
                    pcall(function() hum:AddAccessory(acc) end)
                end
                if acc.Parent == nil then
                    acc.Parent = char
                    local handle = acc:FindFirstChild("Handle")
                    if handle then
                        local w = Instance.new("Weld")
                        w.Name = "CustomHornsWeld"
                        w.Part0 = head
                        w.Part1 = handle
                        w.C0 = info.c0 or CFrame.new(0, 0.7, 0)
                        w.Parent = handle
                    end
                end
                return acc
            end
            warn("[kyzen] catalog accessory load failed: " .. tostring(info.catalogId))
            return nil
        end

        local part = Instance.new("Part")
        part.Name = info.tag
        part.Size = Vector3.new(1, 1, 1)
        part.Transparency = 0
        part.CanCollide = false
        part.CanQuery = false
        part.CanTouch = false
        part.Massless = true
        part.Anchored = false
        part.CastShadow = true
        pcall(function() part:SetAttribute("CustomHornsTag", info.tag) end)
        part.Parent = char -- character model (same as KorbloxLeg)

        local mesh = Instance.new("SpecialMesh")
        mesh.Name = "HornsMesh"
        mesh.MeshType = Enum.MeshType.FileMesh
        mesh.MeshId = info.mesh
        mesh.TextureId = info.texture
        mesh.Scale = Vector3.new(1, 1, 1)
        mesh.Parent = part

        if info.fire then
            local fire = Instance.new("Fire")
            fire.Name = "HornsFire"
            fire.Size = 2.2
            fire.Heat = 5
            fire.Color = info.fireColor
            fire.SecondaryColor = info.fireSec
            fire.Parent = part
        end

        local weld = Instance.new("Weld")
        weld.Name = "CustomHornsWeld"
        weld.Part0 = head
        weld.Part1 = part
        weld.C0 = info.c0 or CFrame.new(0, 0.7, 0)
        weld.Parent = part

        return part
    end

    function M.clearCustomHorns(char, which)
        char = char or player.Character
        if not char then return end
        local keys = which and { which } or { "Poisoned", "Fiery", "Valkyrie" }
        for _, key in ipairs(keys) do
            local info = HORNS[key]
            if info then
                clearHornsConns(info.tag)
                destroyTaggedHorns(char, info.tag)
            end
        end
    end

    function M.applyCustomHorns(char, which)
        char = char or player.Character
        if not char then return end
        local head = char:FindFirstChild("Head")
        if not head then
            head = char:WaitForChild("Head", 3)
        end
        if not head then return end

        local keys = which and { which } or { "Poisoned", "Fiery", "Valkyrie" }
        for _, key in ipairs(keys) do
            local info = HORNS[key]
            if not info then continue end

            local enabled = (key == "Poisoned" and M.poisonedHornsEnabled)
                or (key == "Fiery" and M.fieryHornsEnabled)
                or (key == "Valkyrie" and M.valkyrieHelmEnabled)

            clearHornsConns(info.tag)
            destroyTaggedHorns(char, info.tag)

            if not enabled then continue end

            local ok, err = pcall(function()
                buildHornsPart(info, head)
            end)
            if not ok then
                warn("[kyzen] horns apply failed: " .. tostring(err))
            end

            -- Re-apply if something destroys the part (FX3, remove accessories, etc.)
            addHornsConn(info.tag, char.ChildRemoved:Connect(function(child)
                if child.Name ~= info.tag and child:GetAttribute("CustomHornsTag") ~= info.tag then
                    return
                end
                local stillOn = (key == "Poisoned" and M.poisonedHornsEnabled)
                    or (key == "Fiery" and M.fieryHornsEnabled)
                    or (key == "Valkyrie" and M.valkyrieHelmEnabled)
                if not stillOn then return end
                task.delay(0.15, function()
                    if not char or not char.Parent then return end
                    stillOn = (key == "Poisoned" and M.poisonedHornsEnabled)
                        or (key == "Fiery" and M.fieryHornsEnabled)
                        or (key == "Valkyrie" and M.valkyrieHelmEnabled)
                    if not stillOn then return end
                    if not char:FindFirstChild(info.tag) then
                        pcall(function() M.applyCustomHorns(char, key) end)
                    end
                end)
            end))
        end
    end

    function M.applyAllCustomHorns(char)
        M.applyCustomHorns(char, nil)
    end

    -- Same spawn timing style as charter (Headless/Korblox)
    if M._hornsCharAdded then
        pcall(function() M._hornsCharAdded:Disconnect() end)
    end
    M._hornsCharAdded = player.CharacterAdded:Connect(function(c)
        task.wait(0.2)
        if M.poisonedHornsEnabled or M.fieryHornsEnabled or M.valkyrieHelmEnabled then
            pcall(function() M.applyAllCustomHorns(c) end)
        end
    end)

    task.spawn(function()
        if (M.poisonedHornsEnabled or M.fieryHornsEnabled or M.valkyrieHelmEnabled) and player.Character then
            task.wait(0.25)
            pcall(function() M.applyAllCustomHorns(player.Character) end)
        end
    end)
end

-- ============================================================
-- SKIN COMBOS (save / load avatar skin presets)
-- ============================================================
do
    function M.snapshotSkinCombo()
        return {
            headless = M.headlessEnabled == true,
            korblox = M.korbloxEnabled == true,
            fx3 = M.fx3Enabled == true,
            fx3Variant = M.fx3Variant or "Black",
            poisoned = M.poisonedHornsEnabled == true,
            fiery = M.fieryHornsEnabled == true,
            valk = M.valkyrieHelmEnabled == true,
            shirt = M.customShirt or "None",
            pants = M.customPants or "None",
        }
    end

    function M.getSkinComboNames()
        local names = {}
        for name in pairs(M.skinCombos or {}) do
            table.insert(names, name)
        end
        table.sort(names)
        return names
    end

    function M.saveSkinCombo(name)
        name = tostring(name or ""):gsub("^%s+", ""):gsub("%s+$", "")
        if name == "" or name == "None" then
            return false, "invalid name"
        end
        M.skinCombos = M.skinCombos or {}
        M.skinCombos[name] = M.snapshotSkinCombo()
        M.skinComboSelected = name
        pcall(function() if type(saveCherryConfig) == "function" then saveCherryConfig() end end)
        return true
    end

    function M.deleteSkinCombo(name)
        name = tostring(name or "")
        if not M.skinCombos or not M.skinCombos[name] then
            return false, "not found"
        end
        M.skinCombos[name] = nil
        if M.skinComboSelected == name then
            M.skinComboSelected = "None"
        end
        pcall(function() if type(saveCherryConfig) == "function" then saveCherryConfig() end end)
        return true
    end

    function M.applySkinCombo(name)
        local combo = M.skinCombos and M.skinCombos[name]
        if not combo then
            return false, "not found"
        end
        M.skinComboSelected = name

        M.headlessEnabled = combo.headless == true
        M.korbloxEnabled = combo.korblox == true
        M.fx3Enabled = combo.fx3 == true
        M.fx3Variant = combo.fx3Variant or "Black"
        M.poisonedHornsEnabled = combo.poisoned == true
        M.fieryHornsEnabled = combo.fiery == true
        M.valkyrieHelmEnabled = combo.valk == true
        M.customShirt = combo.shirt or "None"
        M.customPants = combo.pants or "None"

        local char = player.Character
        if char then
            -- order: charter -> clothing -> fx3 -> horns (horns after fx3 wipe)
            pcall(function()
                if M.applyCharterToChar then M.applyCharterToChar(char) end
            end)
            pcall(function()
                if M.applyCustomClothing then M.applyCustomClothing(char) end
            end)
            if M.fx3Enabled then
                pcall(function() if M.applyAvatarFX3 then M.applyAvatarFX3(char) end end)
            else
                pcall(function() if M.clearAvatarFX3 then M.clearAvatarFX3(char) end end)
            end
            task.defer(function()
                if not char or not char.Parent then return end
                pcall(function()
                    if M.applyAllCustomHorns then M.applyAllCustomHorns(char) end
                end)
            end)
        end

        pcall(function() if type(saveCherryConfig) == "function" then saveCherryConfig() end end)
        return true
    end
end

-- ============================================================
-- CUSTOM CLOTHING (Shirts / Pants)
-- ============================================================
do
    local SHIRTS = {
        CyberY2K  = 14170222665,
        Vkei      = 98593483529471,
        PinkAnime = 16300488206,
        Y2KA      = 114981569019395,
        Y2KB      = 101849068911391,
    }
    local PANTS = {
        Polo   = 84077295836297,
        EmoY2K = 110871132349654,
        White  = 8437577912,
        Y2KA   = 12073038211,
        Y2KB   = 11494847724,
    }

    local function reapplyCharterVisuals(char)
        task.defer(function()
            if not char or not char.Parent then return end
            pcall(function()
                if M.applyCharterToChar then M.applyCharterToChar(char) end
            end)
            if M.poisonedHornsEnabled or M.fieryHornsEnabled or M.valkyrieHelmEnabled then
                task.wait(0.05)
                pcall(function() if M.applyAllCustomHorns then M.applyAllCustomHorns(char) end end)
            end
            if M.fx3Enabled and M.applyAvatarFX3 then
                task.wait(0.05)
                pcall(function() M.applyAvatarFX3(char) end)
                task.wait(0.1)
                pcall(function() if M.applyAllCustomHorns then M.applyAllCustomHorns(char) end end)
            end
        end)
    end

    function M.applyCustomClothing(char)
        char = char or player.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum then return end

        local shirtKey = M.customShirt or "None"
        local pantsKey = M.customPants or "None"
        local shirtId = (shirtKey ~= "None") and SHIRTS[shirtKey] or nil
        local pantsId = (pantsKey ~= "None") and PANTS[pantsKey] or nil

        pcall(function()
            local desc = hum:GetAppliedDescription()
            if shirtId then desc.Shirt = shirtId end
            if pantsId then desc.Pants = pantsId end
            hum:ApplyDescription(desc)
        end)

        local function applyTemplate(className, prop, id)
            if not id then return end
            local inst = char:FindFirstChildOfClass(className)
            if not inst then
                inst = Instance.new(className)
                inst.Name = className
                inst.Parent = char
            end
            pcall(function() inst[prop] = "rbxassetid://" .. tostring(id) end)
            pcall(function()
                if not inst[prop] or inst[prop] == "" or inst[prop] == "rbxassetid://0" then
                    inst[prop] = "http://www.roblox.com/asset/?id=" .. tostring(id)
                end
            end)
            task.spawn(function()
                local loaded = nil
                pcall(function()
                    if typeof(game.GetObjects) == "function" then
                        local objs = game:GetObjects("rbxassetid://" .. tostring(id))
                        loaded = objs and objs[1]
                    end
                end)
                if not loaded then
                    pcall(function() loaded = game:GetService("InsertService"):LoadAsset(id) end)
                end
                if loaded then
                    local src = loaded:FindFirstChildOfClass(className) or (loaded:IsA(className) and loaded)
                    if src and src[prop] and src[prop] ~= "" then
                        pcall(function()
                            local i = char:FindFirstChildOfClass(className) or Instance.new(className)
                            i.Name = className
                            i[prop] = src[prop]
                            i.Parent = char
                        end)
                    end
                    pcall(function() loaded:Destroy() end)
                end
            end)
        end
        applyTemplate("Shirt", "ShirtTemplate", shirtId)
        applyTemplate("Pants", "PantsTemplate", pantsId)
        reapplyCharterVisuals(char)
    end

    player.CharacterAdded:Connect(function(c)
        task.wait(0.4)
        if (M.customShirt and M.customShirt ~= "None") or (M.customPants and M.customPants ~= "None") then
            pcall(function() M.applyCustomClothing(c) end)
        end
    end)

    task.spawn(function()
        if not player.Character then return end
        task.wait(0.45)
        if (M.customShirt and M.customShirt ~= "None") or (M.customPants and M.customPants ~= "None") then
            pcall(function() M.applyCustomClothing(player.Character) end)
        end
    end)
end

-- ============================================================
-- FX3 Avatar Blackout + Davidsterne Krone (on execute + respawn)
-- ============================================================
do
    local BLACK = Color3.fromRGB(0, 0, 0)
    local FX_NAME = "FX3_AvatarBlackout"
    local STAR_COUNT = 5 -- FPS FIX: was 8 (each star = many parts every frame)
    local RADIUS = 0.95
    local HEIGHT_ABOVE_HEAD = 0.7
    local ORBIT_SPEED = 0.8
    local SPIN_SPEED = 1.6
    local STAR_SIZE = 0.7
    local BAR_WIDTH = 0.07
    local CORE_DEPTH = 0.03
    local BEVEL = 0.038
    local SWAY = 0.025
    local STAR_COLOR = Color3.fromRGB(0, 0, 0) -- updated per apply
    local STAR_MATERIAL = Enum.Material.SmoothPlastic

    local function newPart(class, size, parent)
        local p = Instance.new(class)
        p.Size = size
        p.Color = BLACK
        p.Material = Enum.Material.SmoothPlastic
        p.CanCollide = false
        p.CanQuery = false
        p.CanTouch = false
        p.Massless = true
        p.Parent = parent
        return p
    end

    local function weld(part, to, cf)
        part.CFrame = to.CFrame * cf
        local w = Instance.new("Weld")
        w.Part0 = to
        w.Part1 = part
        w.C0 = cf
        w.Parent = part
    end

    local function createDavidStar(parent)
        local model = Instance.new("Model")
        model.Name = "Davidstern"
        model.Parent = parent

        local side = STAR_SIZE
        local inradius = side / (2 * math.sqrt(3))
        local parts = {}

        local function addBar(baseAngle)
            local barCF = CFrame.Angles(0, 0, baseAngle) * CFrame.new(0, inradius, 0)

            local core = Instance.new("Part")
            core.Size = Vector3.new(side, BAR_WIDTH, CORE_DEPTH)
            core.Color = STAR_COLOR
            core.Material = STAR_MATERIAL
            core.Reflectance = 0.06
            core.Anchored = true
            core.CanCollide = false
            core.CanQuery = false
            core.CanTouch = false
            core.CastShadow = false
            core.Parent = model
            parts[#parts + 1] = { part = core, offset = barCF }

            for _, dir in ipairs({1, -1}) do
                for _, sideSign in ipairs({1, -1}) do
                    local w = Instance.new("WedgePart")
                    w.Size = Vector3.new(side, BEVEL, BAR_WIDTH / 2)
                    w.Color = STAR_COLOR
                    w.Material = STAR_MATERIAL
                    w.Reflectance = 0.06
                    w.Anchored = true
                    w.CanCollide = false
                    w.CanQuery = false
                    w.CanTouch = false
                    w.CastShadow = false
                    w.Parent = model

                    local off = barCF
                        * CFrame.new(0, sideSign * BAR_WIDTH / 4, dir * (CORE_DEPTH / 2 + BEVEL / 2))
                        * CFrame.Angles(0, 0, math.rad(90))
                        * CFrame.Angles(math.rad(dir > 0 and -90 or 90), 0, 0)
                        * CFrame.Angles(0, sideSign > 0 and 0 or math.rad(180), 0)

                    parts[#parts + 1] = { part = w, offset = off }
                end
            end
        end

        for tri = 0, 1 do
            for i = 0, 2 do
                addBar(math.rad(tri * 180 + i * 120))
            end
        end

        return model, parts
    end

    function M.clearAvatarFX3(char)
        char = char or player.Character
        M._fx3AppliedChar = nil
        M._fx3AppliedVariant = nil
        if char then
            local old = char:FindFirstChild(FX_NAME)
            if old then pcall(function() old:Destroy() end) end
            -- restore head / limb visibility that FX3 hid
            local head = char:FindFirstChild("Head")
            if head then
                pcall(function() head.Transparency = 0 end)
            end
            for _, n in ipairs({"Right Leg", "RightUpperLeg", "RightLowerLeg", "RightFoot"}) do
                local p = char:FindFirstChild(n)
                if p and p:IsA("BasePart") then
                    pcall(function() p.Transparency = 0; p.CanCollide = true end)
                end
            end
            -- NEVER ApplyDescription here — it resets the character and kills Animate.
            pcall(function()
                if M.restoreAnimateScript then M.restoreAnimateScript(char) end
            end)
            task.spawn(function()
                task.wait(0.15)
                if not char or not char.Parent then return end
                if M.unwalkEnabled then return end
                pcall(function()
                    local anim = char:FindFirstChild("Animate")
                    if anim and (anim:IsA("LocalScript") or anim:IsA("Script")) then
                        anim.Disabled = false
                    end
                end)
                if M.animPackEnabled and M.animPack and M.applyAnimPack then
                    pcall(function() M.applyAnimPack(M.animPack) end)
                end
            end)
        end
        local cam = workspace.CurrentCamera
        if cam then
            local oldCrown = cam:FindFirstChild("DavidsterneKrone")
            if oldCrown then pcall(function() oldCrown:Destroy() end) end
        end
        if M._fx3CrownConn then
            pcall(function() M._fx3CrownConn:Disconnect() end)
            M._fx3CrownConn = nil
        end
    end

    function M.applyAvatarFX3(char)
        if not char then return end
        if not M.fx3Enabled then
            M.clearAvatarFX3(char)
            return
        end
        -- never strip Animate — keep locomotion working under FX3
        pcall(function()
            local anim = char:FindFirstChild("Animate")
            if anim and anim:IsA("LocalScript") then anim.Disabled = false end
        end)
        local hum = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 8)
        if not hum then return end
        local root = char:FindFirstChild("HumanoidRootPart") or char:WaitForChild("HumanoidRootPart", 8)
        if not root then return end

        local bodyCol = (M.fx3Variant == "White") and Color3.fromRGB(245, 245, 250) or Color3.fromRGB(0, 0, 0)
        local starCol = bodyCol
        STAR_COLOR = starCol
        BLACK = bodyCol -- body paint uses BLACK var in newPart helper
        local existingFx = char:FindFirstChild(FX_NAME)
        if existingFx and M._fx3AppliedChar == char and M._fx3AppliedVariant == M.fx3Variant then
            return
        end
        M._fx3AppliedChar = char
        M._fx3AppliedVariant = M.fx3Variant

        local old = existingFx
        if old then old:Destroy() end

        local cam = workspace.CurrentCamera
        if cam then
            local oldCrown = cam:FindFirstChild("DavidsterneKrone")
            if oldCrown then oldCrown:Destroy() end
        end

        local fx = Instance.new("Folder")
        fx.Name = FX_NAME
        fx.Parent = char

        for _, d in ipairs(char:GetChildren()) do
            if d:IsA("Accessory") or d:IsA("Hat") then
                pcall(function() d:Destroy() end)
            end
        end

        local head = char:FindFirstChild("Head")
        if head then
            for _, d in ipairs(head:GetChildren()) do
                if d:IsA("Accessory") or d:IsA("Decal") or d:IsA("SpecialMesh") or d.Name == "face" then
                    pcall(function() d:Destroy() end)
                end
            end
        end

        local bc = char:FindFirstChildOfClass("BodyColors")
        if not bc then
            bc = Instance.new("BodyColors")
            bc.Parent = char
        end
        bc.HeadColor3 = bodyCol
        bc.TorsoColor3 = bodyCol
        bc.LeftArmColor3 = bodyCol
        bc.RightArmColor3 = bodyCol
        bc.LeftLegColor3 = bodyCol
        bc.RightLegColor3 = bodyCol

        for _, d in ipairs(char:GetDescendants()) do
            if d:IsA("BasePart") then
                d.Color = bodyCol
                d.Material = Enum.Material.SmoothPlastic
            elseif d:IsA("Shirt") or d:IsA("Pants") or d:IsA("ShirtGraphic") then
                pcall(function() d:Destroy() end)
            end
        end

        if head then
            head.Transparency = 1
            for _, d in ipairs(head:GetDescendants()) do
                if d:IsA("Decal") or d:IsA("Texture") then
                    pcall(function() d:Destroy() end)
                end
            end
        end

        for _, n in ipairs({"Right Leg", "RightUpperLeg", "RightLowerLeg", "RightFoot"}) do
            local p = char:FindFirstChild(n)
            if p then
                p.Transparency = 1
                p.CanCollide = false
                for _, d in ipairs(p:GetDescendants()) do
                    if d:IsA("Decal") or d:IsA("Texture") then
                        pcall(function() d:Destroy() end)
                    end
                end
            end
        end

        if head then
            local firePart = newPart("Part", Vector3.new(0.35, 0.35, 0.35), fx)
            firePart.Transparency = 1
            firePart.Shape = Enum.PartType.Ball
            weld(firePart, head, CFrame.new(0, 0.05, 0))

            local fire = Instance.new("ParticleEmitter")
            fire.Name = "WhiteFire"
            fire.Texture = "rbxassetid://241650934"
            fire.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0,   Color3.fromRGB(255, 255, 255)),
                ColorSequenceKeypoint.new(0.3, Color3.fromRGB(245, 250, 255)),
                ColorSequenceKeypoint.new(0.7, Color3.fromRGB(200, 220, 255)),
                ColorSequenceKeypoint.new(1,   Color3.fromRGB(160, 190, 255))
            })
            fire.Size = NumberSequence.new({
                NumberSequenceKeypoint.new(0,   0.25),
                NumberSequenceKeypoint.new(0.3, 0.55),
                NumberSequenceKeypoint.new(0.7, 0.4),
                NumberSequenceKeypoint.new(1,   0.1)
            })
            fire.Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0,   0.1),
                NumberSequenceKeypoint.new(0.5, 0.25),
                NumberSequenceKeypoint.new(1,   1)
            })
            fire.Lifetime = NumberRange.new(0.25, 0.45)
            fire.Rate = 70
            fire.Speed = NumberRange.new(1.8, 3.2)
            fire.SpreadAngle = Vector2.new(12, 12)
            fire.Rotation = NumberRange.new(0, 360)
            fire.RotSpeed = NumberRange.new(-120, 120)
            fire.LightEmission = 0.9
            fire.LightInfluence = 0
            fire.Acceleration = Vector3.new(0, 8, 0)
            fire.Drag = 3
            fire.Parent = firePart

            local fireCore = fire:Clone()
            fireCore.Rate = 40
            fireCore.Size = NumberSequence.new({
                NumberSequenceKeypoint.new(0,   0.15),
                NumberSequenceKeypoint.new(0.4, 0.35),
                NumberSequenceKeypoint.new(1,   0.05)
            })
            fireCore.Speed = NumberRange.new(1.2, 2.2)
            fireCore.Lifetime = NumberRange.new(0.2, 0.35)
            fireCore.Parent = firePart

            local sparks = Instance.new("ParticleEmitter")
            sparks.Name = "Sparks"
            sparks.Texture = "rbxassetid://241650934"
            sparks.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255))
            sparks.Size = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 0.08),
                NumberSequenceKeypoint.new(1, 0.02)
            })
            sparks.Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 0.2),
                NumberSequenceKeypoint.new(1, 1)
            })
            sparks.Lifetime = NumberRange.new(0.15, 0.3)
            sparks.Rate = 18
            sparks.Speed = NumberRange.new(3, 6)
            sparks.SpreadAngle = Vector2.new(25, 25)
            sparks.LightEmission = 1
            sparks.Acceleration = Vector3.new(0, 4, 0)
            sparks.Parent = firePart
        end

        local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
        if torso then
            local mount = CFrame.new(0.18, 0.05, 0.65) * CFrame.Angles(math.rad(5), math.rad(8), math.rad(28))

            local kashira = newPart("Part", Vector3.new(0.145, 0.08, 0.145), fx)
            kashira.Color = Color3.fromRGB(30, 30, 30)
            kashira.Material = Enum.Material.Metal
            weld(kashira, torso, mount * CFrame.new(0, -1.12, 0))

            local tsuka = newPart("Part", Vector3.new(0.125, 0.72, 0.125), fx)
            tsuka.Color = Color3.fromRGB(22, 22, 22)
            weld(tsuka, torso, mount * CFrame.new(0, -0.72, 0))

            for i = 1, 6 do
                local wrap = newPart("Part", Vector3.new(0.135, 0.038, 0.135), fx)
                wrap.Color = Color3.fromRGB(48, 48, 48)
                weld(wrap, torso, mount * CFrame.new(0, -0.95 + (i * 0.095), 0))
            end

            local tsuba = newPart("Part", Vector3.new(0.52, 0.045, 0.32), fx)
            tsuba.Color = Color3.fromRGB(28, 28, 28)
            tsuba.Material = Enum.Material.Metal
            weld(tsuba, torso, mount * CFrame.new(0, -0.28, 0))

            local habaki = newPart("Part", Vector3.new(0.15, 0.09, 0.09), fx)
            habaki.Color = Color3.fromRGB(55, 55, 55)
            habaki.Material = Enum.Material.Metal
            habaki.Reflectance = 0.25
            weld(habaki, torso, mount * CFrame.new(0, -0.18, 0))

            local blade = newPart("Part", Vector3.new(0.065, 1.95, 0.032), fx)
            blade.Color = Color3.fromRGB(235, 238, 245)
            blade.Material = Enum.Material.Metal
            blade.Reflectance = 0.55
            weld(blade, torso, mount * CFrame.new(0, 0.82, 0))

            local tip = newPart("WedgePart", Vector3.new(0.032, 0.28, 0.065), fx)
            tip.Color = blade.Color
            tip.Material = Enum.Material.Metal
            tip.Reflectance = 0.55
            weld(tip, torso, mount * CFrame.new(0, 1.88, 0) * CFrame.Angles(0, 0, math.rad(90)))

            local saya = newPart("Part", Vector3.new(0.115, 1.85, 0.085), fx)
            saya.Color = Color3.fromRGB(10, 10, 10)
            weld(saya, torso, mount * CFrame.new(0, 0.72, 0.085))

            local kojiri = newPart("Part", Vector3.new(0.13, 0.11, 0.1), fx)
            kojiri.Color = Color3.fromRGB(25, 25, 25)
            kojiri.Material = Enum.Material.Metal
            weld(kojiri, torso, mount * CFrame.new(0, 1.72, 0.085))

            local kurikata = newPart("Part", Vector3.new(0.04, 0.08, 0.06), fx)
            kurikata.Color = Color3.fromRGB(40, 40, 40)
            weld(kurikata, torso, mount * CFrame.new(0.08, 0.35, 0.12))
        end

        if not cam then return end
        local crownFolder = Instance.new("Folder")
        crownFolder.Name = "DavidsterneKrone"
        crownFolder.Parent = cam

        local stars = {}
        for i = 1, STAR_COUNT do
            local model, parts = createDavidStar(crownFolder)
            stars[i] = {
                parts = parts,
                angle = (i - 1) * (math.pi * 2 / STAR_COUNT),
            }
        end

        if M._fx3CrownConn then
            pcall(function() M._fx3CrownConn:Disconnect() end)
            M._fx3CrownConn = nil
        end

        -- FPS FIX: Heartbeat + skip frames (~30 Hz) — crown is cosmetic only
        local _fxAcc = 0
        M._fx3CrownConn = RunService.Heartbeat:Connect(function(dt)
            _fxAcc = _fxAcc + (dt or 0.016)
            if _fxAcc < 0.033 then return end
            _fxAcc = 0
            if not char or not char.Parent then
                if M._fx3CrownConn then M._fx3CrownConn:Disconnect(); M._fx3CrownConn = nil end
                if crownFolder then pcall(function() crownFolder:Destroy() end) end
                return
            end
            local h = char:FindFirstChild("Head")
            if not h then return end
            local basePos = h.Position + Vector3.new(0, HEIGHT_ABOVE_HEAD, 0)
            local tt = tick()
            for _, star in ipairs(stars) do
                local a = star.angle + tt * ORBIT_SPEED
                local pos = basePos + Vector3.new(
                    math.cos(a) * RADIUS,
                    math.sin(tt * 1.2 + a) * SWAY,
                    math.sin(a) * RADIUS
                )
                local starCF = CFrame.new(pos, pos + Vector3.new(math.cos(a), 0, math.sin(a)))
                    * CFrame.Angles(0, 0, tt * SPIN_SPEED)
                for _, e in ipairs(star.parts) do
                    e.part.CFrame = starCF * e.offset
                end
            end
        end)

        -- Keep locomotion alive after visual strip (FX3 must not leave Animate disabled)
        if not M.unwalkEnabled then
            pcall(function()
                local anim = char:FindFirstChild("Animate")
                if anim and (anim:IsA("LocalScript") or anim:IsA("Script")) then
                    anim.Disabled = false
                end
            end)
            task.defer(function()
                if M.unwalkEnabled or not char or not char.Parent then return end
                if M.animPackEnabled and M.animPack and M.applyAnimPack then
                    pcall(function() M.applyAnimPack(M.animPack) end)
                end
                local anim = char:FindFirstChild("Animate")
                if anim and (anim:IsA("LocalScript") or anim:IsA("Script")) and anim.Disabled then
                    anim.Disabled = false
                end
            end)
        end
    end

    -- Apply on execute + respawn only when enabled
    task.spawn(function()
        if M.fx3Enabled and player.Character then
            task.wait(0.4)
            pcall(function() M.applyAvatarFX3(player.Character) end)
            if M.poisonedHornsEnabled or M.fieryHornsEnabled or M.valkyrieHelmEnabled then
                task.wait(0.2)
                pcall(function() M.applyAllCustomHorns(player.Character) end)
            end
        elseif (M.poisonedHornsEnabled or M.fieryHornsEnabled or M.valkyrieHelmEnabled) and player.Character then
            task.wait(0.4)
            pcall(function() M.applyAllCustomHorns(player.Character) end)
        end
    end)
    player.CharacterAdded:Connect(function(c)
        task.wait(0.7)
        if M.fx3Enabled then
            pcall(function() M.applyAvatarFX3(c) end)
        end
        if M.poisonedHornsEnabled or M.fieryHornsEnabled or M.valkyrieHelmEnabled then
            task.wait(0.25)
            pcall(function() M.applyAllCustomHorns(c) end)
        end
    end)
end


-- Animation keep-alive: if Unwalk is off, never leave Animate.Disabled stuck true
task.spawn(function()
    while true do
        task.wait(1.25)
        if M.unwalkEnabled then continue end
        local char = player.Character
        if not char then continue end
        local anim = char:FindFirstChild("Animate")
        if anim and (anim:IsA("LocalScript") or anim:IsA("Script")) and anim.Disabled then
            anim.Disabled = false
        end
    end
end)


-- Keep steal bar alive (prevent accidental wipe / parent loss)
if not M._stealBarKeepAlive then
    M._stealBarKeepAlive = true
    task.spawn(function()
        while true do
            task.wait(2.5)
            local ok = false
            pcall(function()
                if M.statusGui and M.statusGui.Parent then ok = true end
            end)
            if not ok then
                pcall(function() M.buildStatusUI() end)
            end
        end
    end)
end

print("kyzen.vs loaded successfully!")
return M
