-- RADIO (Juke Box) – creds to 7up
-- ============================================================
local SoundService = game:GetService("SoundService")
M.Radio = {
    enabled = false,
    sound = nil,
    playing = false,
    volume = 1.0,
    songIdx = 1,
    looped = true,
    status = "READY",
}
M.Radio.SONGS = {
    {name = "Blue Bands",    url = "https://files.catbox.moe/mzvrir.mp3", file = "KyzenRadio_1.mp3"},
    {name = "Legacy",        url = "https://files.catbox.moe/siru6c.mp3", file = "KyzenRadio_2.mp3"},
    {name = "paznerknacker", url = "https://files.catbox.moe/izcvhm.mp3", file = "KyzenRadio_3.mp3"},
    {name = "Tesla",         url = "https://files.catbox.moe/n85fch.mp3", file = "KyzenRadio_4.mp3"},
    {name = "King Nasir",    url = "https://files.catbox.moe/etk99y.mp3", file = "KyzenRadio_5.mp3"},
    {name = "Pure Cocaine",  url = "https://files.catbox.moe/dvjtjk.mp3", file = "KyzenRadio_6.mp3"},
    {name = "nuts",          url = "https://files.catbox.moe/iyw1cb.mp3", file = "KyzenRadio_7.mp3"},
    {name = "Gelato",        url = "https://files.catbox.moe/zf2z42.mp3", file = "KyzenRadio_8.mp3"},
    {name = "FREAKED OUT",   url = "https://files.catbox.moe/dyt2ja.mp3", file = "KyzenRadio_9.mp3"},
    {name = "Scam Likely",   url = "https://files.catbox.moe/pr85mz.mp3", file = "KyzenRadio_10.mp3"},
}
M.Radio._cache, M.Radio._downloading = {}, {}
M.Radio._titleLbl, M.Radio._statusLbl, M.Radio._volLbl = nil, nil, nil

local function radioHttpGet(url)
    local data
    pcall(function()
        if game.HttpGet then data = game:HttpGet(url) end
    end)
    if (not data or #data == 0) then
        local req = request or http_request or (syn and syn.request)
            or (http and http.request) or nil
        if req then
            pcall(function()
                local res = req({Url = url, Method = "GET"})
                if res then data = res.Body or res.body end
            end)
        end
    end
    return data
end

function M.Radio.cacheSong(option)
    if not option or not option.url then return nil end
    local fileName = option.file or "KyzenRadio.mp3"
    if M.Radio._cache[fileName] then return M.Radio._cache[fileName] end

    local hasFile = false
    pcall(function()
        if isfile then hasFile = isfile(fileName) end
    end)
    if hasFile and getcustomasset then
        local ok, asset = pcall(function() return getcustomasset(fileName) end)
        if ok and asset then
            M.Radio._cache[fileName] = asset
            return asset
        end
    end

    if M.Radio._downloading[fileName] then
        local t0 = tick()
        while M.Radio._downloading[fileName] and tick() - t0 < 15 do task.wait(0.05) end
        return M.Radio._cache[fileName]
    end

    M.Radio._downloading[fileName] = true
    local data = radioHttpGet(option.url)
    if data and #data > 0 then
        pcall(function()
            if writefile then writefile(fileName, data) end
            if getcustomasset then
                M.Radio._cache[fileName] = getcustomasset(fileName)
            else
                M.Radio._cache[fileName] = option.url
            end
        end)
    else
        M.Radio._cache[fileName] = option.url
    end
    M.Radio._downloading[fileName] = nil
    return M.Radio._cache[fileName]
end

function M.Radio.stop()
    M.Radio.playing = false
    if M.Radio.sound then
        pcall(function() M.Radio.sound:Stop() end)
        pcall(function() M.Radio.sound:Destroy() end)
        M.Radio.sound = nil
    end
    M.Radio.status = "STOPPED"
    if M.Radio._statusLbl then M.Radio._statusLbl.Text = "STOPPED" end
end

function M.Radio.play(idx)
    idx = idx or M.Radio.songIdx or 1
    local songs = M.Radio.SONGS
    if idx < 1 then idx = #songs end
    if idx > #songs then idx = 1 end
    M.Radio.songIdx = idx
    M.Radio.stop()
    local option = songs[idx]
    if not option then return end

    task.spawn(function()
        M.Radio.status = "LOADING..."
        if M.Radio._statusLbl then M.Radio._statusLbl.Text = "LOADING..." end
        if M.Radio._titleLbl then M.Radio._titleLbl.Text = option.name end
        local soundId = M.Radio.cacheSong(option)
        if not soundId then
            M.Radio.status = "LOAD FAILED"
            if M.Radio._statusLbl then M.Radio._statusLbl.Text = "LOAD FAILED" end
            return
        end
        if M.Radio.songIdx ~= idx then return end

        local sound = Instance.new("Sound")
        sound.Name = "KyzenRadioSound"
        sound.Volume = math.clamp(M.Radio.volume, 0, 5)
        sound.Looped = M.Radio.looped
        sound.SoundId = tostring(soundId)
        sound.Parent = SoundService
        M.Radio.sound = sound

        local t0 = tick()
        while sound.Parent and not sound.IsLoaded and tick() - t0 < 15 do task.wait(0.05) end
        if M.Radio.sound ~= sound then pcall(function() sound:Destroy() end); return end

        M.Radio.playing = true
        pcall(function() sound:Play() end)
        M.Radio.status = "PLAYING"
        if M.Radio._statusLbl then M.Radio._statusLbl.Text = "PLAYING" end
        if M.Radio._titleLbl then M.Radio._titleLbl.Text = option.name end

        sound.Ended:Connect(function()
            if not M.Radio.looped then
                M.Radio.playing = false
                M.Radio.status = "STOPPED"
                if M.Radio._statusLbl then M.Radio._statusLbl.Text = "STOPPED" end
            end
        end)
    end)
end

function M.Radio.setVolume(v)
    M.Radio.volume = math.clamp(tonumber(v) or 1, 0, 5)
    if M.Radio.sound then pcall(function() M.Radio.sound.Volume = M.Radio.volume end) end
    if M.Radio._volLbl then
        M.Radio._volLbl.Text = string.format("VOL %.0f%%", M.Radio.volume * 100)
    end
end

function M.Radio.toggle()
    if M.Radio.sound and M.Radio.sound.IsPlaying then
        M.Radio.sound:Pause()
        M.Radio.playing = false
        M.Radio.status = "PAUSED"
        if M.Radio._statusLbl then M.Radio._statusLbl.Text = "PAUSED" end
    elseif M.Radio.sound and not M.Radio.sound.IsPlaying and M.Radio.sound.TimePosition > 0 then
        M.Radio.sound:Resume()
        M.Radio.playing = true
        M.Radio.status = "PLAYING"
        if M.Radio._statusLbl then M.Radio._statusLbl.Text = "PLAYING" end
    else
        M.Radio.play(M.Radio.songIdx)
    end
end

function M.Radio.prev()
    M.Radio.play((M.Radio.songIdx or 1) - 1)
end

function M.Radio.next()
    M.Radio.play((M.Radio.songIdx or 1) + 1)
end

function M.Radio.setLooped(on)
    M.Radio.looped = on == true
    if M.Radio.sound then pcall(function() M.Radio.sound.Looped = M.Radio.looped end) end
end

function M.Radio.closeUI()
    if M.Radio._gui and M.Radio._gui.Parent then
        pcall(function() M.Radio._gui:Destroy() end)
    end
    M.Radio._gui = nil
    M.Radio._uiOpen = false
end

function M.Radio.openUI()
    if M.Radio._gui and M.Radio._gui.Parent then
        -- already open → bring to front / show
        M.Radio._gui.Enabled = true
        return
    end
    M.Radio.closeUI()

    local parent = nil
    pcall(function() if gethui then parent = gethui() end end)
    if not parent then
        pcall(function() parent = game:GetService("CoreGui") end)
    end
    if not parent then
        parent = player:FindFirstChild("PlayerGui") or player:WaitForChild("PlayerGui", 2)
    end
    if not parent then return end

    local WHITE       = Color3.fromRGB(255, 255, 255)
    local WHITE_SOFT  = Color3.fromRGB(245, 245, 245)
    local BLACK       = Color3.fromRGB(0, 0, 0)
    local GRAY_BORDER = Color3.fromRGB(200, 200, 200)
    local GRAY_HINT   = Color3.fromRGB(80, 80, 80)
    local songs = M.Radio.SONGS

    local gui = Instance.new("ScreenGui")
    gui.Name = "KyzenRadioUI"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.DisplayOrder = 55
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.Parent = parent
    M.Radio._gui = gui
    M.Radio._uiOpen = true

    local frame = Instance.new("Frame")
    frame.Name = "RadioFrame"
    frame.Size = UDim2.new(0, 320, 0, 210)
    frame.Position = UDim2.new(0.5, -160, 0.72, 0)
    frame.BackgroundColor3 = WHITE
    frame.BorderSizePixel = 0
    frame.Active = true
    frame.Parent = gui
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 14)
    local stroke = Instance.new("UIStroke", frame)
    stroke.Color = GRAY_BORDER
    stroke.Thickness = 2

    local bar = Instance.new("TextLabel", frame)
    bar.Size = UDim2.new(1, -40, 0, 28)
    bar.Position = UDim2.new(0, 12, 0, 6)
    bar.BackgroundTransparency = 1
    bar.Text = "RADIO"
    bar.TextColor3 = BLACK
    bar.Font = Enum.Font.GothamBlack
    bar.TextSize = 16
    bar.TextXAlignment = Enum.TextXAlignment.Left

    local cred = Instance.new("TextLabel", frame)
    cred.Size = UDim2.new(0, 90, 0, 18)
    cred.Position = UDim2.new(1, -130, 0, 10)
    cred.BackgroundTransparency = 1
    cred.Text = "creds 7up"
    cred.TextColor3 = GRAY_HINT
    cred.Font = Enum.Font.Gotham
    cred.TextSize = 10
    cred.TextXAlignment = Enum.TextXAlignment.Right

    local closeBtn = Instance.new("TextButton", frame)
    closeBtn.Size = UDim2.new(0, 28, 0, 28)
    closeBtn.Position = UDim2.new(1, -34, 0, 6)
    closeBtn.BackgroundColor3 = WHITE_SOFT
    closeBtn.Text = "X"
    closeBtn.TextColor3 = BLACK
    closeBtn.Font = Enum.Font.GothamBold
    closeBtn.TextSize = 14
    Instance.new("UICorner", closeBtn).CornerRadius = UDim.new(0, 8)
    Instance.new("UIStroke", closeBtn).Color = GRAY_BORDER
    closeBtn.MouseButton1Click:Connect(function()
        M.Radio.closeUI()
    end)

    local titleLbl = Instance.new("TextLabel", frame)
    titleLbl.Size = UDim2.new(1, -24, 0, 22)
    titleLbl.Position = UDim2.new(0, 12, 0, 36)
    titleLbl.BackgroundTransparency = 1
    titleLbl.Text = (songs[M.Radio.songIdx or 1] and songs[M.Radio.songIdx or 1].name) or "—"
    titleLbl.TextColor3 = BLACK
    titleLbl.Font = Enum.Font.GothamBold
    titleLbl.TextSize = 14
    titleLbl.TextXAlignment = Enum.TextXAlignment.Left
    titleLbl.TextTruncate = Enum.TextTruncate.AtEnd
    M.Radio._titleLbl = titleLbl

    local statusLbl = Instance.new("TextLabel", frame)
    statusLbl.Size = UDim2.new(0, 100, 0, 18)
    statusLbl.Position = UDim2.new(1, -112, 0, 38)
    statusLbl.BackgroundTransparency = 1
    statusLbl.Text = M.Radio.status or "READY"
    statusLbl.TextColor3 = BLACK
    statusLbl.Font = Enum.Font.Gotham
    statusLbl.TextSize = 12
    statusLbl.TextXAlignment = Enum.TextXAlignment.Right
    M.Radio._statusLbl = statusLbl

    local function makeBtn(text, x, w, fn)
        local b = Instance.new("TextButton", frame)
        b.Size = UDim2.new(0, w, 0, 34)
