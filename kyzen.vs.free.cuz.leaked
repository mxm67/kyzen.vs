        if M._pcListeningKey then return end
        M._pcListeningKey = true
        KeyText.Text = "PRESS KEY..."
        local g = KeyText:FindFirstChild("ShinyGrad")
        if g then g.Enabled = false end
        KeyText.TextColor3 = Color3.fromRGB(255, 200, 110)
    end)

    local function setGlow(on)
        if M._pcGlowConn then
            pcall(function() M._pcGlowConn:Disconnect() end)
            M._pcGlowConn = nil
        end
        if not on then
            toggleStroke.Transparency = 0.25
            rootStroke.Transparency = 0.55
            avatarStroke.Transparency = 0.45
            return
        end
        local t0 = tick()
        M._pcGlowConn = RunService.Heartbeat:Connect(function()
            if not M._pcLagActive then return end
            local a = (math.sin((tick() - t0) * 5) + 1) * 0.5
            local t = 0.05 + a * 0.4
            toggleStroke.Transparency = t
            rootStroke.Transparency = 0.25 + a * 0.35
            avatarStroke.Transparency = 0.15 + a * 0.35
        end)
    end

    function M._pcLaggerUpdateUI()
        if M._pcLagActive then
            StatusLabel.Text = "STATUS  ACTIVE"
            ToggleText.Text = "LAG  ·  ON"
            toggleStroke.Color = Color3.fromRGB(255, 255, 255)
            TogglePill.BackgroundColor3 = Color3.fromRGB(32, 32, 38)
            rootStroke.Color = Color3.fromRGB(255, 255, 255)
            avatarStroke.Color = Color3.fromRGB(255, 255, 255)
            M.pcLaggerApplyShiny(ToggleText, 0.9, true)
            M.pcLaggerApplyShiny(StatusLabel, 0.85, true)
            setGlow(true)
        else
            StatusLabel.Text = "STATUS  IDLE"
            ToggleText.Text = "LAG  ·  OFF"
            toggleStroke.Color = Color3.fromRGB(255, 80, 80)
            TogglePill.BackgroundColor3 = Color3.fromRGB(28, 28, 34)
            rootStroke.Color = Color3.fromRGB(255, 255, 255)
            avatarStroke.Color = Color3.fromRGB(255, 255, 255)
            M.pcLaggerApplyShiny(ToggleText, 0.5, false)
            M.pcLaggerApplyShiny(StatusLabel, 0.45, false)
            setGlow(false)
        end
        local kb = M.pcLaggerKeybind or Enum.KeyCode.M
        if not M._pcListeningKey then
            KeyText.Text = "KEY  ·  " .. kb.Name
        end
    end
    M._pcLaggerUpdateUI()

    MinBtn.MouseButton1Click:Connect(function()
        M.pcLaggerMinimized = not M.pcLaggerMinimized
        if M.pcLaggerMinimized then
            Content.Visible = false
            Root.Size = UDim2.new(0, 360, 0, 48)
            MinBtn.Text = "+"
        else
            Content.Visible = true
            Root.Size = UDim2.new(0, 360, 0, 128)
            MinBtn.Text = "–"
        end
        pcall(saveCherryConfig)
    end)

    if M.pcLaggerMinimized then
        Content.Visible = false
        Root.Size = UDim2.new(0, 360, 0, 48)
        MinBtn.Text = "+"
    end

    local dragging, dragStart, startPos = false, nil, nil
    Top.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = Root.Position
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if not screenGui.Parent or not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            local d = input.Position - dragStart
            Root.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    UIS.InputBegan:Connect(function(input, gameProcessed)
        if not screenGui.Parent then return end
        if gameProcessed then return end
        if M._pcListeningKey then
            if input.KeyCode ~= Enum.KeyCode.Unknown then
                M.pcLaggerKeybind = input.KeyCode
                KeyText.Text = "KEY  ·  " .. input.KeyCode.Name
                KeyText.TextColor3 = TEXT_LIGHT
                M.pcLaggerApplyShiny(KeyText, 0.5, false)
                M._pcListeningKey = false
                pcall(saveCherryConfig)
            end
            return
        end
        local kb = M.pcLaggerKeybind or Enum.KeyCode.M
        if input.KeyCode == kb then
            M.pcLaggerToggle()
        end
    end)

    player.CharacterAdded:Connect(function()
        if not screenGui.Parent then return end
        task.wait(1)
        if M._pcLagActive then
            M.pcLaggerToggle()
            task.wait(0.1)
            M.pcLaggerToggle()
        end
    end)
end

function M.setPcLagger(on)
    M.pcLaggerEnabled = on == true
    if M.pcLaggerEnabled then
        M.buildPcLagger()
    else
        M.destroyPcLagger()
    end
    pcall(saveCherryConfig)
end

