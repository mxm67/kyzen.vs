    -- ── MUSIC / RADIO (creds to 7up) ──
    uiSectionHeader(PBuiltIn, "MUSIC – CREDS TO 7UP")
    do
        local songs = M.Radio.SONGS
        local songNames = {}
        for i, s in ipairs(songs) do songNames[i] = s.name end

        -- Title + status row
        local infoRow = Instance.new("Frame")
        infoRow.ClipsDescendants = true
        infoRow.Size = UDim2.new(1, 0, 0, 46)
        infoRow.BackgroundColor3 = UI_ROW_BG
        infoRow.BackgroundTransparency = 0.03
        infoRow.BorderSizePixel = 0
        infoRow.Parent = PBuiltIn
        uiCardStyle(infoRow)
        local titleL = Instance.new("TextLabel")
        titleL.Position = UDim2.new(0, 13, 0, 0)
        titleL.Size = UDim2.new(0.62, 0, 1, 0)
        titleL.BackgroundTransparency = 1
        titleL.Text = songs[M.Radio.songIdx or 1].name
        titleL.TextColor3 = UI_TEXT_PRIMARY
        titleL.TextSize = 13
        titleL.Font = Enum.Font.GothamBold
        titleL.TextXAlignment = Enum.TextXAlignment.Left
        titleL.TextTruncate = Enum.TextTruncate.AtEnd
        titleL.Parent = infoRow
        M.Radio._titleLbl = titleL
        local statusL = Instance.new("TextLabel")
        statusL.Position = UDim2.new(0.62, 0, 0, 0)
        statusL.Size = UDim2.new(0.38, -10, 1, 0)
        statusL.BackgroundTransparency = 1
        statusL.Text = M.Radio.status or "READY"
        statusL.TextColor3 = UI_ACCENT
        statusL.TextSize = 11
        statusL.Font = Enum.Font.GothamMedium
        statusL.TextXAlignment = Enum.TextXAlignment.Right
        statusL.Parent = infoRow
        M.Radio._statusLbl = statusL

        -- Song cycle
        local songIdx = M.Radio.songIdx or 1
        if uiCycleRow then
            uiCycleRow(PBuiltIn, "Track", songNames, songIdx, function(name)
                for i, n in ipairs(songNames) do
                    if n == name then
                        M.Radio.songIdx = i
                        if M.Radio._titleLbl then M.Radio._titleLbl.Text = name end
                        if M.Radio.playing then M.Radio.play(i) end
                        break
                    end
                end
            end)
        else
            local r = Instance.new("Frame"); r.ClipsDescendants=true; r.Size=UDim2.new(1,0,0,46)
            r.BackgroundColor3=UI_ROW_BG; r.BackgroundTransparency=0.03; r.BorderSizePixel=0; r.Parent=PBuiltIn; uiCardStyle(r)
            local l = Instance.new("TextLabel"); l.Position=UDim2.new(0,13,0,0); l.Size=UDim2.new(0.35,0,1,0)
            l.BackgroundTransparency=1; l.Text="Track"; l.TextColor3=UI_TEXT_PRIMARY; l.TextSize=13; l.Font=Enum.Font.GothamMedium; l.TextXAlignment=Enum.TextXAlignment.Left; l.Parent=r
            local v = Instance.new("TextLabel"); v.Position=UDim2.new(0.35,0,0,0); v.Size=UDim2.new(0.65,-10,1,0)
            v.BackgroundTransparency=1; v.Text=songNames[songIdx] or ""; v.TextColor3=UI_ACCENT; v.Font=Enum.Font.GothamBold; v.TextSize=11; v.TextXAlignment=Enum.TextXAlignment.Right; v.Parent=r
            local btn = Instance.new("TextButton", r); btn.Size=UDim2.new(1,0,1,0); btn.BackgroundTransparency=1; btn.Text=""
            btn.Activated:Connect(function()
                songIdx = (songIdx % #songNames) + 1
                M.Radio.songIdx = songIdx
                v.Text = songNames[songIdx]
                if M.Radio._titleLbl then M.Radio._titleLbl.Text = songNames[songIdx] end
                if M.Radio.playing then M.Radio.play(songIdx) end
            end)
        end

        uiActionRow(PBuiltIn, "Open Radio UI", function() M.Radio.openUI() end)
        uiActionRow(PBuiltIn, "Close Radio UI", function() M.Radio.closeUI() end)
        uiActionRow(PBuiltIn, "◀  Prev Track", function() M.Radio.prev() end)
        uiActionRow(PBuiltIn, "▶ / ❚❚  Play / Pause", function() M.Radio.toggle() end)
        uiActionRow(PBuiltIn, "▶▶  Next Track", function() M.Radio.next() end)
        uiActionRow(PBuiltIn, "■  Stop Radio", function() M.Radio.stop() end)

        local _, volBox = uiNumberRow(PBuiltIn, "Volume", M.Radio.volume, 0, 5, function(v)
            M.Radio.setVolume(v)
        end)
        M.Radio._volLbl = nil -- status shown via statusL

        local _, setLoopVis = uiToggleRow(PBuiltIn, "Loop", M.Radio.looped == true, function(on)
            M.Radio.setLooped(on)
        end)
    end

