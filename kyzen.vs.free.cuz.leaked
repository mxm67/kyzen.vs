    Orange = Color3.fromRGB(255, 160, 60),
    Purple = Color3.fromRGB(180, 100, 255),
}

local HEADLESS_MESH_ID = "rbxassetid://1095708"
local KORBLOX_MESH_ID = "rbxassetid://101851696"
local KORBLOX_TEXTURE_ID = "rbxassetid://101851254"
local DARK_GREY_COLOR = Color3.fromRGB(64, 64, 64)

local function removeFace(head)
    local face = head:FindFirstChild("face")
    if face then face:Destroy() end
end

-- Charter connection registry (prevents stacking leaks)
M._charterConns = M._charterConns or {}

local function clearCharterConns(key)
    local list = M._charterConns[key]
    if list then
        for _, c in ipairs(list) do
            pcall(function() c:Disconnect() end)
        end
    end
    M._charterConns[key] = {}
end

local function addCharterConn(key, conn)
    M._charterConns[key] = M._charterConns[key] or {}
    table.insert(M._charterConns[key], conn)
    return conn
end

function M.applyHeadlessToChar(char, enabled)
    if not char then return end
    local head = char:FindFirstChild("Head")
    if not head then return end

    clearCharterConns("headless")

    -- Always strip our mesh first
    for _, child in ipairs(head:GetChildren()) do
        if child:IsA("SpecialMesh") and (child.Name == "HeadlessMesh" or child.MeshId == HEADLESS_MESH_ID) then
            pcall(function() child:Destroy() end)
        end
    end

    if enabled then
        head.Transparency = 1
        head.CanCollide = false
        removeFace(head)
        for _, d in ipairs(head:GetChildren()) do
            if d:IsA("Decal") or d:IsA("Texture") then pcall(function() d:Destroy() end) end
        end
        local mesh = Instance.new("SpecialMesh")
        mesh.MeshType = Enum.MeshType.FileMesh
        mesh.MeshId = HEADLESS_MESH_ID
        mesh.Scale = Vector3.new(0.001, 0.001, 0.001)
        mesh.Name = "HeadlessMesh"
        mesh.Parent = head
        addCharterConn("headless", head:GetPropertyChangedSignal("Transparency"):Connect(function()
            if M.headlessEnabled and head.Parent and head.Transparency ~= 1 then
                head.Transparency = 1
            end
        end))
        addCharterConn("headless", head.ChildAdded:Connect(function(child)
            if not M.headlessEnabled then return end
            if child.Name == "face" or child:IsA("Decal") then
                task.defer(function() pcall(function() child:Destroy() end) end)
            end
        end))
    else
        head.Transparency = 0
        head.CanCollide = true
        -- face comes back on respawn; do not force-remove
    end
end

function M.applyKorbloxToChar(char, enabled)
    if not char then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end

    clearCharterConns("korblox")

    -- Cleanup any previous korblox parts/meshes
    local oldLeg = char:FindFirstChild("KorbloxLeg")
    if oldLeg then pcall(function() oldLeg:Destroy() end) end
    local r6leg = char:FindFirstChild("Right Leg")
    if r6leg then
        for _, child in ipairs(r6leg:GetChildren()) do
            if child:IsA("SpecialMesh") and child.Name == "KorbloxMesh" then
                pcall(function() child:Destroy() end)
            end
        end
    end
    for _, n in ipairs({"RightUpperLeg", "RightLowerLeg", "RightFoot"}) do
        local p = char:FindFirstChild(n)
        if p then
            if not enabled then
                p.Transparency = 0
            end
        end
    end

    if not enabled then
        return
    end

    if humanoid.RigType == Enum.HumanoidRigType.R6 then
        local rightLeg = char:FindFirstChild("Right Leg")
        if not rightLeg then return end
        local mesh = Instance.new("SpecialMesh")
        mesh.MeshType = Enum.MeshType.FileMesh
        mesh.MeshId = KORBLOX_MESH_ID
        mesh.TextureId = KORBLOX_TEXTURE_ID
        mesh.Scale = Vector3.new(1, 1, 1)
        mesh.Name = "KorbloxMesh"
        mesh.Parent = rightLeg
        rightLeg.Color = DARK_GREY_COLOR
    else
        -- R15: hide real leg parts, attach cosmetic leg to UpperLeg
        local rightUpperLeg = char:FindFirstChild("RightUpperLeg")
        if not rightUpperLeg then return end
        local rightLowerLeg = char:FindFirstChild("RightLowerLeg")
        local rightFoot = char:FindFirstChild("RightFoot")
        if rightLowerLeg then rightLowerLeg.Transparency = 1 end
        if rightFoot then rightFoot.Transparency = 1 end
        rightUpperLeg.Transparency = 1

        local korbloxLeg = Instance.new("Part")
        korbloxLeg.Name = "KorbloxLeg"
        korbloxLeg.Size = Vector3.new(1, 2, 1)
        korbloxLeg.Massless = true
        korbloxLeg.CanCollide = false
        korbloxLeg.CanQuery = false
        korbloxLeg.CanTouch = false
        korbloxLeg.Anchored = false
        korbloxLeg.Color = DARK_GREY_COLOR
        korbloxLeg.Parent = char

        local mesh = Instance.new("SpecialMesh")
        mesh.MeshType = Enum.MeshType.FileMesh
        mesh.MeshId = KORBLOX_MESH_ID
        mesh.TextureId = KORBLOX_TEXTURE_ID
        mesh.Scale = Vector3.new(1, 1, 1)
        mesh.Name = "KorbloxMesh"
        mesh.Parent = korbloxLeg

        local weld = Instance.new("Weld")
        weld.Part0 = rightUpperLeg
        weld.Part1 = korbloxLeg
        weld.C0 = CFrame.new(0, -0.85, 0)
        weld.Name = "KorbloxWeld"
        weld.Parent = korbloxLeg
    end
end

function M.applyCharterToChar(char)
    if not char then return end
    M.applyHeadlessToChar(char, M.headlessEnabled)
    M.applyKorbloxToChar(char, M.korbloxEnabled)
end

-- Only on spawn / toggle — NEVER every Heartbeat (was major FPS leak)
if M._charterCharAdded then
    pcall(function() M._charterCharAdded:Disconnect() end)
end
M._charterCharAdded = player.CharacterAdded:Connect(function(char)
    task.wait(0.15)
    M.applyCharterToChar(char)
end)

