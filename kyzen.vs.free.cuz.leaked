        b.TextColor3 = BLACK
        b.Font = Enum.Font.GothamBold
        b.TextSize = 13
        Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)
        Instance.new("UIStroke", b).Color = GRAY_BORDER
        b.MouseButton1Click:Connect(fn)
        return b
    end

    makeBtn("◀", 12, 44, function() M.Radio.prev() end)
    makeBtn("▶ / ❚❚", 64, 90, function() M.Radio.toggle() end)
    makeBtn("▶▶", 162, 44, function() M.Radio.next() end)
    makeBtn("STOP", 214, 90, function() M.Radio.stop() end)

    local volLbl = Instance.new("TextLabel", frame)
    volLbl.Size = UDim2.new(0, 90, 0, 20)
    volLbl.Position = UDim2.new(0, 12, 0, 116)
    volLbl.BackgroundTransparency = 1
    volLbl.Text = string.format("VOL %.0f%%", (M.Radio.volume or 1) * 100)
    volLbl.TextColor3 = BLACK
    volLbl.Font = Enum.Font.Gotham
    volLbl.TextSize = 12
    M.Radio._volLbl = volLbl

    local volDown = Instance.new("TextButton", frame)
    volDown.Size = UDim2.new(0, 36, 0, 28)
    volDown.Position = UDim2.new(0, 110, 0, 112)
    volDown.BackgroundColor3 = WHITE_SOFT
    volDown.Text = "-"
    volDown.TextColor3 = BLACK
    volDown.Font = Enum.Font.GothamBold
    volDown.TextSize = 18
    Instance.new("UICorner", volDown).CornerRadius = UDim.new(0, 6)
    Instance.new("UIStroke", volDown).Color = GRAY_BORDER
    volDown.MouseButton1Click:Connect(function() M.Radio.setVolume((M.Radio.volume or 1) - 0.1) end)

    local volUp = Instance.new("TextButton", frame)
    volUp.Size = UDim2.new(0, 36, 0, 28)
    volUp.Position = UDim2.new(0, 154, 0, 112)
    volUp.BackgroundColor3 = WHITE_SOFT
    volUp.Text = "+"
    volUp.TextColor3 = BLACK
    volUp.Font = Enum.Font.GothamBold
    volUp.TextSize = 18
    Instance.new("UICorner", volUp).CornerRadius = UDim.new(0, 6)
    Instance.new("UIStroke", volUp).Color = GRAY_BORDER
    volUp.MouseButton1Click:Connect(function() M.Radio.setVolume((M.Radio.volume or 1) + 0.1) end)

    local loopBtn = Instance.new("TextButton", frame)
    loopBtn.Size = UDim2.new(0, 90, 0, 28)
    loopBtn.Position = UDim2.new(0, 214, 0, 112)
    loopBtn.BackgroundColor3 = WHITE_SOFT
    loopBtn.Text = M.Radio.looped and "LOOP ON" or "LOOP OFF"
    loopBtn.TextColor3 = BLACK
    loopBtn.Font = Enum.Font.GothamBold
    loopBtn.TextSize = 12
    Instance.new("UICorner", loopBtn).CornerRadius = UDim.new(0, 6)
    Instance.new("UIStroke", loopBtn).Color = GRAY_BORDER
    loopBtn.MouseButton1Click:Connect(function()
        M.Radio.setLooped(not M.Radio.looped)
        loopBtn.Text = M.Radio.looped and "LOOP ON" or "LOOP OFF"
    end)

    local hint = Instance.new("TextLabel", frame)
    hint.Size = UDim2.new(1, -24, 0, 36)
    hint.Position = UDim2.new(0, 12, 0, 152)
    hint.BackgroundTransparency = 1
    hint.Text = "Radio · creds to 7up · needs HTTP + writefile"
    hint.TextColor3 = GRAY_HINT
    hint.Font = Enum.Font.Gotham
    hint.TextSize = 11
    hint.TextWrapped = true
    hint.TextXAlignment = Enum.TextXAlignment.Left

    -- Drag
    do
        local dragging, dragStart, startPos
        frame.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragStart = input.Position
                startPos = frame.Position
                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then dragging = false end
                end)
            end
        end)
        UIS.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch) then
                local d = input.Position - dragStart
                frame.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + d.X,
                    startPos.Y.Scale, startPos.Y.Offset + d.Y
                )
            end
        end)
    end
end


-- ============================================================
-- ALL GEARS: ANTI EFFECTS + GEAR AIMBOT (from Vexo / pasted-text)
-- ============================================================
local ReplicatedStorage = game:GetService("ReplicatedStorage")

function M.enableAntiBee()
    if M._antiBeeData and M._antiBeeData.running then return end
    local data = {
        running = true,
        connections = {},
        originalMoveFunction = nil,
        controlsProtected = false,
        badLightingNames = { Blue = true, DiscoEffect = true, BeeBlur = true, ColorCorrection = true },
    }
    M._antiBeeData = data
    local function abNuke(obj)
        if not obj or not obj.Parent then return end
        if data.badLightingNames[obj.Name] then pcall(function() obj:Destroy() end) end
    end
    local function abProtectControls()
        if data.controlsProtected then return end
        pcall(function()
            local PlayerModule = player:FindFirstChild("PlayerScripts") and player.PlayerScripts:FindFirstChild("PlayerModule")
            if not PlayerModule then return end
            local Controls = require(PlayerModule):GetControls()
            if not Controls then return end
            if not data.originalMoveFunction then data.originalMoveFunction = Controls.moveFunction end
            local function protectedMove(self, moveVector, relativeToCamera)
                if data.originalMoveFunction then data.originalMoveFunction(self, moveVector, relativeToCamera) end
            end
            local acc = 0
            table.insert(data.connections, RunService.Heartbeat:Connect(function(dt)
                if not data.running then return end
                acc = acc + dt
                if acc < 0.25 then return end
                acc = 0
                if Controls.moveFunction ~= protectedMove then Controls.moveFunction = protectedMove end
            end))
            Controls.moveFunction = protectedMove
            data.controlsProtected = true
        end)
    end
    local function abBlockBuzzing()
        pcall(function()
            local ps = player:FindFirstChild("PlayerScripts")
            if not ps then return end
            local beeScript = ps:FindFirstChild("Bee", true)
            if beeScript then
                local buzzing = beeScript:FindFirstChild("Buzzing")
                if buzzing and buzzing:IsA("Sound") then buzzing:Stop(); buzzing.Volume = 0 end
            end
        end)
    end
    local function lockFOV()
        local cam = workspace.CurrentCamera
        if cam then cam.FieldOfView = 70 end
    end
    for _, inst in ipairs(Lighting:GetDescendants()) do abNuke(inst) end
    table.insert(data.connections, Lighting.DescendantAdded:Connect(function(obj)
        if data.running then abNuke(obj) end
    end))
    abProtectControls()
    local buzzAcc = 0
    table.insert(data.connections, RunService.Heartbeat:Connect(function(dt)
        if not data.running then return end
        buzzAcc = buzzAcc + dt
        if buzzAcc < 0.25 then return end
        buzzAcc = 0
        abBlockBuzzing()
        lockFOV()
    end))
end

function M.disableAntiBee()
    local data = M._antiBeeData
    if not data or not data.running then return end
    data.running = false
    pcall(function()
        if data.controlsProtected and data.originalMoveFunction then
            local PlayerModule = player:FindFirstChild("PlayerScripts") and player.PlayerScripts:FindFirstChild("PlayerModule")
            if PlayerModule then
                local Controls = require(PlayerModule):GetControls()
                if Controls then Controls.moveFunction = data.originalMoveFunction end
            end
            data.controlsProtected = false
        end
    end)
    for _, conn in ipairs(data.connections) do
        if typeof(conn) == "RBXScriptConnection" then pcall(function() conn:Disconnect() end) end
    end
    data.connections = {}
end

function M.setAntiBee(on)
    M.antiBeeEnabled = on and true or false
    if M.antiBeeEnabled then M.enableAntiBee() else M.disableAntiBee() end
end

function M.clearGummyToolBlockState(char)
    for _, inst in ipairs({ player, char }) do
        if inst then
            if inst:GetAttribute("BlockTools") ~= nil and inst:GetAttribute("BlockTools") ~= false then
                inst:SetAttribute("BlockTools", false)
            end
            if inst:GetAttribute("Web") ~= nil and inst:GetAttribute("Web") ~= false then
                inst:SetAttribute("Web", false)
            end
        end
    end
    if char and char:GetAttribute("BackpackReady") == false then
        char:SetAttribute("BackpackReady", true)
    end
end

function M.setAntiGummy(on)
    M.antiGummyEnabled = on and true or false
end

-- continuous anti-gummy loop
task.spawn(function()
    while true do
        task.wait(0.1)
        if not M.antiGummyEnabled then continue end
        local char = player.Character
        if not char then continue end
        if tick() >= (M._antiGummyGraceUntil or 0) then
            M.clearGummyToolBlockState(char)
        end
    end
end)
player.CharacterAdded:Connect(function()
    M._antiGummyGraceUntil = tick() + 1.5
end)

-- Gear Aimbot (Paintball Gun / Web Slinger / Laser Cape) for Steal a Brainrot
local GEAR_AIMBOT_TOOLS = { ["Web Slinger"] = true, ["Paintball Gun"] = true, ["Laser Cape"] = true }
local GEAR_AIM_RANGE = 100
local GEAR_AIM_FOV = 200

function M._gearGetPlayerMouse()
    if M._gearAimbotPlayerMouse then return M._gearAimbotPlayerMouse end
    local ok, result = pcall(function()
        local packages = ReplicatedStorage:FindFirstChild("Packages")
        if not packages then return nil end
        return require(packages:WaitForChild("PlayerMouse", 5))
    end)
    if ok and result then
        M._gearAimbotPlayerMouse = result
        return result
    end
    return nil
end

function M._gearFindBestEnemy()
    local localChar = player.Character
    if not localChar or not localChar.Parent then return nil end
    local localRoot = localChar:FindFirstChild("HumanoidRootPart")
    local camera = workspace.CurrentCamera
    if not localRoot or not camera then return nil end
    local cameraPos = camera.CFrame.Position
    local cameraDir = camera.CFrame.LookVector
    local bestRoot, bestScore = nil, math.huge
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == player then continue end
        local char = plr.Character
        if not char or not char.Parent then continue end
        local root = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not root or not hum or hum.Health <= 0 then continue end
        local dist = (root.Position - localRoot.Position).Magnitude
        if dist > GEAR_AIM_RANGE then continue end
        local dirToEnemy = (root.Position - cameraPos)
        if dirToEnemy.Magnitude < 0.01 then continue end
        dirToEnemy = dirToEnemy.Unit
        local angle = cameraDir:Dot(dirToEnemy)
        local angleDeg = math.deg(math.acos(math.clamp(angle, -1, 1)))
        local score = dist
        if angleDeg > GEAR_AIM_FOV then score = score + 1000 end
        local raycastParams = RaycastParams.new()
        raycastParams.FilterType = Enum.RaycastFilterType.Exclude
        raycastParams.FilterDescendantsInstances = { localChar, camera }
        local raycastResult = workspace:Raycast(cameraPos, (root.Position - cameraPos) * 0.95, raycastParams)
        local visible = (not raycastResult) or (raycastResult.Instance and raycastResult.Instance:IsDescendantOf(char))
        if not visible then score = score + 500 end
        if score < bestScore then
            bestScore = score
            bestRoot = root
        end
    end
    return bestRoot
end

function M._gearOverrideMouse()
    if not M.gearAimbotEnabled then return end
    local PlayerMouse = M._gearGetPlayerMouse()
    if not PlayerMouse then return end
    local enemy = M._gearFindBestEnemy()
    if enemy and enemy.Parent then
        local hum = enemy.Parent:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health > 0 then
            local pos = enemy.Position
            local velocity = enemy.AssemblyLinearVelocity or Vector3.new(0, 0, 0)
            local predictedPos = pos + velocity * 0.1
            pcall(function()
                PlayerMouse.Hit = CFrame.new(predictedPos)
                PlayerMouse.Target = enemy
            end)
            M._gearAimbotEnemy = enemy
        end
    end
end

function M._gearHookTool(tool)
    if not tool or M._gearAimbotHooked[tool] then return end
    if not GEAR_AIMBOT_TOOLS[tool.Name] then return end
    M._gearAimbotHooked[tool] = true
    local conn1 = tool.Activated:Connect(function()
        M._gearOverrideMouse()
    end)
    local conn2 = tool.Equipped:Connect(function()
        task.wait(0.1)
        local PlayerMouse = M._gearGetPlayerMouse()
        if PlayerMouse and M.gearAimbotEnabled then
            local oldFunc = PlayerMouse.Button1Down
            PlayerMouse.Button1Down = function(...)
                M._gearOverrideMouse()
                if oldFunc then oldFunc(...) end
            end
        end
    end)
    tool.Destroying:Connect(function()
        M._gearAimbotHooked[tool] = nil
        pcall(function() conn1:Disconnect() end)
        pcall(function() conn2:Disconnect() end)
    end)
end

function M._gearWatchForTool(parent)
    if not parent then return end
    for _, child in ipairs(parent:GetChildren()) do
        if GEAR_AIMBOT_TOOLS[child.Name] and not M._gearAimbotHooked[child] then
            M._gearHookTool(child)
        end
    end
    parent.ChildAdded:Connect(function(child)
        task.wait(0.05)
        if GEAR_AIMBOT_TOOLS[child.Name] and not M._gearAimbotHooked[child] then
            M._gearHookTool(child)
        end
    end)
end

function M._gearSetupCharacter(char)
    if not char then return end
    local waitCount = 0
    while not char.Parent and waitCount < 20 do task.wait(0.1); waitCount = waitCount + 1 end
    task.wait(0.2)
    M._gearWatchForTool(char)
    M._gearWatchForTool(player:FindFirstChild("Backpack"))
end

function M.initGearAimbot()
    if M._gearAimbotInited then return end
    M._gearAimbotInited = true
    M._gearWatchForTool(player:FindFirstChild("Backpack"))
    if player.Character and player.Character.Parent then
        M._gearSetupCharacter(player.Character)
    end
    player.CharacterAdded:Connect(function(c)
        M._gearSetupCharacter(c)
    end)
    RunService.RenderStepped:Connect(function()
        if not M.gearAimbotEnabled then return end
        local now = tick()
        if now - (M._gearAimbotLastUpdate or 0) > 0.1 then
            M._gearAimbotLastUpdate = now
            M._gearFindBestEnemy()
        end
        if UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
            M._gearOverrideMouse()
        end
    end)
end

function M.setGearAimbot(on)
    M.gearAimbotEnabled = on and true or false
    if M.gearAimbotEnabled then
        M.initGearAimbot()
    end
end


-- ============================================================
-- ANTI BOOGIE / ANTI PAINTBALL / AUTO DESTROY SENTRY / FLY TOOL TP
-- ============================================================

function M.setAntiBoogie(on)
    M.antiBoogieEnabled = on and true or false
    if M.antiBoogieEnabled then
        if M._antiBoogieConn then return end
        -- clear existing disco
        for _, v in ipairs(Lighting:GetChildren()) do
            if v.Name == "DiscoEffect" then pcall(function() v:Destroy() end) end
        end
        M._antiBoogieConn = Lighting.ChildAdded:Connect(function(child)
            if not M.antiBoogieEnabled then return end
            if child and child.Name == "DiscoEffect" then
                task.defer(function() pcall(function() child:Destroy() end) end)
            end
        end)
        -- stop BOOM sound on controller
        task.spawn(function()
            while M.antiBoogieEnabled do
                pcall(function()
                    local Ctrl = game:GetService("ReplicatedStorage"):FindFirstChild("Controllers")
                    if Ctrl then
                        local BC = Ctrl:FindFirstChild("BoogieBombController")
                        if BC then
                            local B = BC:FindFirstChild("BOOM")
                            if B and B:IsA("Sound") then B:Stop() end
                        end
                    end
                    for _, v in ipairs(Lighting:GetChildren()) do
                        if v.Name == "DiscoEffect" then pcall(function() v:Destroy() end) end
                    end
                end)
                task.wait(0.2)
            end
        end)
    else
        if M._antiBoogieConn then
            pcall(function() M._antiBoogieConn:Disconnect() end)
            M._antiBoogieConn = nil
        end
    end
end

function M.setAntiPaintball(on)
    M.antiPaintballEnabled = on and true or false
    if not M.antiPaintballEnabled then return end
    if M._antiPaintballInited then return end
    M._antiPaintballInited = true
    local function getMainHudGui()
        local pg = player:FindFirstChild("PlayerGui")
        return pg and pg:FindFirstChild("Main")
    end
    local function isPaintballSplatGui(gui)
        local main = getMainHudGui()
        if not gui or not main or gui.Parent ~= main then return false end
        if not (gui:IsA("ImageLabel") or gui:IsA("ImageButton")) then return false end
        if gui:GetAttribute("__UGPaintballIgnore") or gui:GetAttribute("__UGPaintballShrunk") then return false end
        return math.abs(gui.Rotation) > 0.01
    end
    local function shrinkPaintballSplat(gui)
        if not gui or gui:GetAttribute("__UGPaintballShrunk") then return end
        gui:SetAttribute("__UGPaintballShrunk", true)
        gui.Size = UDim2.fromOffset(6, 6)
    end
    local function runSweep()
        if not M.antiPaintballEnabled then return end
        local main = getMainHudGui()
        if not main then return end
        for _, c in ipairs(main:GetChildren()) do
            if isPaintballSplatGui(c) then pcall(shrinkPaintballSplat, c) end
        end
    end
    task.spawn(function()
        while true do
            task.wait(0.25)
            if M.antiPaintballEnabled then pcall(runSweep) end
        end
    end)
    local function hookMain(main)
        if not main or main:GetAttribute("_KyzenAntiPaintballHooked") then return end
        main:SetAttribute("_KyzenAntiPaintballHooked", true)
        main.ChildAdded:Connect(function(c)
            task.defer(function()
                if M.antiPaintballEnabled and isPaintballSplatGui(c) then
                    pcall(shrinkPaintballSplat, c)
                end
            end)
        end)
    end
    task.spawn(function()
        local pg = player:FindFirstChild("PlayerGui") or player:WaitForChild("PlayerGui", 15)
        if not pg then return end
        hookMain(pg:FindFirstChild("Main"))
        pg.ChildAdded:Connect(function(ch)
            if ch.Name == "Main" then task.defer(function() hookMain(ch) end) end
        end)
    end)
end

-- Auto Destroy Sentry
function M._isEnemyTurret(obj)
    if not obj or not obj:IsA("BasePart") then return false end
    local name, nameLower = obj.Name, obj.Name:lower()
    local ownerId = name:match("^Sentry_(%d+)$") or name:match("^sentry_(%d+)$")
    if not ownerId then
        ownerId = name:match("^CandySentry_(%d+)$") or name:match("^Candy_Sentry_(%d+)$")
            or name:match("^candy_sentry_(%d+)$")
    end
    if not ownerId and nameLower:find("candy") and nameLower:find("sentry") then
        ownerId = name:match("(%d+)$")
    end
    if not ownerId then ownerId = name:match("^[Tt]urret_(%d+)$") end
    if not ownerId and nameLower:find("sentry") then ownerId = name:match("(%d+)$") end
    return ownerId ~= nil and tostring(ownerId) ~= tostring(player.UserId)
end

function M._setTurretNoClip(turret)
    if not M._isEnemyTurret(turret) then return end
    pcall(function()
        turret.CanCollide = false
        turret.Anchored = true
        turret.AssemblyLinearVelocity = Vector3.zero
        turret.AssemblyAngularVelocity = Vector3.zero
    end)
end

function M._shouldAttackTurret(turret)
    if player:GetAttribute("Stealing") ~= nil then return false end
    if not M._isEnemyTurret(turret) then return false end
    M._setTurretNoClip(turret)
    local sf = turret:FindFirstChild("SetupFrame")
    local mf = sf and sf:FindFirstChild("MainFrame")
    local tl = mf and mf:FindFirstChild("Time")
    if tl and tl:IsA("TextLabel") then
        local text = tostring(tl.Text or ""):gsub("^%s+", ""):gsub("%s+$", "")
        if text == "" then return false end
        if string.find(text, "^%d+%s*[sS]!?$") or string.find(text, "^%d+$") then return true end
        return false
    end
    return true
end

function M._findBatTool()
    local char = player.Character
    if char then
        for _, t in ipairs(char:GetChildren()) do
            if t:IsA("Tool") and t.Name:lower():find("bat") then return t end
        end
    end
    local bp = player:FindFirstChild("Backpack")
    if bp then
        for _, t in ipairs(bp:GetChildren()) do
            if t:IsA("Tool") and t.Name:lower():find("bat") then return t end
        end
    end
    return nil
end

function M._bringTurretInFront(turret, hrp)
    if not turret or not hrp then return end
    pcall(function()
        local look = hrp.CFrame.LookVector
        local pos = hrp.Position + look * 6 + Vector3.new(0, 1, 0)
        turret.CFrame = CFrame.new(pos, pos + look)
    end)
end

M._turretBusy = setmetatable({}, { __mode = "k" })
M._turretActiveAtk = 0

function M._attackTurret(turret)
    if not M.destroySentryEnabled then return end
    if M._turretBusy[turret] or M._turretActiveAtk >= 2 then return end
    if not M._shouldAttackTurret(turret) then return end
    M._turretBusy[turret] = true
    M._turretActiveAtk = M._turretActiveAtk + 1
    task.spawn(function()
        local attempts, batReady = 0, false
        while attempts < 18 and M.destroySentryEnabled do
            if not turret or not turret.Parent or not M._shouldAttackTurret(turret) then break end
            local char = player.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if not hrp or not hum or hum.Health <= 0 then break end
            local dist = (turret.Position - hrp.Position).Magnitude
            if dist > 250 then break end
            M._setTurretNoClip(turret)
            M._bringTurretInFront(turret, hrp)
            local bat = M._findBatTool()
            if bat and hum then
                if bat.Parent ~= char then pcall(function() hum:EquipTool(bat) end) end
                pcall(function() bat:Activate() end)
            end
            attempts = attempts + 1
            task.wait(0.045)
        end
        M._turretBusy[turret] = nil
        M._turretActiveAtk = math.max(0, M._turretActiveAtk - 1)
    end)
end

function M.setDestroySentry(on)
    M.destroySentryEnabled = on and true or false
    if M.destroySentryEnabled then
        if not M._destroySentryLoop then
            M._destroySentryLoop = true
            if not M._destroySentryConn then
                M._destroySentryConn = workspace.DescendantAdded:Connect(function(obj)
                    if M._isEnemyTurret(obj) then M._setTurretNoClip(obj) end
                    if M.destroySentryEnabled and M._shouldAttackTurret(obj) then
                        task.defer(function() M._attackTurret(obj) end)
                    end
                end)
            end
            task.spawn(function()
                while M._destroySentryLoop do
                    task.wait(0.25)
                    if not M.destroySentryEnabled then continue end
                    local pending = {}
                    for _, obj in ipairs(workspace:GetDescendants()) do
                        if M._isEnemyTurret(obj) then
                            M._setTurretNoClip(obj)
                            if M._shouldAttackTurret(obj) and not M._turretBusy[obj] then
                                table.insert(pending, obj)
                            end
                        end
                    end
                    local char = player.Character
                    local hrp = char and char:FindFirstChild("HumanoidRootPart")
                    if hrp and #pending > 0 then
                        table.sort(pending, function(a, b)
                            return (a.Position - hrp.Position).Magnitude < (b.Position - hrp.Position).Magnitude
                        end)
                        for i = 1, math.min(2, #pending) do
                            M._attackTurret(pending[i])
                        end
                    end
                end
            end)
        end
    else
        M._destroySentryLoop = false
    end
end


-- ========== FLY TOOL TP (2nd UI panel) ==========
-- Duel: 2 bases (Base 1 / Base 2). Each stores Base Position + Brainrot Position.
-- Select a base in the panel, save both positions, then TP to that base's saves.

function M._flyTPEnsureSlots()
    if type(M.flyTPSlots) ~= "table" then
        M.flyTPSlots = { [1] = { base = nil, brainrot = nil }, [2] = { base = nil, brainrot = nil } }
    end
    for i = 1, 2 do
        if type(M.flyTPSlots[i]) ~= "table" then
            M.flyTPSlots[i] = { base = nil, brainrot = nil }
        end
    end
    local s = tonumber(M.flyTPSelectedSlot) or 1
    if s ~= 1 and s ~= 2 then s = 1 end
    M.flyTPSelectedSlot = s
end

function M._flyTPToVec(t)
    if typeof(t) == "Vector3" then return t end
    if type(t) ~= "table" then return nil end
    local x = tonumber(t[1] or t.x or t.X)
    local y = tonumber(t[2] or t.y or t.Y)
    local z = tonumber(t[3] or t.z or t.Z)
    if x and y and z then return Vector3.new(x, y, z) end
    return nil
end

function M._flyTPVecToSave(v)
    if not v then return nil end
    return { v.X, v.Y, v.Z }
end

function M._flyTPClearMarkers()
    local m = M._flyTPMarkers
    if type(m) ~= "table" then return end
    if m.base then pcall(function() m.base:Destroy() end) end
    if m.brainrot then pcall(function() m.brainrot:Destroy() end) end
    M._flyTPMarkers = { base = nil, brainrot = nil }
end

function M._flyTPMakeMarker(pos, col)
    if not pos then return nil end
    local p = Instance.new("Part")
    p.Name = "KyzenFlyTP_Marker"
    p.Shape = Enum.PartType.Cylinder
    p.Size = Vector3.new(0.35, 4, 4)
    p.CFrame = CFrame.new(pos + Vector3.new(0, 0.2, 0)) * CFrame.Angles(0, 0, math.rad(90))
    p.Anchored = true
    p.CanCollide = false
    p.Material = Enum.Material.Neon
    p.Color = col
    p.Transparency = 0.15
    p.Parent = workspace
    local light = Instance.new("PointLight")
    light.Color = col
    light.Brightness = 2
    light.Range = 10
    light.Parent = p
    return p
end

function M._flyTPRefreshMarkers()
    M._flyTPClearMarkers()
    M._flyTPEnsureSlots()
    local slot = M.flyTPSlots[M.flyTPSelectedSlot]
    if not slot then return end
    local basePos = M._flyTPToVec(slot.base)
    local petPos = M._flyTPToVec(slot.brainrot)
    if basePos then
        M._flyTPMarkers.base = M._flyTPMakeMarker(basePos, Color3.fromRGB(255, 105, 180))
    end
    if petPos then
        M._flyTPMarkers.brainrot = M._flyTPMakeMarker(petPos, Color3.fromRGB(255, 140, 0))
    end
end

function M._flyTPEquipFly(char)
    char = char or player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    for _, n in ipairs({"Flying Carpet", "Carpet", "Witch's Broom", "Cloud", "Magic Carpet", "Fly Carpet", "FlyingCarpet"}) do
        local t = char:FindFirstChild(n) or (player.Backpack and player.Backpack:FindFirstChild(n))
        if t and t:IsA("Tool") then
            pcall(function() hum:EquipTool(t) end)
            return
        end
    end
end

function M._flyTPSmooth(hrp, pos)
    if not hrp or not pos then return end
    local target = pos + Vector3.new(0, 3, 0)
    local speed = math.clamp(tonumber(M.flyTPSpeed) or 90, 10, 500)

    -- Original instant path when speed is high enough (near-instant TP)
    if speed >= 400 then
        pcall(function()
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
            hrp.CFrame = CFrame.new(target)
        end)
        return
    end

    -- Original-style smooth fly: move toward target at flyTPSpeed (studs/s)
    -- using CFrame steps while clearing velocity (same as original settle)
    local deadline = tick() + 12
    while tick() < deadline do
        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then return end
        local cur = root.Position
        local delta = target - cur
        local dist = delta.Magnitude
        if dist <= 2.5 then
            break
        end
        local step = math.min(speed * 0.03, dist)
        local nextPos = cur + delta.Unit * step
        pcall(function()
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            root.CFrame = CFrame.new(nextPos)
        end)
        task.wait()
    end

    local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") or hrp
    if root then
        pcall(function()
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            root.CFrame = CFrame.new(target)
        end)
    end
end

function M._flyTPChilliDrop(hrp, targetPos, char)
    if not hrp or not targetPos then return end
    pcall(function()
        hrp.CFrame = CFrame.new(targetPos + Vector3.new(0, 120, 0))
        hrp.AssemblyLinearVelocity = Vector3.new(0, -220, 0)
    end)
    task.wait(0.35)
    pcall(function()
        local c0 = player.Character or char
        local h = c0 and c0:FindFirstChild("HumanoidRootPart")
        if h then
            h.CFrame = CFrame.new(targetPos + Vector3.new(0, 3, 0))
            h.AssemblyLinearVelocity = Vector3.zero
        end
    end)
end

function M.saveFlyTPPosition(kind)
    -- kind: "base" | "brainrot"
    M._flyTPEnsureSlots()
    local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    local slot = M.flyTPSlots[M.flyTPSelectedSlot]
    if not slot then return false end
    local saved = M._flyTPVecToSave(hrp.Position)
    if kind == "brainrot" then
        slot.brainrot = saved
    else
        slot.base = saved
    end
    M._flyTPRefreshMarkers()
    pcall(function() if type(saveCherryConfig) == "function" then saveCherryConfig() end end)
    return true
end

function M.runFlyToolTP()
    if M._flyTPBusy then return end
    M._flyTPEnsureSlots()
    local slot = M.flyTPSlots[M.flyTPSelectedSlot]
    if not slot then return end
    local basePos = M._flyTPToVec(slot.base)
    local petPos = M._flyTPToVec(slot.brainrot)
    if not basePos and not petPos then
        return
    end
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    M._flyTPBusy = true
    task.spawn(function()
        pcall(function()
            -- Only one position saved -> chilli drop
            if (basePos and not petPos) or (petPos and not basePos) then
                M._flyTPChilliDrop(hrp, basePos or petPos, char)
            else
                -- Both: equip fly tool, go to base, then brainrot
                M._flyTPEquipFly(char)
                M._flyTPSmooth(hrp, basePos)
                task.wait(0.15)
                char = player.Character or char
                hrp = char and char:FindFirstChild("HumanoidRootPart") or hrp
                if hrp and petPos then
                    M._flyTPSmooth(hrp, petPos)
                end
            end
        end)
        M._flyTPBusy = false
    end)
end

function M.destroyFlyToolTPPanel()
    M._flyTPClearMarkers()
    if M._flyTPGui then
        pcall(function() M._flyTPGui:Destroy() end)
        M._flyTPGui = nil
    end
    M.flyToolTPPanelOpen = false
end

function M.buildFlyToolTPPanel()
    M.destroyFlyToolTPPanel()
    M._flyTPEnsureSlots()
    M.flyToolTPPanelOpen = true
    local accent = UI_ACCENT or Color3.fromRGB(255, 255, 255)
    local gui = Instance.new("ScreenGui")
    gui.Name = "KyzenFlyToolTP"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.DisplayOrder = 80
    pcall(function() if syn and syn.protect_gui then syn.protect_gui(gui) end end)
    if not pcall(function() gui.Parent = game:GetService("CoreGui") end) then
        gui.Parent = player:WaitForChild("PlayerGui")
    end
    M._flyTPGui = gui

    local main = Instance.new("Frame")
    main.Name = "TPMain"
    main.Size = UDim2.new(0, 230, 0, 390)
    main.Position = UDim2.new(0.02, 0, 0.22, 0)
    if type(M._flyTPPanelPos) == "table" then
        local p = M._flyTPPanelPos
        main.Position = UDim2.new(p[1] or 0.02, p[2] or 0, p[3] or 0.22, p[4] or 0)
    end
    main.BackgroundColor3 = Color3.fromRGB(14, 14, 20)
    main.BorderSizePixel = 0
    main.Active = true
    main.ClipsDescendants = true
    main.Parent = gui
    Instance.new("UICorner", main).CornerRadius = UDim.new(0, 12)
    local stroke = Instance.new("UIStroke", main)
    stroke.Thickness = 1.5
    stroke.Color = accent
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, -80, 0, 26)
    title.Position = UDim2.new(0, 10, 0, 6)
    title.BackgroundTransparency = 1
    title.Text = "FLY TOOL TP"
    title.TextColor3 = Color3.fromRGB(255, 255, 255)
    title.Font = Enum.Font.GothamBold
    title.TextSize = 14
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Parent = main

    local close = Instance.new("TextButton")
    close.Size = UDim2.new(0, 28, 0, 24)
    close.Position = UDim2.new(1, -34, 0, 6)
    close.BackgroundColor3 = Color3.fromRGB(40, 30, 50)
    close.Text = "X"
    close.TextColor3 = Color3.new(1, 1, 1)
    close.Font = Enum.Font.GothamBold
    close.TextSize = 14
    close.Parent = main
    Instance.new("UICorner", close).CornerRadius = UDim.new(0, 6)
    close.MouseButton1Click:Connect(function() M.destroyFlyToolTPPanel() end)

    local info = Instance.new("TextLabel")
    info.Size = UDim2.new(1, -20, 0, 32)
    info.Position = UDim2.new(0, 10, 0, 32)
    info.BackgroundTransparency = 1
    info.Text = "Save TP pos for both possible bases\n(Base + Brainrot per base)"
    info.TextColor3 = Color3.fromRGB(160, 160, 180)
    info.Font = Enum.Font.GothamMedium
    info.TextSize = 11
    info.TextWrapped = true
    info.TextXAlignment = Enum.TextXAlignment.Left
    info.Parent = main

    -- Base selector row
    local selRow = Instance.new("Frame")
    selRow.Size = UDim2.new(1, -24, 0, 30)
    selRow.Position = UDim2.new(0, 12, 0, 68)
    selRow.BackgroundColor3 = Color3.fromRGB(28, 28, 38)
    selRow.BorderSizePixel = 0
    selRow.Parent = main
    Instance.new("UICorner", selRow).CornerRadius = UDim.new(0, 8)

    local function mkSelBtn(text, xScale, slot)
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(0.5, -4, 1, -4)
        b.Position = UDim2.new(xScale, 2, 0, 2)
        b.BackgroundColor3 = (M.flyTPSelectedSlot == slot) and accent or Color3.fromRGB(40, 40, 55)
        b.Text = text
        b.TextColor3 = (M.flyTPSelectedSlot == slot) and Color3.fromRGB(20, 20, 25) or Color3.fromRGB(255, 255, 255)
        b.Font = Enum.Font.GothamBold
        b.TextSize = 12
        b.AutoButtonColor = false
        b.Parent = selRow
        Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
        return b
    end
    local btnSlot1 = mkSelBtn("Base 1", 0, 1)
    local btnSlot2 = mkSelBtn("Base 2", 0.5, 2)

    local function mkBtn(text, y, col)
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(1, -24, 0, 32)
        b.Position = UDim2.new(0, 12, 0, y)
        b.BackgroundColor3 = col or Color3.fromRGB(40, 40, 55)
        b.Text = text
        b.TextColor3 = Color3.new(1, 1, 1)
        b.Font = Enum.Font.GothamBold
        b.TextSize = 12
        b.AutoButtonColor = false
        b.Parent = main
        Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)
        return b
    end

    local statusLbl = Instance.new("TextLabel")
    statusLbl.Size = UDim2.new(1, -24, 0, 18)
    statusLbl.Position = UDim2.new(0, 12, 0, 102)
    statusLbl.BackgroundTransparency = 1
    statusLbl.TextColor3 = Color3.fromRGB(180, 180, 200)
    statusLbl.Font = Enum.Font.GothamMedium
    statusLbl.TextSize = 11
    statusLbl.TextXAlignment = Enum.TextXAlignment.Left
    statusLbl.Parent = main

    local function refreshStatus()
        M._flyTPEnsureSlots()
        local slot = M.flyTPSlots[M.flyTPSelectedSlot]
        local hasBase = slot and M._flyTPToVec(slot.base) ~= nil
        local hasPet = slot and M._flyTPToVec(slot.brainrot) ~= nil
        statusLbl.Text = string.format(
            "Base %d — Base: %s | Brainrot: %s",
            M.flyTPSelectedSlot,
            hasBase and "SAVED" or "—",
            hasPet and "SAVED" or "—"
        )
        btnSlot1.BackgroundColor3 = (M.flyTPSelectedSlot == 1) and accent or Color3.fromRGB(40, 40, 55)
        btnSlot1.TextColor3 = (M.flyTPSelectedSlot == 1) and Color3.fromRGB(20, 20, 25) or Color3.fromRGB(255, 255, 255)
        btnSlot2.BackgroundColor3 = (M.flyTPSelectedSlot == 2) and accent or Color3.fromRGB(40, 40, 55)
        btnSlot2.TextColor3 = (M.flyTPSelectedSlot == 2) and Color3.fromRGB(20, 20, 25) or Color3.fromRGB(255, 255, 255)
    end

    -- TP Speed row (controls M._flyTPSmooth speed; original TP flow unchanged)
    local speedRow = Instance.new("Frame")
    speedRow.Size = UDim2.new(1, -24, 0, 32)
    speedRow.Position = UDim2.new(0, 12, 0, 124)
    speedRow.BackgroundColor3 = Color3.fromRGB(28, 28, 38)
    speedRow.BorderSizePixel = 0
    speedRow.Parent = main
    Instance.new("UICorner", speedRow).CornerRadius = UDim.new(0, 8)

    local speedLbl = Instance.new("TextLabel")
    speedLbl.Size = UDim2.new(0.42, 0, 1, 0)
    speedLbl.Position = UDim2.new(0, 8, 0, 0)
    speedLbl.BackgroundTransparency = 1
    speedLbl.Text = "TP Speed"
    speedLbl.TextColor3 = Color3.fromRGB(230, 230, 240)
    speedLbl.Font = Enum.Font.GothamBold
    speedLbl.TextSize = 12
    speedLbl.TextXAlignment = Enum.TextXAlignment.Left
    speedLbl.Parent = speedRow

    local speedBox = Instance.new("TextBox")
    speedBox.Size = UDim2.new(0, 52, 0, 24)
    speedBox.Position = UDim2.new(1, -120, 0.5, -12)
    speedBox.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
    speedBox.BorderSizePixel = 0
    speedBox.Text = tostring(math.floor(tonumber(M.flyTPSpeed) or 90))
    speedBox.TextColor3 = Color3.fromRGB(255, 255, 255)
    speedBox.Font = Enum.Font.GothamBold
    speedBox.TextSize = 12
    speedBox.ClearTextOnFocus = false
    speedBox.Parent = speedRow
    Instance.new("UICorner", speedBox).CornerRadius = UDim.new(0, 6)

    local function applySpeed(v)
        v = math.clamp(math.floor(tonumber(v) or 90), 10, 500)
        M.flyTPSpeed = v
        speedBox.Text = tostring(v)
        pcall(function() if type(saveCherryConfig) == "function" then saveCherryConfig() end end)
    end

    speedBox.FocusLost:Connect(function()
        applySpeed(speedBox.Text)
    end)

    local btnSpeedMinus = Instance.new("TextButton")
    btnSpeedMinus.Size = UDim2.new(0, 28, 0, 24)
    btnSpeedMinus.Position = UDim2.new(1, -64, 0.5, -12)
    btnSpeedMinus.BackgroundColor3 = Color3.fromRGB(50, 50, 70)
    btnSpeedMinus.Text = "-"
    btnSpeedMinus.TextColor3 = Color3.new(1, 1, 1)
    btnSpeedMinus.Font = Enum.Font.GothamBold
    btnSpeedMinus.TextSize = 16
    btnSpeedMinus.Parent = speedRow
    Instance.new("UICorner", btnSpeedMinus).CornerRadius = UDim.new(0, 6)

    local btnSpeedPlus = Instance.new("TextButton")
    btnSpeedPlus.Size = UDim2.new(0, 28, 0, 24)
    btnSpeedPlus.Position = UDim2.new(1, -32, 0.5, -12)
    btnSpeedPlus.BackgroundColor3 = Color3.fromRGB(50, 50, 70)
    btnSpeedPlus.Text = "+"
    btnSpeedPlus.TextColor3 = Color3.new(1, 1, 1)
    btnSpeedPlus.Font = Enum.Font.GothamBold
    btnSpeedPlus.TextSize = 16
    btnSpeedPlus.Parent = speedRow
    Instance.new("UICorner", btnSpeedPlus).CornerRadius = UDim.new(0, 6)

    btnSpeedMinus.MouseButton1Click:Connect(function()
        applySpeed((tonumber(M.flyTPSpeed) or 90) - 10)
    end)
    btnSpeedPlus.MouseButton1Click:Connect(function()
        applySpeed((tonumber(M.flyTPSpeed) or 90) + 10)
    end)

    local btnSaveBase = mkBtn("Save Base Position", 164, Color3.fromRGB(110, 70, 190))
    local btnSavePet = mkBtn("Save Brainrot Position", 200, Color3.fromRGB(180, 100, 40))
    local btnTP = mkBtn("TP  [" .. (M.flyTPKeybind and M.flyTPKeybind.Name or "T") .. "]", 236, Color3.fromRGB(50, 160, 90))
    local btnKey = mkBtn("Set Keybind: " .. (M.flyTPKeybind and M.flyTPKeybind.Name or "T"), 272, Color3.fromRGB(50, 50, 70))
    local btnClearSlot = mkBtn("Clear This Base", 308, Color3.fromRGB(100, 50, 60))
    local btnClearAll = mkBtn("Clear All Bases", 344, Color3.fromRGB(120, 40, 50))

    local function selectSlot(n)
        M.flyTPSelectedSlot = n
        M._flyTPRefreshMarkers()
        refreshStatus()
        pcall(function() if type(saveCherryConfig) == "function" then saveCherryConfig() end end)
    end
    btnSlot1.MouseButton1Click:Connect(function() selectSlot(1) end)
    btnSlot2.MouseButton1Click:Connect(function() selectSlot(2) end)

    btnSaveBase.MouseButton1Click:Connect(function()
        if M.saveFlyTPPosition("base") then
            btnSaveBase.Text = "Base Position Saved!"
            task.delay(0.8, function() if btnSaveBase.Parent then btnSaveBase.Text = "Save Base Position" end end)
            refreshStatus()
        end
    end)
    btnSavePet.MouseButton1Click:Connect(function()
        if M.saveFlyTPPosition("brainrot") then
            btnSavePet.Text = "Brainrot Position Saved!"
            task.delay(0.8, function() if btnSavePet.Parent then btnSavePet.Text = "Save Brainrot Position" end end)
            refreshStatus()
        end
    end)
    btnTP.MouseButton1Click:Connect(function()
        M.runFlyToolTP()
    end)
    btnClearSlot.MouseButton1Click:Connect(function()
        M._flyTPEnsureSlots()
        M.flyTPSlots[M.flyTPSelectedSlot] = { base = nil, brainrot = nil }
        M._flyTPRefreshMarkers()
        refreshStatus()
        pcall(function() if type(saveCherryConfig) == "function" then saveCherryConfig() end end)
    end)
    btnClearAll.MouseButton1Click:Connect(function()
        M.flyTPSlots = {
            [1] = { base = nil, brainrot = nil },
            [2] = { base = nil, brainrot = nil },
        }
        M._flyTPRefreshMarkers()
        refreshStatus()
        pcall(function() if type(saveCherryConfig) == "function" then saveCherryConfig() end end)
    end)
    btnKey.MouseButton1Click:Connect(function()
        if M._flyTPListening then return end
        M._flyTPListening = true
        btnKey.Text = "Press a key..."
        local cn
        cn = UIS.InputBegan:Connect(function(inp, gpe)
            if gpe then return end
            if inp.UserInputType == Enum.UserInputType.Keyboard and inp.KeyCode ~= Enum.KeyCode.Unknown then
                M.flyTPKeybind = inp.KeyCode
                if M.KB and M.KB.FlyToolTP then M.KB.FlyToolTP.kb = inp.KeyCode end
                btnKey.Text = "Set Keybind: " .. inp.KeyCode.Name
                btnTP.Text = "TP  [" .. inp.KeyCode.Name .. "]"
                M._flyTPListening = false
                pcall(function() cn:Disconnect() end)
                pcall(function() if type(saveCherryConfig) == "function" then saveCherryConfig() end end)
            end
        end)
    end)

    refreshStatus()
    M._flyTPRefreshMarkers()

    -- drag
    local dragging, dStart, sPos
    main.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dStart = input.Position
            sPos = main.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    M._flyTPPanelPos = {
                        main.Position.X.Scale, main.Position.X.Offset,
                        main.Position.Y.Scale, main.Position.Y.Offset,
                    }
                    pcall(function() if type(saveCherryConfig) == "function" then saveCherryConfig() end end)
                end
            end)
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local d = input.Position - dStart
            main.Position = UDim2.new(sPos.X.Scale, sPos.X.Offset + d.X, sPos.Y.Scale, sPos.Y.Offset + d.Y)
        end
    end)
end

function M.toggleFlyToolTPPanel()
    if M.flyToolTPPanelOpen and M._flyTPGui then
        M.destroyFlyToolTPPanel()
    else
        M.buildFlyToolTPPanel()
    end
end

-- Keybind listener for Fly Tool TP
if not M._flyTPKeyConn then
    M._flyTPKeyConn = UIS.InputBegan:Connect(function(inp, gpe)
        if gpe or M._flyTPListening then return end
        if inp.UserInputType == Enum.UserInputType.Keyboard then
            local kb = M.flyTPKeybind or (M.KB and M.KB.FlyToolTP and M.KB.FlyToolTP.kb)
            if kb and inp.KeyCode == kb then
                M.runFlyToolTP()
            end
        else
            local gp = M.KB and M.KB.FlyToolTP and M.KB.FlyToolTP.gp
            if gp and inp.KeyCode == gp then
                M.runFlyToolTP()
            end
        end
    end)
end


function M.buildAllGearsPage(PGears, uiSectionHeader, uiToggleRow, uiActionRow, uiKeybindRow, uiCardStyle)
    uiSectionHeader(PGears, "ANTI EFFECTS")
    local _, setAntiBeeVis = uiToggleRow(PGears, "Anti Bee", M.antiBeeEnabled == true, function(on)
        M.setAntiBee(on)
    end)
    M.setAntiBeeVisual = setAntiBeeVis
    local _, setAntiGummyVis = uiToggleRow(PGears, "Anti Gummy", M.antiGummyEnabled == true, function(on)
        M.setAntiGummy(on)
    end)
    M.setAntiGummyVisual = setAntiGummyVis
    local _, setAntiBoogieVis = uiToggleRow(PGears, "Anti Boogie Bomb", M.antiBoogieEnabled == true, function(on)
        M.setAntiBoogie(on)
    end)
    M.setAntiBoogieVisual = setAntiBoogieVis
    local _, setAntiPaintVis = uiToggleRow(PGears, "Anti Paintball Gun", M.antiPaintballEnabled == true, function(on)
        M.setAntiPaintball(on)
    end)
    M.setAntiPaintballVisual = setAntiPaintVis

    uiSectionHeader(PGears, "COMBAT")
    local _, setDestroySentryVis = uiToggleRow(PGears, "Auto Destroy Sentry", M.destroySentryEnabled == true, function(on)
        M.setDestroySentry(on)
    end)
    M.setDestroySentryVisual = setDestroySentryVis

    uiSectionHeader(PGears, "AIMBOT")
    local _, setGearAimbotVis = uiToggleRow(PGears, "Aimbot (Paintball / Tools)", M.gearAimbotEnabled == true, function(on)
        M.setGearAimbot(on)
    end)
    M.setGearAimbotVisual = setGearAimbotVis
    do
        local info = Instance.new("Frame")
        info.ClipsDescendants = true
        info.Size = UDim2.new(1, 0, 0, 36)
        info.BackgroundColor3 = UI_ROW_BG
        info.BackgroundTransparency = 0.03
        info.BorderSizePixel = 0
        info.Parent = PGears
        uiCardStyle(info)
        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(1, -16, 1, 0)
        lbl.Position = UDim2.new(0, 8, 0, 0)
        lbl.BackgroundTransparency = 1
        lbl.Text = "Works with Paintball Gun, Web Slinger, Laser Cape"
        lbl.TextColor3 = UI_TEXT_DIM or Color3.fromRGB(140,140,150)
        lbl.TextSize = 11
        lbl.Font = Enum.Font.GothamMedium
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.Parent = info
    end

    uiSectionHeader(PGears, "FLY TOOL TP")
    do
        local info = Instance.new("Frame")
        info.ClipsDescendants = true
        info.Size = UDim2.new(1, 0, 0, 36)
        info.BackgroundColor3 = UI_ROW_BG
        info.BackgroundTransparency = 0.03
        info.BorderSizePixel = 0
        info.Parent = PGears
        uiCardStyle(info)
        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(1, -16, 1, 0)
        lbl.Position = UDim2.new(0, 8, 0, 0)
        lbl.BackgroundTransparency = 1
        lbl.Text = "2 duel bases: save Base + Brainrot pos each, pick base, then TP"
        lbl.TextColor3 = UI_TEXT_DIM or Color3.fromRGB(140,140,150)
        lbl.TextSize = 11
        lbl.Font = Enum.Font.GothamMedium
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.Parent = info
    end
    uiActionRow(PGears, "Open Fly Tool TP Panel", function()
        M.toggleFlyToolTPPanel()
    end)
    if uiKeybindRow and M.KB and M.KB.FlyToolTP then
        uiKeybindRow(PGears, "Fly Tool TP Key", M.KB.FlyToolTP, "keyboard")
    end

    uiSectionHeader(PGears, "ALL GEAR MOBILE BUTTONS")
    local _, setGearMobVis = uiToggleRow(PGears, "Show Gear Buttons", M.gearMobileButtonsEnabled == true, function(on)
        M.gearMobileButtonsEnabled = on
        if on then M.buildGearMobileButtons() else M.destroyGearMobileButtons() end
        pcall(function() if type(saveCherryConfig) == "function" then saveCherryConfig() end end)
    end)
    M.setGearMobileButtonsVisual = setGearMobVis

    do
        local info = Instance.new("Frame")
        info.ClipsDescendants = true
        info.Size = UDim2.new(1, 0, 0, 32)
        info.BackgroundColor3 = UI_ROW_BG
        info.BackgroundTransparency = 0.03
        info.BorderSizePixel = 0
        info.Parent = PGears
        uiCardStyle(info)
        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(1, -16, 1, 0)
        lbl.Position = UDim2.new(0, 8, 0, 0)
        lbl.BackgroundTransparency = 1
        lbl.Text = "Separate from normal mobile buttons — pick which ones show"
        lbl.TextColor3 = UI_TEXT_DIM or Color3.fromRGB(140,140,150)
        lbl.TextSize = 11
        lbl.Font = Enum.Font.GothamMedium
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.Parent = info
    end

    if type(M.gearBtnVisible) ~= "table" then
        M.gearBtnVisible = {}
    end
    local gearBtnLabels = {
        {"gearAimbot", "Show: Tool Aimbot"},
        {"antiBee", "Show: Anti Bee"},
        {"antiGummy", "Show: Anti Gummy"},
        {"antiBoogie", "Show: Anti Boogie"},
        {"antiPaint", "Show: Anti Paintball"},
        {"destroySentry", "Show: Auto Sentry"},
        {"flyToolTP", "Show: Fly TP"},
        {"flyTPPanel", "Show: TP Panel"},
    }
    for _, pair in ipairs(gearBtnLabels) do
        local key, label = pair[1], pair[2]
        local on = M.gearBtnVisible[key] ~= false
        uiToggleRow(PGears, label, on, function(v)
            M.gearBtnVisible[key] = v and true or false
            if M.gearMobileButtonsEnabled then
                M.buildGearMobileButtons()
            end
            pcall(function() if type(saveCherryConfig) == "function" then saveCherryConfig() end end)
        end)
    end
end

function M.buildGui()
    applyAccentFromTheme()
    M.clearPersistentConns()

    -- Destroy previous hub UI everywhere (PlayerGui, CoreGui, gethui) — prevents double UI on theme rebuild
    pcall(function()
        if M.guiRef and M.guiRef.Parent then M.guiRef:Destroy() end
    end)
    M.guiRef = nil
    M.mainFrame = nil
    local names = {"MoveeDuels","Cherry_Menu","K7HubGUI","VantaHubUI","KyzenHubUI","AceDuelsAdaptReconstruct"}
    local parents = {}
    pcall(function() table.insert(parents, game:GetService("CoreGui")) end)
    pcall(function() table.insert(parents, player:FindFirstChild("PlayerGui") or player:WaitForChild("PlayerGui", 1)) end)
    pcall(function() if gethui then table.insert(parents, gethui()) end end)
    for _, parent in ipairs(parents) do
        if parent then
            for _, n in ipairs(names) do
                pcall(function()
                    local old = parent:FindFirstChild(n)
                    if old then old:Destroy() end
                end)
            end
        end
    end

    M.buildStatusUI()

    local gui = Instance.new("ScreenGui")
    gui.Name = "KyzenHubUI"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.DisplayOrder = 20
    pcall(function()
        if gethui then gui.Parent = gethui() else gui.Parent = player:WaitForChild("PlayerGui") end
    end)
    if not gui.Parent then
        gui.Parent = player:WaitForChild("PlayerGui")
    end
    M.guiRef = gui

    ------------------------------------------------------------------
    -- 7UP-STYLE SHELL (black, NO asset images) — replaces old Kyzen UI
    -- Layout: can-rounded MainOuter | title top | content LEFT | tabs RIGHT
    ------------------------------------------------------------------
    local WIN_W, WIN_H, TITLE_H, TAB_BAR_W = 450, 660, 44, 118
    local isMobile = UIS.TouchEnabled and not UIS.KeyboardEnabled
    if isMobile then
        WIN_W, WIN_H = 400, 560
        TAB_BAR_W = 100
    end

    local Frame = Instance.new("Frame")
    Frame.Name = "MainOuter"
    Frame.Size = UDim2.new(0, WIN_W, 0, WIN_H)
    Frame.Position = UDim2.new(0.5, -WIN_W/2, 0.5, -WIN_H/2)
    Frame.AnchorPoint = Vector2.new(0, 0)
    Frame.BackgroundColor3 = Color3.fromRGB(12, 12, 14)
    Frame.BackgroundTransparency = 0.35 -- let background image / game show through
    Frame.BorderSizePixel = 0
    Frame.ClipsDescendants = true
    Frame.Active = true
    Frame.Parent = gui
    M.mainFrame = Frame
    Instance.new("UICorner", Frame).CornerRadius = UDim.new(0, 38)

    local mainStroke = Instance.new("UIStroke")
    mainStroke.Name = "MainStroke"
    mainStroke.Color = Color3.fromRGB(180, 180, 190)
    mainStroke.Thickness = 1.6
    mainStroke.Transparency = 0.25
    mainStroke.Parent = Frame

    local uiScaleObj = Instance.new("UIScale")
    uiScaleObj.Scale = M.uiScale or 1
    uiScaleObj.Parent = Frame
    M.uiScaleRef = uiScaleObj

    -- Background image (asset IDs from M.backgroundAssets) — re-enabled
    local bgImage = Instance.new("ImageLabel")
    bgImage.Name = "BackgroundImage"
    bgImage.Size = UDim2.new(1, 0, 1, 0)
    bgImage.BackgroundColor3 = Color3.fromRGB(12, 12, 14)
    bgImage.BackgroundTransparency = 0.2
    bgImage.Image = M.getBackgroundAssetByName(M.selectedBackground or "Default")
    bgImage.ImageTransparency = 0.2
    bgImage.ScaleType = Enum.ScaleType.Crop
    bgImage.BorderSizePixel = 0
    bgImage.ZIndex = 0
    bgImage.Parent = Frame
    Instance.new("UICorner", bgImage).CornerRadius = UDim.new(0, 38)
    M.bgImageRef = bgImage
    local bgOverlay = Instance.new("Frame")
    bgOverlay.Name = "BgOverlay"
    bgOverlay.Size = UDim2.new(1, 0, 1, 0)
    bgOverlay.BackgroundColor3 = Color3.fromRGB(8, 8, 10)
    bgOverlay.BackgroundTransparency = 0.55
    bgOverlay.BorderSizePixel = 0
    bgOverlay.ZIndex = 1
    bgOverlay.Parent = Frame
    Instance.new("UICorner", bgOverlay).CornerRadius = UDim.new(0, 38)
    pcall(function() M.applyBackground(M.selectedBackground or "Default") end)

    -- Rainy Hub glass + shiny look (SAME UI only)
    -- Glass panel, pulsing edges, moving specular shine, accent-gradient title
    function M.getGlassAccent()
        local accent = UI_ACCENT or Color3.fromRGB(82, 170, 255)
        local dark = Color3.new(
            math.clamp(accent.R * 0.42, 0, 1),
            math.clamp(accent.G * 0.42, 0, 1),
            math.clamp(accent.B * 0.48, 0, 1)
        )
        return accent, dark
    end

    function M._glassAccentSequence(t)
        local a, d = M.getGlassAccent()
        local pulse = math.sin((t or 0) * 0.7) * 0.14
        local function boost(c, amt)
            return Color3.new(
                math.clamp(c.R * (1 + amt), 0, 1),
                math.clamp(c.G * (1 + amt), 0, 1),
                math.clamp(c.B * (1 + amt), 0, 1)
            )
        end
        local brightA = boost(a, pulse)
        local softD = boost(d, pulse * 0.25)
        return ColorSequence.new({
            ColorSequenceKeypoint.new(0, softD),
            ColorSequenceKeypoint.new(0.30, brightA),
            ColorSequenceKeypoint.new(0.55, Color3.fromRGB(255, 255, 255)),
            ColorSequenceKeypoint.new(0.80, brightA),
            ColorSequenceKeypoint.new(1, softD),
        })
    end

    function M.stopGlassEdgePulse()
        if M._glassEdgePulseToken then
            M._glassEdgePulseToken += 1
        end
        if M._glassShineConn then
            pcall(function() M._glassShineConn:Disconnect() end)
            M._glassShineConn = nil
        end
    end

    function M.ensureGlassDecor(fr)
        if not fr then return end
        -- specular sweep layer
        local shine = fr:FindFirstChild("GlassShine")
        if not shine then
            shine = Instance.new("Frame")
            shine.Name = "GlassShine"
            shine.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            shine.BackgroundTransparency = 0
            shine.BorderSizePixel = 0
            shine.Size = UDim2.new(1, 0, 1, 0)
            shine.ZIndex = 2
            shine.Parent = fr
            Instance.new("UICorner", shine).CornerRadius = UDim.new(0, 14)
            local sg = Instance.new("UIGradient")
            sg.Name = "ShineGrad"
            sg.Rotation = 25
            sg.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
                ColorSequenceKeypoint.new(0.45, Color3.fromRGB(255, 255, 255)),
                ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 255, 255)),
            })
            sg.Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 1),
                NumberSequenceKeypoint.new(0.38, 1),
                NumberSequenceKeypoint.new(0.48, 0.72), -- bright glass flash
                NumberSequenceKeypoint.new(0.58, 1),
                NumberSequenceKeypoint.new(1, 1),
            })
            sg.Parent = shine
        end
        -- top accent line (Rainy topLine)
        local topLine = fr:FindFirstChild("GlassTopLine")
        if not topLine then
            topLine = Instance.new("Frame")
            topLine.Name = "GlassTopLine"
            topLine.Size = UDim2.new(0, 140, 0, 2)
            topLine.Position = UDim2.new(0, 28, 0, 10)
            topLine.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            topLine.BorderSizePixel = 0
            topLine.ZIndex = 12
            topLine.Parent = fr
            Instance.new("UICorner", topLine).CornerRadius = UDim.new(0, 2)
            local lg = Instance.new("UIGradient")
            lg.Name = "TopLineGrad"
            lg.Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 0.15),
                NumberSequenceKeypoint.new(0.72, 0.48),
                NumberSequenceKeypoint.new(1, 1),
            })
            lg.Parent = topLine
        end
        -- soft inner rim light at top of panel
        local rim = fr:FindFirstChild("GlassRim")
        if not rim then
            rim = Instance.new("Frame")
            rim.Name = "GlassRim"
            rim.Size = UDim2.new(1, -16, 0, 28)
            rim.Position = UDim2.new(0, 8, 0, 6)
            rim.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            rim.BorderSizePixel = 0
            rim.ZIndex = 2
            rim.Parent = fr
            Instance.new("UICorner", rim).CornerRadius = UDim.new(0, 12)
            local rg = Instance.new("UIGradient")
            rg.Rotation = 90
            rg.Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 0.78),
                NumberSequenceKeypoint.new(0.55, 0.94),
                NumberSequenceKeypoint.new(1, 1),
            })
            rg.Parent = rim
        end
        return shine, topLine, rim
    end

    function M.startGlassEdgePulse()
        M.stopGlassEdgePulse()
        local fr = M.mainFrame
        if not fr then return end
        local st = fr:FindFirstChild("MainStroke")
        local shine, topLine = M.ensureGlassDecor(fr)
        local shineGrad = shine and shine:FindFirstChild("ShineGrad")
        local topGrad = topLine and topLine:FindFirstChild("TopLineGrad")
        local token = (M._glassEdgePulseToken or 0) + 1
        M._glassEdgePulseToken = token

        -- stroke pulse (Rainy)
        task.spawn(function()
            local bright = false
            while M.uiStyle == "Glossy" and fr.Parent and M._glassEdgePulseToken == token do
                bright = not bright
                local accent, dark = M.getGlassAccent()
                if st then
                    pcall(function()
                        TweenService:Create(st, TweenInfo.new(1.4, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
                            Transparency = bright and 0.28 or 0.62,
                            Color = bright and accent or dark,
                        }):Play()
                    end)
                end
                task.wait(1.4)
            end
        end)

        -- continuous shine sweep + top-line accent shimmer
        M._glassShineConn = RunService.Heartbeat:Connect(function()
            if M.uiStyle ~= "Glossy" or not fr.Parent then return end
            local t = tick()
            local accent, dark = M.getGlassAccent()
            if shineGrad then
                -- moving specular band across glass
                local off = (t * 0.22) % 1.6 - 0.3
                shineGrad.Offset = Vector2.new(off, 0)
                shineGrad.Rotation = 18 + math.sin(t * 0.35) * 8
            end
            if topLine then
                topLine.BackgroundColor3 = accent
            end
            if topGrad then
                topGrad.Color = M._glassAccentSequence(t)
                topGrad.Offset = Vector2.new(math.sin(t * 0.8) * 0.35, 0)
            end
            -- title shiny gradient
            local title = fr:FindFirstChild("Title", true)
            if title and title:IsA("TextLabel") then
                local tg = title:FindFirstChild("GlassTitleGrad")
                if tg then
                    tg.Color = M._glassAccentSequence(t)
                    tg.Offset = Vector2.new((t * 0.45) % 2 - 1, 0)
                end
            end
        end)
    end

    function M.applyGlassEdgeTheme()
        if (M.uiStyle or "Basic") ~= "Glossy" then return end
        local fr = M.mainFrame
        if not fr then return end
        local accent, dark = M.getGlassAccent()
        local st = fr:FindFirstChild("MainStroke")
        if st then
            st.Color = accent
            st.Thickness = 1.35
        end
        local topLine = fr:FindFirstChild("GlassTopLine")
        if topLine then topLine.BackgroundColor3 = accent end
        for _, d in ipairs(fr:GetDescendants()) do
            if d:GetAttribute("KyzenCard") or d:FindFirstChild("CardStroke") then
                local stroke = d:FindFirstChild("CardStroke") or d:FindFirstChildOfClass("UIStroke")
                if stroke then
                    stroke.Color = dark
                    stroke.Transparency = 0.22
                    stroke.Thickness = 1.1
                end
            end
            if d.Name == "TabStroke" and d:IsA("UIStroke") then
                local ts = d
                if ts.Transparency > 0.2 then
                    ts.Color = dark
                else
                    ts.Color = accent
                end
            end
        end
        local header = fr:FindFirstChild("Header", true)
        if header then
            local hs = header:FindFirstChild("GlassHeaderStroke") or header:FindFirstChildOfClass("UIStroke")
            if hs then hs.Color = dark; hs.Transparency = 0.18 end
        end
    end

    function M.applyUiStyle(style)
        style = style or M.uiStyle or "Basic"
        M.uiStyle = style
        local fr = M.mainFrame
        if not fr or not fr.Parent then return end
        local glossy = (style == "Glossy")
        local accent, dark = M.getGlassAccent()

        -- shell
        fr.BackgroundColor3 = glossy and Color3.fromRGB(6, 14, 24) or Color3.fromRGB(12, 12, 14)
        fr.BackgroundTransparency = glossy and 0.72 or 0.35
        local corner = fr:FindFirstChildOfClass("UICorner")
        if corner then
            corner.CornerRadius = glossy and UDim.new(0, 14) or UDim.new(0, 38)
        end

        local st = fr:FindFirstChild("MainStroke")
        if st then
            if glossy then
                st.Color = accent
                st.Thickness = 1.35
                st.Transparency = 0.45
            else
                st.Color = Color3.fromRGB(180, 180, 190)
                st.Thickness = 1.6
                st.Transparency = 0.25
            end
        end

        -- no bg asset in glossy
        local bg = fr:FindFirstChild("BackgroundImage")
        if bg then
            if glossy then
                bg.Visible = false
                bg.Image = ""
                bg.ImageTransparency = 1
                bg.BackgroundTransparency = 1
            else
                bg.Visible = true
                bg.ImageTransparency = 0.2
                bg.BackgroundTransparency = 0.2
                pcall(function() M.applyBackground(M.selectedBackground or "Default") end)
            end
        end
        local ov = fr:FindFirstChild("BgOverlay")
        if ov then
            if glossy then
                ov.BackgroundColor3 = Color3.fromRGB(4, 14, 26)
                ov.BackgroundTransparency = 0.78
                local oc = ov:FindFirstChildOfClass("UICorner")
                if oc then oc.CornerRadius = UDim.new(0, 14) end
                -- glass depth gradient on overlay
                local og = ov:FindFirstChild("GlassOverlayGrad")
                if not og then
                    og = Instance.new("UIGradient")
                    og.Name = "GlassOverlayGrad"
                    og.Rotation = 135
                    og.Parent = ov
                end
                og.Enabled = true
                og.Color = ColorSequence.new({
                    ColorSequenceKeypoint.new(0, Color3.fromRGB(12, 40, 70)),
                    ColorSequenceKeypoint.new(0.45, Color3.fromRGB(6, 18, 34)),
                    ColorSequenceKeypoint.new(1, Color3.fromRGB(2, 8, 16)),
                })
            else
                ov.BackgroundColor3 = Color3.fromRGB(8, 8, 10)
                ov.BackgroundTransparency = 0.55
                local oc = ov:FindFirstChildOfClass("UICorner")
                if oc then oc.CornerRadius = UDim.new(0, 38) end
                local og = ov:FindFirstChild("GlassOverlayGrad")
                if og then og.Enabled = false end
            end
        end

        -- glass decor visibility
        for _, n in ipairs({"GlassShine", "GlassTopLine", "GlassRim"}) do
            local el = fr:FindFirstChild(n)
            if el then el.Visible = glossy end
        end
        if glossy then
            M.ensureGlassDecor(fr)
            for _, n in ipairs({"GlassShine", "GlassTopLine", "GlassRim"}) do
                local el = fr:FindFirstChild(n)
                if el then
                    el.Visible = true
                    local c = el:FindFirstChildOfClass("UICorner")
                    if c then c.CornerRadius = UDim.new(0, n == "GlassTopLine" and 2 or 14) end
                end
            end
        end

        -- hide solid side rails in glossy
        for _, child in ipairs(fr:GetChildren()) do
            if child:IsA("Frame") and child.Size.X.Offset == 2 and child.BackgroundTransparency >= 0.8 then
                child.Visible = not glossy
            end
        end

        -- header glass plate
        local header = fr:FindFirstChild("Header", true)
        if header and header:IsA("Frame") then
            if glossy then
                header.BackgroundColor3 = Color3.fromRGB(5, 20, 36)
                header.BackgroundTransparency = 0.70
                local hc = header:FindFirstChildOfClass("UICorner")
                if hc then hc.CornerRadius = UDim.new(0, 10) end
                local hs = header:FindFirstChild("GlassHeaderStroke")
                if not hs then
                    hs = Instance.new("UIStroke")
                    hs.Name = "GlassHeaderStroke"
                    hs.Parent = header
                end
                hs.Color = dark
                hs.Thickness = 1
                hs.Transparency = 0.18
                -- header plate gradient (Rainy)
                local hg = header:FindFirstChild("GlassHeaderGrad")
                if not hg then
                    hg = Instance.new("UIGradient")
                    hg.Name = "GlassHeaderGrad"
                    hg.Rotation = 12
                    hg.Parent = header
                end
                hg.Enabled = true
                hg.Color = ColorSequence.new({
                    ColorSequenceKeypoint.new(0, Color3.fromRGB(8, 42, 76)),
                    ColorSequenceKeypoint.new(0.48, Color3.fromRGB(4, 22, 40)),
                    ColorSequenceKeypoint.new(1, Color3.fromRGB(1, 9, 18)),
                })
            else
                header.BackgroundColor3 = Color3.fromRGB(16, 16, 18)
                header.BackgroundTransparency = 0.5
                local hc = header:FindFirstChildOfClass("UICorner")
                if hc then hc.CornerRadius = UDim.new(0, 22) end
                local hs = header:FindFirstChild("GlassHeaderStroke")
                if hs then hs:Destroy() end
                local hg = header:FindFirstChild("GlassHeaderGrad")
                if hg then hg.Enabled = false end
            end
        end

        -- title shiny gradient (Rainy-style)
        local title = fr:FindFirstChild("Title", true)
        if title and title:IsA("TextLabel") then
            local tg = title:FindFirstChild("GlassTitleGrad")
            if glossy then
                if not tg then
                    tg = Instance.new("UIGradient")
                    tg.Name = "GlassTitleGrad"
                    tg.Parent = title
                end
                tg.Enabled = true
                tg.Color = M._glassAccentSequence(0)
                title.TextColor3 = Color3.fromRGB(255, 255, 255)
                pcall(function() M.applyShinyText(title, 0.55, true) end)
            else
                if tg then tg.Enabled = false end
                title.TextColor3 = Color3.fromRGB(255, 255, 255)
            end
        end

        -- content / tabs
        local cbg = fr:FindFirstChild("ContentBg", true)
        if cbg and cbg:IsA("Frame") then
            if glossy then
                cbg.BackgroundColor3 = Color3.fromRGB(4, 8, 14)
                cbg.BackgroundTransparency = 0.88
                local cc = cbg:FindFirstChildOfClass("UICorner")
                if cc then cc.CornerRadius = UDim.new(0, 10) end
            else
                cbg.BackgroundColor3 = Color3.fromRGB(14, 14, 16)
                cbg.BackgroundTransparency = 0.5
                local cc = cbg:FindFirstChildOfClass("UICorner")
                if cc then cc.CornerRadius = UDim.new(0, 22) end
            end
        end
        local tabBar = fr:FindFirstChild("TabBar", true)
        if tabBar and (tabBar:IsA("Frame") or tabBar:IsA("ScrollingFrame")) then
            if glossy then
                tabBar.BackgroundColor3 = Color3.fromRGB(4, 4, 8)
                tabBar.BackgroundTransparency = 0.72
            else
                tabBar.BackgroundColor3 = Color3.fromRGB(12, 12, 14)
                tabBar.BackgroundTransparency = 0.35
            end
        end

        -- glass rows + optional top micro-shine
        for _, d in ipairs(fr:GetDescendants()) do
            if d:GetAttribute("KyzenCard") or (d:IsA("Frame") and d:FindFirstChild("CardGrad")) then
                local grad = d:FindFirstChild("CardGrad")
                local stroke = d:FindFirstChild("CardStroke") or d:FindFirstChildOfClass("UIStroke")
                if glossy then
                    if grad then grad.Enabled = false end
                    d.BackgroundColor3 = Color3.fromRGB(10, 12, 18)
                    d.BackgroundTransparency = 0.40
                    if stroke then
                        stroke.Color = dark
                        stroke.Transparency = 0.22
                        stroke.Thickness = 1.1
                    end
                    -- tiny top specular on each card
                    local micro = d:FindFirstChild("GlassCardShine")
                    if not micro then
                        micro = Instance.new("Frame")
                        micro.Name = "GlassCardShine"
                        micro.Size = UDim2.new(1, 0, 0, 10)
                        micro.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                        micro.BorderSizePixel = 0
                        micro.ZIndex = (d.ZIndex or 1) + 1
                        micro.Parent = d
                        Instance.new("UICorner", micro).CornerRadius = UDim.new(0, 10)
                        local mg = Instance.new("UIGradient")
                        mg.Rotation = 90
                        mg.Transparency = NumberSequence.new({
                            NumberSequenceKeypoint.new(0, 0.82),
                            NumberSequenceKeypoint.new(1, 1),
                        })
                        mg.Parent = micro
                    end
                    micro.Visible = true
                else
                    if grad then grad.Enabled = true end
                    d.BackgroundColor3 = UI_ROW_BG or Color3.fromRGB(0, 0, 0)
                    d.BackgroundTransparency = 0.03
                    if stroke then
                        stroke.Color = UI_CARD_STROKE or Color3.fromRGB(45, 45, 45)
                        stroke.Transparency = 0.45
                        stroke.Thickness = 1
                    end
                    local micro = d:FindFirstChild("GlassCardShine")
                    if micro then micro.Visible = false end
                end
            end
        end

        if glossy then
            M.startGlassEdgePulse()
            M.applyGlassEdgeTheme()
        else
            M.stopGlassEdgePulse()
            for _, n in ipairs({"GlassShine", "GlassTopLine", "GlassRim"}) do
                local el = fr:FindFirstChild(n)
                if el then el.Visible = false end
            end
        end
    end

    -- subtle side rails (7UP can look, monochrome)
    for _, sideX in ipairs({6, WIN_W - 12}) do
        local rail = Instance.new("Frame")
        rail.Size = UDim2.new(0, 2, 1, -28)
        rail.Position = UDim2.new(0, sideX, 0, 14)
        rail.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        rail.BackgroundTransparency = sideX < WIN_W / 2 and 0.88 or 0.82
        rail.BorderSizePixel = 0
        rail.ZIndex = 1
        rail.Parent = Frame
    end

    local mainContent = Instance.new("Frame")
    mainContent.Name = "MainContent"
    mainContent.Size = UDim2.new(1, -16, 1, -28)
    mainContent.Position = UDim2.new(0, 8, 0, 14)
    mainContent.BackgroundTransparency = 1
    mainContent.BorderSizePixel = 0
    mainContent.ZIndex = 3
    mainContent.ClipsDescendants = true
    mainContent.Parent = Frame
    Instance.new("UICorner", mainContent).CornerRadius = UDim.new(0, 28)

    -- Title bar (7UP-style)
    local titleBar = Instance.new("Frame")
    titleBar.Name = "Header"
    titleBar.Size = UDim2.new(1, 0, 0, TITLE_H)
    titleBar.BackgroundColor3 = Color3.fromRGB(16, 16, 18)
    titleBar.BackgroundTransparency = 0.5 -- half transparent like tab area
    titleBar.BorderSizePixel = 0
    titleBar.ZIndex = 5
    titleBar.Parent = mainContent
    Instance.new("UICorner", titleBar).CornerRadius = UDim.new(0, 22)
    local Header = titleBar -- alias for legacy drag/handlers

    local badge = Instance.new("Frame")
    badge.Size = UDim2.new(0, 28, 0, 28)
    badge.Position = UDim2.new(0, 12, 0.5, -14)
    badge.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    badge.BorderSizePixel = 0
    badge.ZIndex = 6
    badge.Parent = titleBar
    Instance.new("UICorner", badge).CornerRadius = UDim.new(1, 0)
    local badgeLbl = Instance.new("TextLabel")
    badgeLbl.Size = UDim2.new(1, 0, 1, 0)
    badgeLbl.BackgroundTransparency = 1
    badgeLbl.Text = "K"
    badgeLbl.TextColor3 = Color3.fromRGB(0, 0, 0)
    badgeLbl.Font = Enum.Font.GothamBlack
    badgeLbl.TextSize = 14
    badgeLbl.ZIndex = 7
    badgeLbl.Parent = badge

    local Title = Instance.new("TextLabel")
    Title.Name = "Title"
    Title.Size = UDim2.new(1, -140, 1, 0)
    Title.Position = UDim2.new(0, 48, 0, 0)
    Title.BackgroundTransparency = 1
    Title.Text = "KYZEN  ·  DUELS"
    Title.TextColor3 = Color3.fromRGB(255, 255, 255)
    Title.Font = Enum.Font.GothamBlack
    Title.TextSize = 14
    Title.TextXAlignment = Enum.TextXAlignment.Left
    Title.ZIndex = 6
    Title.Parent = titleBar

    local MinBtn = Instance.new("TextButton")
    MinBtn.Size = UDim2.new(0, 28, 0, 28)
    MinBtn.Position = UDim2.new(1, -72, 0.5, -14)
    MinBtn.BackgroundColor3 = Color3.fromRGB(22, 22, 26)
    MinBtn.Text = "—"
    MinBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    MinBtn.Font = Enum.Font.GothamBold
    MinBtn.TextSize = 14
    MinBtn.AutoButtonColor = false
    MinBtn.ZIndex = 7
    MinBtn.Parent = titleBar
    Instance.new("UICorner", MinBtn).CornerRadius = UDim.new(0, 8)

    local CloseBtn = Instance.new("TextButton")
    CloseBtn.Size = UDim2.new(0, 28, 0, 28)
    CloseBtn.Position = UDim2.new(1, -36, 0.5, -14)
    CloseBtn.BackgroundColor3 = Color3.fromRGB(22, 22, 26)
    CloseBtn.Text = "×"
    CloseBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    CloseBtn.Font = Enum.Font.GothamBold
    CloseBtn.TextSize = 16
    CloseBtn.AutoButtonColor = false
    CloseBtn.ZIndex = 7
    CloseBtn.Parent = titleBar
    Instance.new("UICorner", CloseBtn).CornerRadius = UDim.new(0, 8)

    local lockButton = Instance.new("TextButton")
    lockButton.Size = UDim2.new(0, 54, 0, 22)
    lockButton.Position = UDim2.new(1, -140, 0.5, -11)
    lockButton.BackgroundColor3 = Color3.fromRGB(22, 22, 26)
    lockButton.BorderSizePixel = 0
    lockButton.Text = M.uiLocked and "LOCK" or "UNLOCK"
    lockButton.TextColor3 = Color3.fromRGB(180, 180, 190)
    lockButton.Font = Enum.Font.GothamBold
    lockButton.TextSize = 9
    lockButton.AutoButtonColor = false
    lockButton.ZIndex = 7
    lockButton.Parent = titleBar
    Instance.new("UICorner", lockButton).CornerRadius = UDim.new(0, 8)
    local locked = M.uiLocked == true
    lockButton.Activated:Connect(function()
        locked = not locked
        M.uiLocked = locked
        lockButton.Text = locked and "LOCK" or "UNLOCK"
        pcall(saveCherryConfig)
    end)

    -- Body under title
    local contentBg = Instance.new("Frame")
    contentBg.Name = "ContentBg"
    contentBg.Size = UDim2.new(1, 0, 1, -(TITLE_H + 4))
    contentBg.Position = UDim2.new(0, 0, 0, TITLE_H + 4)
    contentBg.BackgroundColor3 = Color3.fromRGB(14, 14, 16)
    contentBg.BackgroundTransparency = 0.5 -- half transparent behind tabs
    contentBg.BorderSizePixel = 0
    contentBg.ClipsDescendants = true
    contentBg.ZIndex = 2
    contentBg.Parent = mainContent
    Instance.new("UICorner", contentBg).CornerRadius = UDim.new(0, 22)

    -- Tab bar (half transparent so game shows through)
    local TabBar = Instance.new("ScrollingFrame")
    TabBar.Name = "TabBar"
    TabBar.Size = UDim2.new(0, TAB_BAR_W, 1, -12)
    TabBar.Position = UDim2.new(0, 4, 0, 6) -- default Left; applyTabLayout may change
    TabBar.BackgroundColor3 = Color3.fromRGB(20, 20, 26)
    TabBar.BackgroundTransparency = 0.5 -- half transparent glass, not plain solid
    TabBar.BorderSizePixel = 0
    TabBar.ScrollBarThickness = 0
    TabBar.ScrollingDirection = Enum.ScrollingDirection.Y
    TabBar.CanvasSize = UDim2.new(0, 0, 0, 0)
    TabBar.AutomaticCanvasSize = Enum.AutomaticSize.Y
    TabBar.ZIndex = 4
    TabBar.Parent = contentBg
    Instance.new("UICorner", TabBar).CornerRadius = UDim.new(0, 14)

    local TabsLayout = Instance.new("UIListLayout")
    TabsLayout.FillDirection = Enum.FillDirection.Vertical
    TabsLayout.Padding = UDim.new(0, 6)
    TabsLayout.SortOrder = Enum.SortOrder.LayoutOrder
    TabsLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    TabsLayout.Parent = TabBar
    local TabPad = Instance.new("UIPadding")
    TabPad.PaddingTop = UDim.new(0, 8)
    TabPad.PaddingBottom = UDim.new(0, 8)
    TabPad.Parent = TabBar

    -- Tab buttons: full width of right rail
    local function makeSideTab(name, text, order, active)
        local b = Instance.new("TextButton")
        b.Name = name
        b.Size = UDim2.new(1, -12, 0, 36)
        b.BackgroundColor3 = active and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(16, 16, 18)
        b.BackgroundTransparency = active and 0.12 or 0.55 -- glass tabs, not plain
        b.BorderSizePixel = 0
        b.Text = text
        b.TextColor3 = active and Color3.fromRGB(0, 0, 0) or Color3.fromRGB(200, 200, 210)
        b.Font = Enum.Font.GothamBlack
        b.TextSize = 11
        b.AutoButtonColor = false
        b.LayoutOrder = order
        b.ZIndex = 5
        b.Parent = TabBar
        Instance.new("UICorner", b).CornerRadius = UDim.new(0, 10)
        local st = Instance.new("UIStroke")
        st.Name = "TabStroke"
        st.Color = Color3.fromRGB(255, 255, 255)
        st.Thickness = active and 1.4 or 1
        st.Transparency = active and 0.15 or 0.7
        st.Parent = b
        b:SetAttribute("IsActiveTab", active and true or false)
        return b
    end

    local TSpeed   = makeSideTab("Tab_SPEED", "SPEED", 1, true)
    local TMech    = makeSideTab("Tab_MECH", "MECH", 2, false)
    local TVis     = makeSideTab("Tab_VIS", "VISUALS", 3, false)
    local TUtil    = makeSideTab("Tab_UTIL", "UTILITY", 4, false)
    local TKB      = makeSideTab("Tab_KB", "KEYS", 5, false)
    local TCtrl    = makeSideTab("Tab_CTRL", "CTRL", 6, false)
    local TBuiltIn = makeSideTab("Tab_BUILTIN", "BUILT IN", 7, false)
    local TGears   = makeSideTab("Tab_GEARS", "ALL GEARS", 8, false)
    local TCustom  = makeSideTab("Tab_CUSTOM", "CUSTOM UI", 9, false)

    -- Content area LEFT of tabs
    local PagedContent = Instance.new("Frame")
    PagedContent.Name = "PagedContent"
    PagedContent.Size = UDim2.new(1, -(TAB_BAR_W + 12), 1, -8)
    PagedContent.Position = UDim2.new(0, TAB_BAR_W + 8, 0, 4)
    PagedContent.BackgroundTransparency = 1
    PagedContent.ClipsDescendants = true
    PagedContent.ZIndex = 3
    PagedContent.Parent = contentBg

    -- None-layout scroll host (all sections in one scroll)
    local NoneScroll = Instance.new("ScrollingFrame")
    NoneScroll.Name = "NoneScroll"
    NoneScroll.Visible = false
    NoneScroll.Size = UDim2.new(1, 0, 1, 0)
    NoneScroll.BackgroundTransparency = 1
    NoneScroll.BorderSizePixel = 0
    NoneScroll.ScrollBarThickness = 8
    NoneScroll.ScrollBarImageColor3 = UI_ACCENT
    NoneScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
    NoneScroll.CanvasSize = UDim2.new(0, 0, 0, 0)
    NoneScroll.ScrollingDirection = Enum.ScrollingDirection.Y
    NoneScroll.ZIndex = 3
    NoneScroll.Parent = contentBg
    local noneLay = Instance.new("UIListLayout")
    noneLay.Padding = UDim.new(0, 10)
    noneLay.SortOrder = Enum.SortOrder.LayoutOrder
    noneLay.Parent = NoneScroll
    local nonePad = Instance.new("UIPadding")
    nonePad.PaddingTop = UDim.new(0, 4)
    nonePad.PaddingBottom = UDim.new(0, 40)
    nonePad.PaddingLeft = UDim.new(0, 2)
    nonePad.PaddingRight = UDim.new(0, 6)
    nonePad.Parent = NoneScroll

    local PM      = uiMakePage(PagedContent, "Page_SPEED",     1, true)
    local PMech   = uiMakePage(PagedContent, "Page_MECHANICS", 2, false)
    local PVis    = uiMakePage(PagedContent, "Page_VISUALS",   3, false)
    local PUtil   = uiMakePage(PagedContent, "Page_UTILITY",   4, false)
    local PKB     = uiMakePage(PagedContent, "Page_KEYBINDS",  5, false)
    local PCtrl   = uiMakePage(PagedContent, "Page_CONTROLLER", 6, false)
    local PBuiltIn = uiMakePage(PagedContent, "Page_BUILTIN",  7, false)
    local PGears   = uiMakePage(PagedContent, "Page_GEARS",    8, false)
    local PCustom  = uiMakePage(PagedContent, "Page_CUSTOM",   9, false)

    local Pages = {SPEED=PM, MECHANICS=PMech, VISUALS=PVis, UTILITY=PUtil, KEYBINDS=PKB, CONTROLLER=PCtrl, BUILTIN=PBuiltIn, GEARS=PGears, CUSTOM=PCustom}
    local Tabs  = {SPEED=TSpeed, MECHANICS=TMech, VISUALS=TVis, UTILITY=TUtil, KEYBINDS=TKB, CONTROLLER=TCtrl, BUILTIN=TBuiltIn, GEARS=TGears, CUSTOM=TCustom}
    local PageOrder = {"SPEED","MECHANICS","VISUALS","UTILITY","KEYBINDS","CONTROLLER","BUILTIN","CUSTOM"}
    local curTab = "SPEED"

    local function switchTab(name)
        if not name or not Pages[name] then return end
        if (M.tabSidePosition or "Left") == "None" then return end -- scroll layout: no tab switching
        if curTab == name then return end
        curTab = name
        for k, p in pairs(Pages) do
            if p then p.Visible = (k == name) end
        end
        for k, b in pairs(Tabs) do
            if b then
                local act = (k == name)
                b:SetAttribute("IsActiveTab", act)
                b.BackgroundColor3 = act and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(16, 16, 18)
                b.BackgroundTransparency = act and 0.15 or 0.5 -- half transparent look
                b.TextColor3 = act and Color3.fromRGB(0, 0, 0) or Color3.fromRGB(200, 200, 210)
                local st = b:FindFirstChild("TabStroke")
                if st then
                    st.Thickness = act and 1.4 or 1
                    st.Transparency = act and 0.15 or 0.7
                end
            end
        end
        -- keep circle anchored under CTRL without overlapping buttons
        if M._placeSidebarAvatar then
            pcall(function() M._placeSidebarAvatar((M.tabSidePosition or "Left") == "Left") end)
        end
    end
    M.selectTab = switchTab

    TSpeed.MouseButton1Click:Connect(function() switchTab("SPEED") end)
    TMech.MouseButton1Click:Connect(function() switchTab("MECHANICS") end)
    TVis.MouseButton1Click:Connect(function() switchTab("VISUALS") end)
    TUtil.MouseButton1Click:Connect(function() switchTab("UTILITY") end)
    TKB.MouseButton1Click:Connect(function() switchTab("KEYBINDS") end)
    TCtrl.MouseButton1Click:Connect(function() switchTab("CONTROLLER") end)
    TBuiltIn.MouseButton1Click:Connect(function() switchTab("BUILTIN") end)
    TGears.MouseButton1Click:Connect(function() switchTab("GEARS") end)
    TCustom.MouseButton1Click:Connect(function() switchTab("CUSTOM") end)

    -- Tab dock: Left | Top | Bottom | None. Saved in config.
    M.tabSidePosition = M.tabSidePosition or "Left"
    -- Floating control so user can leave None mode (TabBar is hidden there)
    local NoneExitBar = Instance.new("Frame")
    NoneExitBar.Name = "NoneExitBar"
    NoneExitBar.Visible = false
    NoneExitBar.Size = UDim2.new(1, -8, 0, 34)
    NoneExitBar.Position = UDim2.new(0, 4, 0, 4)
    NoneExitBar.BackgroundColor3 = Color3.fromRGB(10, 14, 22)
    NoneExitBar.BackgroundTransparency = 0.25
    NoneExitBar.BorderSizePixel = 0
    NoneExitBar.ZIndex = 20
    NoneExitBar.Parent = contentBg
    Instance.new("UICorner", NoneExitBar).CornerRadius = UDim.new(0, 10)
    local noneExitStroke = Instance.new("UIStroke")
    noneExitStroke.Color = UI_ACCENT or Color3.fromRGB(82, 170, 255)
    noneExitStroke.Transparency = 0.35
    noneExitStroke.Thickness = 1.2
    noneExitStroke.Parent = NoneExitBar
    local noneExitLbl = Instance.new("TextLabel")
    noneExitLbl.Size = UDim2.new(1, -100, 1, 0)
    noneExitLbl.Position = UDim2.new(0, 12, 0, 0)
    noneExitLbl.BackgroundTransparency = 1
    noneExitLbl.Text = "LAYOUT  ·  NONE  (scroll all)"
    noneExitLbl.TextColor3 = Color3.fromRGB(220, 230, 245)
    noneExitLbl.Font = Enum.Font.GothamBold
    noneExitLbl.TextSize = 11
    noneExitLbl.TextXAlignment = Enum.TextXAlignment.Left
    noneExitLbl.ZIndex = 21
    noneExitLbl.Parent = NoneExitBar
    local noneExitBtn = Instance.new("TextButton")
    noneExitBtn.Size = UDim2.new(0, 86, 0, 24)
    noneExitBtn.Position = UDim2.new(1, -92, 0.5, -12)
    noneExitBtn.BackgroundColor3 = Color3.fromRGB(20, 28, 40)
    noneExitBtn.Text = "TABS ON"
    noneExitBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    noneExitBtn.Font = Enum.Font.GothamBlack
    noneExitBtn.TextSize = 11
    noneExitBtn.AutoButtonColor = false
    noneExitBtn.ZIndex = 22
    noneExitBtn.Parent = NoneExitBar
    Instance.new("UICorner", noneExitBtn).CornerRadius = UDim.new(0, 8)

    local function refreshNonePageHeights()
        for _, name in ipairs(PageOrder) do
            local p = Pages[name]
            if p and p.Parent == NoneScroll then
                local lay = p:FindFirstChildOfClass("UIListLayout")
                local pad = p:FindFirstChildOfClass("UIPadding")
                local h = 40
                if lay then
                    h = lay.AbsoluteContentSize.Y
                    if pad then
                        h = h + (pad.PaddingTop.Offset or 0) + (pad.PaddingBottom.Offset or 0)
                    end
                    h = math.max(h + 8, 48)
                end
                p.Size = UDim2.new(1, 0, 0, h)
                p.CanvasSize = UDim2.new(0, 0, 0, h)
            end
        end
    end

    local function exitNoneLayout()
        NoneExitBar.Visible = false
        NoneScroll.Visible = false
        PagedContent.Visible = true
        TabBar.Visible = true
        for _, name in ipairs(PageOrder) do
            local p = Pages[name]
            if p then
                p.Parent = PagedContent
                p.Size = UDim2.new(1, 0, 1, 0)
                p.ScrollingEnabled = true
                p.AutomaticSize = Enum.AutomaticSize.None
                p.AutomaticCanvasSize = Enum.AutomaticSize.Y
                p.Visible = (name == curTab)
            end
        end
    end

    local function enterNoneLayout()
        TabBar.Visible = false
        PagedContent.Visible = false
        NoneScroll.Visible = true
        NoneExitBar.Visible = true
        NoneScroll.Position = UDim2.new(0, 4, 0, 42)
        NoneScroll.Size = UDim2.new(1, -8, 1, -46)
        NoneScroll.ScrollingEnabled = true
        NoneScroll.Active = true
        NoneScroll.ScrollBarThickness = 8
        NoneScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
        for i, name in ipairs(PageOrder) do
            local p = Pages[name]
            if p then
                p.Parent = NoneScroll
                p.LayoutOrder = i
                p.Visible = true
                p.ScrollingEnabled = false
                p.AutomaticSize = Enum.AutomaticSize.None
                p.AutomaticCanvasSize = Enum.AutomaticSize.None
                -- height forced from content (nested scroll height is unreliable)
                local lay = p:FindFirstChildOfClass("UIListLayout")
                local h = 200
                if lay then
                    h = math.max(lay.AbsoluteContentSize.Y + 48, 80)
                end
                p.Size = UDim2.new(1, 0, 0, h)
                p.CanvasSize = UDim2.new(0, 0, 0, h)
            end
        end
        if M._placeSidebarAvatar then M._placeSidebarAvatar(false) end
        task.defer(refreshNonePageHeights)
        task.delay(0.1, refreshNonePageHeights)
        task.delay(0.35, refreshNonePageHeights)
        -- keep heights in sync when lists expand
        if not M._noneHeightHooked then
            M._noneHeightHooked = true
            for _, name in ipairs(PageOrder) do
                local p = Pages[name]
                if p then
                    local lay = p:FindFirstChildOfClass("UIListLayout")
                    if lay then
                        lay:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
                            if (M.tabSidePosition or "Left") == "None" then
                                refreshNonePageHeights()
                            end
                        end)
                    end
                end
            end
        end
    end

    noneExitBtn.Activated:Connect(function()
        -- leave None → back to Left tabs
        if M.applyTabLayout then M.applyTabLayout("Left") end
    end)

    local function applyTabLayout(pos)
        pos = pos or M.tabSidePosition or "Left"
        if pos == "Right" then pos = "Left" end
        M.tabSidePosition = pos
        local barW = TAB_BAR_W
        TabsLayout.FillDirection = Enum.FillDirection.Vertical
        TabsLayout.Padding = UDim.new(0, 6)
        TabBar.ScrollingDirection = Enum.ScrollingDirection.Y
        TabBar.AutomaticCanvasSize = Enum.AutomaticSize.Y

        if pos == "None" then
            enterNoneLayout()
            pcall(saveCherryConfig)
            return
        end

        -- restore normal tab pages if coming from None
        exitNoneLayout()

        if pos == "Top" then
            TabBar.Size = UDim2.new(1, -8, 0, 42)
            TabBar.Position = UDim2.new(0, 4, 0, 4)
            TabsLayout.FillDirection = Enum.FillDirection.Horizontal
            TabsLayout.Padding = UDim.new(0, 8)
            TabBar.ScrollingDirection = Enum.ScrollingDirection.X
            TabBar.AutomaticCanvasSize = Enum.AutomaticSize.X
            for _, b in pairs(Tabs) do
                if b then b.Size = UDim2.new(0, 72, 0, 32) end
            end
            PagedContent.Position = UDim2.new(0, 4, 0, 50)
            PagedContent.Size = UDim2.new(1, -8, 1, -54)
        elseif pos == "Bottom" then
            TabBar.Size = UDim2.new(1, -8, 0, 42)
            TabBar.Position = UDim2.new(0, 4, 1, -46)
            TabsLayout.FillDirection = Enum.FillDirection.Horizontal
            TabsLayout.Padding = UDim.new(0, 8)
            TabBar.ScrollingDirection = Enum.ScrollingDirection.X
            TabBar.AutomaticCanvasSize = Enum.AutomaticSize.X
            for _, b in pairs(Tabs) do
                if b then b.Size = UDim2.new(0, 78, 0, 32) end
            end
            PagedContent.Position = UDim2.new(0, 4, 0, 4)
            PagedContent.Size = UDim2.new(1, -8, 1, -54)
        else -- Left (default)
            TabBar.Size = UDim2.new(0, barW, 1, -12)
            TabBar.Position = UDim2.new(0, 4, 0, 6)
            TabsLayout.FillDirection = Enum.FillDirection.Vertical
            TabsLayout.Padding = UDim.new(0, 14)
            TabBar.ScrollingDirection = Enum.ScrollingDirection.Y
            TabBar.AutomaticCanvasSize = Enum.AutomaticSize.Y
            for _, b in pairs(Tabs) do
                if b then b.Size = UDim2.new(1, -12, 0, 40) end
            end
            PagedContent.Position = UDim2.new(0, barW + 8, 0, 4)
            PagedContent.Size = UDim2.new(1, -(barW + 12), 1, -8)
            if M._placeSidebarAvatar then M._placeSidebarAvatar(true) end
        end
        if pos ~= "Left" and M._placeSidebarAvatar then M._placeSidebarAvatar(false) end
        pcall(saveCherryConfig)
    end
    M.applyTabLayout = applyTabLayout

    -- ============================================================
    -- SIDEBAR AVATAR — Skorpion ring effect, ALWAYS under tab buttons
    -- Host is sibling of TabBar (no UIListLayout) so ring+hold stack as ONE circle
    -- ============================================================
    pcall(function()
        if M._avatarHost and M._avatarHost.Parent then M._avatarHost:Destroy() end
        for _, parent in ipairs({TabBar, contentBg, Frame}) do
            if parent then
                for _, n in ipairs({"SidebarAvatarHost", "SidebarAvatarRing", "SidebarAvatarHold"}) do
                    local o = parent:FindFirstChild(n)
                    if o then o:Destroy() end
                end
            end
        end
    end)
    if M._sidebarAvSpinConn then
        pcall(function() M._sidebarAvSpinConn:Disconnect() end)
        M._sidebarAvSpinConn = nil
    end

    local AVATAR_SIZE = 70

    local avatarHost = Instance.new("Frame")
    avatarHost.Name = "SidebarAvatarHost"
    avatarHost.BackgroundTransparency = 1
    avatarHost.BorderSizePixel = 0
    avatarHost.ClipsDescendants = false
    avatarHost.ZIndex = 12
    avatarHost.Visible = false
    avatarHost.Parent = contentBg
    M._avatarHost = avatarHost

    -- Outer spinning ring (exact Skorpion gradient pattern)
    local sideAvRing = Instance.new("Frame")
    sideAvRing.Name = "SidebarAvatarRing"
    sideAvRing.Size = UDim2.new(0, AVATAR_SIZE + 8, 0, AVATAR_SIZE + 8)
    sideAvRing.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    sideAvRing.BackgroundTransparency = 0
    sideAvRing.BorderSizePixel = 0
    sideAvRing.ZIndex = 12
    sideAvRing.Parent = avatarHost
    Instance.new("UICorner", sideAvRing).CornerRadius = UDim.new(1, 0)
    local sideAvRingGrad = Instance.new("UIGradient", sideAvRing)
    local function skorpionRingColors()
        local acc = UI_ACCENT or CHERRY_ACCENT or Color3.fromRGB(255, 255, 255)
        -- Strong accent segments so red/theme is clearly visible while spinning
        local hi = Color3.new(math.min(1, acc.R * 1.15 + 0.05), math.min(1, acc.G * 1.15 + 0.05), math.min(1, acc.B * 1.15 + 0.05))
        local lo = Color3.new(acc.R * 0.25, acc.G * 0.25, acc.B * 0.25)
        return ColorSequence.new({
            ColorSequenceKeypoint.new(0,   lo),
            ColorSequenceKeypoint.new(0.18, hi),
            ColorSequenceKeypoint.new(0.36, lo),
            ColorSequenceKeypoint.new(0.54, hi),
            ColorSequenceKeypoint.new(0.72, lo),
            ColorSequenceKeypoint.new(0.90, hi),
            ColorSequenceKeypoint.new(1,   lo),
        })
    end
    sideAvRingGrad.Color = skorpionRingColors()
    sideAvRingGrad.Rotation = 0
    M.sidebarAvatarRingGrad = sideAvRingGrad
    M.refreshSidebarAvatarTheme = function()
        if sideAvRingGrad and sideAvRingGrad.Parent then
            sideAvRingGrad.Color = skorpionRingColors()
        end
    end

    -- Inner circle (hold) sits on top → only 4px rim of ring shows = spinning ring effect
    local sideAvHold = Instance.new("Frame")
    sideAvHold.Name = "SidebarAvatarHold"
    sideAvHold.Size = UDim2.new(0, AVATAR_SIZE, 0, AVATAR_SIZE)
    sideAvHold.BackgroundColor3 = Color3.fromRGB(18, 18, 24)
    sideAvHold.BackgroundTransparency = 0
    sideAvHold.BorderSizePixel = 0
    sideAvHold.ZIndex = 13
    sideAvHold.Parent = avatarHost
    Instance.new("UICorner", sideAvHold).CornerRadius = UDim.new(1, 0)
    local sideAvStroke = Instance.new("UIStroke", sideAvHold)
    sideAvStroke.Color = Color3.fromRGB(0, 0, 0)
    sideAvStroke.Thickness = 1.5
    sideAvStroke.Transparency = 0.2
    M.sidebarAvatarStroke = sideAvStroke

    local sideAv = Instance.new("ImageLabel")
    sideAv.Name = "SidebarAvatar"
    sideAv.Size = UDim2.new(1, -4, 1, -4)
    sideAv.Position = UDim2.new(0, 2, 0, 2)
    sideAv.BackgroundTransparency = 1
    sideAv.Image = ""
    sideAv.ZIndex = 14
    sideAv.Parent = sideAvHold
    Instance.new("UICorner", sideAv).CornerRadius = UDim.new(1, 0)
    M.sidebarAvatar = sideAv
    task.spawn(function()
        local ok, url = pcall(function()
            return Players:GetUserThumbnailAsync(player.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size150x150)
        end)
        if ok and url and sideAv and sideAv.Parent then
            sideAv.Image = url
        end
    end)

    -- Spin — FPS FIX: Heartbeat + only when host visible
    local _spinAcc = 0
    M._sidebarAvSpinConn = RunService.Heartbeat:Connect(function(dt)
        if not avatarHost.Visible then return end
        if not sideAvRingGrad or not sideAvRingGrad.Parent then return end
        _spinAcc = _spinAcc + (dt or 0.016)
        if _spinAcc < 0.033 then return end
        local step = _spinAcc
        _spinAcc = 0
        sideAvRingGrad.Rotation = (sideAvRingGrad.Rotation + step * 140) % 360
    end)

    local function placeSidebarAvatar(show)
        -- Circle fixed at BOTTOM of left rail; TabBar height reduced so tabs never overlap it
        local on = (show == true) and ((M.tabSidePosition or "Left") == "Left")
        avatarHost.Visible = on
        if not on then
            -- restore full tab bar height when circle hidden
            if TabBar and (M.tabSidePosition or "Left") == "Left" then
                TabBar.Size = UDim2.new(0, TAB_BAR_W, 1, -12)
            end
            return
        end

        local barW = TAB_BAR_W
        local gap = 10
        local hostH = AVATAR_SIZE + 20
        -- pin host to bottom of content rail
        avatarHost.Size = UDim2.new(0, barW, 0, hostH)
        avatarHost.Position = UDim2.new(0, 4, 1, -(hostH + 6))
        avatarHost.ZIndex = 6
        avatarHost.ClipsDescendants = false

        -- shrink TabBar so last tab (CTRL) ends above the circle
        TabBar.Size = UDim2.new(0, TAB_BAR_W, 1, -(12 + hostH + gap))
        TabBar.Position = UDim2.new(0, 4, 0, 6)

        local ringS = AVATAR_SIZE + 8
        sideAvRing.Size = UDim2.new(0, ringS, 0, ringS)
        sideAvHold.Size = UDim2.new(0, AVATAR_SIZE, 0, AVATAR_SIZE)
        sideAvRing.Position = UDim2.new(0.5, -math.floor(ringS / 2), 0.5, -math.floor(ringS / 2))
        sideAvHold.Position = UDim2.new(0.5, -math.floor(AVATAR_SIZE / 2), 0.5, -math.floor(AVATAR_SIZE / 2))
        if M.refreshSidebarAvatarTheme then M.refreshSidebarAvatarTheme() end
    end
    M._placeSidebarAvatar = placeSidebarAvatar

    M.applyTabLayout = applyTabLayout
    applyTabLayout(M.tabSidePosition)
    if M.applyUiStyle then pcall(function() M.applyUiStyle(M.uiStyle or "Basic") end) end


    -- Drag MainOuter (7UP-style)
    do
        local dragging, dragInput, dragStart, startPos = false, nil, nil, nil
        titleBar.InputBegan:Connect(function(input)
            if M.uiLocked then return end
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragStart = input.Position
                startPos = Frame.Position
                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then dragging = false end
                end)
            end
        end)
        UIS.InputChanged:Connect(function(input)
            if not dragging or M.uiLocked or not dragStart or not startPos then return end
            if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                local d = input.Position - dragStart
                Frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
            end
        end)
    end

    -- close / minimize
    local function closeUI()
        if Frame:GetAttribute("Closing") then return end
        Frame:SetAttribute("Closing", true)
        local scale = Frame:FindFirstChildOfClass("UIScale") or Instance.new("UIScale", Frame)
        local startPos = Frame.Position
        local ti = TweenInfo.new(0.38, Enum.EasingStyle.Back, Enum.EasingDirection.In)
        TweenService:Create(scale, ti, { Scale = 0.72 }):Play()
        TweenService:Create(Frame, ti, {
            Position = UDim2.new(startPos.X.Scale, startPos.X.Offset, startPos.Y.Scale, startPos.Y.Offset + 40),
            BackgroundTransparency = 0.85,
        }):Play()
        for _, d in ipairs(Frame:GetDescendants()) do
            if d:IsA("GuiObject") and d ~= Frame then
                pcall(function()
                    TweenService:Create(d, TweenInfo.new(0.28, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                        BackgroundTransparency = math.min(1, (d.BackgroundTransparency or 0) + 0.7),
                    }):Play()
                end)
                if d:IsA("TextLabel") or d:IsA("TextButton") then
                    pcall(function()
                        TweenService:Create(d, TweenInfo.new(0.28), { TextTransparency = 1 }):Play()
                    end)
                end
            end
        end
        task.delay(0.4, function()
            Frame.Visible = false
            Frame:SetAttribute("Closing", false)
            if scale then scale.Scale = M.uiScale or 1 end
            local isMob = UIS.TouchEnabled and not UIS.KeyboardEnabled
            Frame.Size = isMob and UDim2.new(0, 400, 0, 560) or UDim2.new(0, 450, 0, 660)
            Frame.BackgroundTransparency = 0
            Frame.BackgroundColor3 = Color3.fromRGB(8, 8, 10)
            -- restore descendant transparencies on next open via rebuild is heavy; reset key parts
            for _, d in ipairs(Frame:GetDescendants()) do
                if d:IsA("TextLabel") or d:IsA("TextButton") then
                    pcall(function() d.TextTransparency = 0 end)
                end
            end
        end)
    end
    local MinPill = Instance.new("Frame")
    MinPill.Visible=false; MinPill.Active=true; MinPill.ZIndex=40
    MinPill.AnchorPoint = Vector2.new(0.5, 0)
    -- Top center (same band as auto-grab / status bar)
    MinPill.Position = UDim2.new(0.5, 0, 0, 10)
    MinPill.Size = UDim2.new(0, 150, 0, 36)
    MinPill.BackgroundColor3=Color3.fromRGB(6,6,6); MinPill.BackgroundTransparency=0.02; MinPill.BorderSizePixel=0; MinPill.Parent=gui
    Instance.new("UICorner",MinPill).CornerRadius=UDim.new(0, 12)
    do
        local pst = Instance.new("UIStroke")
        pst.Color = Color3.fromRGB(255, 255, 255)
        pst.Thickness = 1.2
        pst.Transparency = 0.45
        pst.Parent = MinPill
    end
    do
        local l=Instance.new("TextLabel"); l.Name="MinPillTitle"; l.Size=UDim2.new(1,0,1,0); l.BackgroundTransparency=1; l.Text="kyzen.vs"; l.TextColor3=UI_ACCENT; l.TextSize=13; l.Font=Enum.Font.GothamBlack; l.Parent=MinPill
        pcall(function() M.applyShinyText(l, 0.5) end)
        local b=Instance.new("TextButton"); b.ZIndex=41; b.Size=UDim2.new(1,0,1,0); b.BackgroundTransparency=1; b.Text=""; b.AutoButtonColor=false; b.Active=true; b.Parent=MinPill

        -- Pill draggable + click to open (drag wins over click)
        local pDrag, pMoved, pStart, pOrigin
        b.InputBegan:Connect(function(i)
            if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
                if M.uiLocked then return end
                pDrag=true; pMoved=false; pStart=i.Position; pOrigin=MinPill.Position
                i.Changed:Connect(function()
                    if i.UserInputState==Enum.UserInputState.End then pDrag=false end
                end)
            end
        end)
        local function pUpdate(i)
            if not pDrag or not pStart then return end
            local d=i.Position-pStart
            if math.abs(d.X)>3 or math.abs(d.Y)>3 then pMoved=true end
            MinPill.Position=UDim2.new(pOrigin.X.Scale,pOrigin.X.Offset+d.X,pOrigin.Y.Scale,pOrigin.Y.Offset+d.Y)
        end
        b.InputChanged:Connect(function(i)
            if i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch then pUpdate(i) end
        end)
        UIS.InputChanged:Connect(function(i)
            if M.uiLocked then pDrag=false return end
            if i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch then pUpdate(i) end
        end)
        b.MouseButton1Click:Connect(function()
            if pMoved then pMoved=false return end
            MinPill.Visible = false
            if M._animateShowMenu then M._animateShowMenu() else Frame.Visible = true end
            M.menuOpen = true
            pcall(saveCherryConfig)
        end)
    end


    local function restoreFrameVisuals()
        local scale = Frame:FindFirstChildOfClass("UIScale")
        if scale then scale.Scale = M.uiScale or 1 end
        Frame.BackgroundTransparency = 0
        Frame.BackgroundColor3 = Color3.fromRGB(10, 10, 12)
        for _, d in ipairs(Frame:GetDescendants()) do
            if d:IsA("TextLabel") or d:IsA("TextButton") then
                pcall(function() d.TextTransparency = 0 end)
            end
        end
    end

    local function animateHide(thenFn)
        if Frame:GetAttribute("Closing") then return end
        Frame:SetAttribute("Closing", true)
        local scale = Frame:FindFirstChildOfClass("UIScale") or Instance.new("UIScale", Frame)
        local startPos = Frame.Position
        local ti = TweenInfo.new(0.32, Enum.EasingStyle.Back, Enum.EasingDirection.In)
        TweenService:Create(scale, ti, { Scale = 0.78 }):Play()
        TweenService:Create(Frame, ti, {
            Position = UDim2.new(startPos.X.Scale, startPos.X.Offset, startPos.Y.Scale, startPos.Y.Offset + 28),
            BackgroundTransparency = 0.7,
        }):Play()
        for _, d in ipairs(Frame:GetDescendants()) do
            if d:IsA("TextLabel") or d:IsA("TextButton") then
                pcall(function() TweenService:Create(d, TweenInfo.new(0.22), { TextTransparency = 1 }):Play() end)
            end
        end
        task.delay(0.34, function()
            Frame.Visible = false
            Frame:SetAttribute("Closing", false)
            restoreFrameVisuals()
            if thenFn then thenFn() end
        end)
    end

    local function animateShow()
        restoreFrameVisuals()
        Frame.Visible = true
        local scale = Frame:FindFirstChildOfClass("UIScale") or Instance.new("UIScale", Frame)
        scale.Scale = 0.82
        Frame.BackgroundTransparency = 0.5
        local ti = TweenInfo.new(0.36, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
        TweenService:Create(scale, ti, { Scale = M.uiScale or 1 }):Play()
        TweenService:Create(Frame, ti, { BackgroundTransparency = 0 }):Play()
        for _, d in ipairs(Frame:GetDescendants()) do
            if d:IsA("TextLabel") or d:IsA("TextButton") then
                pcall(function()
                    d.TextTransparency = 1
                    TweenService:Create(d, TweenInfo.new(0.28), { TextTransparency = 0 }):Play()
                end)
            end
        end
    end

    local function minimize()
        animateHide(function()
            MinPill.Visible = true
            M.menuOpen = false
            pcall(saveCherryConfig)
        end)
    end
    M._animateShowMenu = animateShow
    M._animateHideMenu = animateHide
    MinBtn.MouseButton1Click:Connect(minimize)
    CloseBtn.MouseButton1Click:Connect(closeUI)

    -- DRAGGING
    do
        local function makeDrag(obj, target)
            local drag,dStart,sPos
            obj.InputBegan:Connect(function(i)
                if M.uiLocked then return end
                if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
                    drag=true; dStart=i.Position; sPos=target.Position
                    i.Changed:Connect(function() if i.UserInputState==Enum.UserInputState.End then drag=false end end)
                end
            end)
            obj.InputChanged:Connect(function(i)
                if i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch then
                    if drag then
                        local d=i.Position-dStart
                        target.Position=UDim2.new(sPos.X.Scale,sPos.X.Offset+d.X,sPos.Y.Scale,sPos.Y.Offset+d.Y)
                    end
                end
            end)
            UIS.InputChanged:Connect(function(i)
                if drag and M.uiLocked then drag=false end
            end)
        end
        makeDrag(Header, Frame)
        makeDrag(MinPill, MinPill)
    end

    -- KEYBIND CAPTURE
    M._anyKeyListening = false
    local activeKBBtn = nil
    M.keybindButtons = {}
    M.keybindButtonList = {}
    local listeningTimeout = nil

    local function resetKeybindCapture()
        if activeKBBtn then
            for e,b in pairs(M.keybindButtons) do
                if b == activeKBBtn then
                    local mode = b:GetAttribute("BindMode") or "both"
                    local txt = "..."
                    if mode == "keyboard" then
                        txt = (e.kb and e.kb.Name) or "..."
                    elseif mode == "controller" then
                        txt = (e.gp and e.gp.Name) or "..."
                    else
                        local parts = {}
                        if e.kb then table.insert(parts, e.kb.Name) end
                        if e.gp then table.insert(parts, e.gp.Name) end
                        txt = (#parts > 0) and table.concat(parts, " / ") or "..."
                    end
                    b.Text = txt
                    b.TextColor3 = UI_TEXT_DIM
                    break
                end
            end
            activeKBBtn = nil
            M._anyKeyListening = false
            if listeningTimeout then task.cancel(listeningTimeout); listeningTimeout = nil end
        end
    end

    local function formatKeybindText(entry, mode)
        if not entry then return "..." end
        mode = mode or "both"
        if mode == "keyboard" then
            return (entry.kb and entry.kb.Name) or "..."
        elseif mode == "controller" then
            return (entry.gp and entry.gp.Name) or "..."
        end
        local parts = {}
        if entry.kb then table.insert(parts, entry.kb.Name) end
        if entry.gp then table.insert(parts, entry.gp.Name) end
        if #parts == 0 then return "..." end
        return table.concat(parts, " / ")
    end

    local function isGamepadInputType(uit)
        return uit == Enum.UserInputType.Gamepad1
            or uit == Enum.UserInputType.Gamepad2
            or uit == Enum.UserInputType.Gamepad3
            or uit == Enum.UserInputType.Gamepad4
            or uit == Enum.UserInputType.Gamepad5
            or uit == Enum.UserInputType.Gamepad6
            or uit == Enum.UserInputType.Gamepad7
            or uit == Enum.UserInputType.Gamepad8
    end

    local function uiKeybindRow(parent, label, kbEntry, bindMode)
        -- bindMode: "keyboard" | "controller" | "both"
        bindMode = bindMode or "both"
        local r = Instance.new("Frame"); r.ClipsDescendants = true; r.Size = UDim2.new(1,0,0,44)
        r.BackgroundColor3 = UI_ROW_BG; r.BackgroundTransparency = 0.1; r.BorderSizePixel = 0; r.Parent = parent; uiCardStyle(r)
        local l = Instance.new("TextLabel"); l.Position=UDim2.new(0,13,0,0); l.Size=UDim2.new(0.42,0,0,44); l.BackgroundTransparency=1
        l.Text=label; l.TextColor3=UI_TEXT_PRIMARY; l.TextSize=13; l.Font=Enum.Font.GothamMedium; l.TextXAlignment=Enum.TextXAlignment.Left; l.Parent=r
        local prompt = (bindMode == "controller") and "Press button..." or ((bindMode == "keyboard") and "Press key..." or "Press key / button...")
        local btn = uiSmallBtn({Parent=r, Pos=UDim2.new(1,-150,0.5,-12), Size=UDim2.new(0,140,0,25),
            Text=formatKeybindText(kbEntry, bindMode),
            Col=UI_TEXT_DIM, TS=10, CR=6})
        btn:SetAttribute("BindMode", bindMode)
        -- unique key so keyboard + controller rows for same entry both work
        M.keybindButtons[kbEntry] = M.keybindButtons[kbEntry] -- keep last for compat
        M.keybindButtonList = M.keybindButtonList or {}
        table.insert(M.keybindButtonList, {entry = kbEntry, btn = btn, mode = bindMode})
        M.keybindButtons[kbEntry] = btn

        btn.MouseButton1Click:Connect(function()
            if activeKBBtn and activeKBBtn ~= btn then resetKeybindCapture() end
            activeKBBtn = btn
            btn.Text = prompt
            btn.TextColor3 = Color3.fromRGB(150,150,150)
            M._anyKeyListening = true
            if listeningTimeout then task.cancel(listeningTimeout) end
            listeningTimeout = task.delay(8, resetKeybindCapture)
        end)
        return r
    end

    local function kbMatch(entry, keycode)
        if not entry or not keycode or keycode == Enum.KeyCode.Unknown then return false end
        if entry.kb and entry.kb == keycode then return true end
        if entry.gp and entry.gp == keycode then return true end
        return false
    end

    M._keybindCaptureConn = UIS.InputBegan:Connect(function(input, gameProcessed)
        -- Always capture while rebinding (even if gameProcessed)
        if M._anyKeyListening then
            if activeKBBtn then
                local kc = input.KeyCode
                if kc == Enum.KeyCode.Escape then
                    resetKeybindCapture(); pcall(saveCherryConfig); return
                end
                local uit = input.UserInputType
                local mode = activeKBBtn:GetAttribute("BindMode") or "both"
                if uit == Enum.UserInputType.Keyboard and kc ~= Enum.KeyCode.Unknown then
                    if mode == "controller" then return end -- keyboard page only / ignore kb on controller rows
                    for _, item in ipairs(M.keybindButtonList or {}) do
                        if item.btn == activeKBBtn then
                            local e, b = item.entry, item.btn
                            e.kb = kc
                            b.Text = formatKeybindText(e, mode)
                            b.TextColor3 = UI_TEXT_DIM
                            activeKBBtn = nil; M._anyKeyListening = false
                            if listeningTimeout then task.cancel(listeningTimeout); listeningTimeout = nil end
                            pcall(saveCherryConfig)
                            break
                        end
                    end
                elseif isGamepadInputType(uit) and kc ~= Enum.KeyCode.Unknown then
                    if mode == "keyboard" then return end -- ignore gamepad on keyboard rows
                    for _, item in ipairs(M.keybindButtonList or {}) do
                        if item.btn == activeKBBtn then
                            local e, b = item.entry, item.btn
                            e.gp = kc
                            b.Text = formatKeybindText(e, mode)
                            b.TextColor3 = UI_TEXT_DIM
                            activeKBBtn = nil; M._anyKeyListening = false
                            if listeningTimeout then task.cancel(listeningTimeout); listeningTimeout = nil end
                            pcall(saveCherryConfig)
                            break
                        end
                    end
                end
            end
            return
        end

        if gameProcessed then return end
        if input.UserInputType ~= Enum.UserInputType.Keyboard and not isGamepadInputType(input.UserInputType) then return end
        local kc = input.KeyCode
        if kc == Enum.KeyCode.Unknown then return end

        if kbMatch(M.KB.LaggerToggle, kc) then
            local now = tick()
            if not M._lastLaggerBindPress or now - M._lastLaggerBindPress > 0.15 then
                M._lastLaggerBindPress = now
                M.cycleLaggerModeBind()
            end
            return
        end
        if kbMatch(M.KB.SpeedToggle, kc) then M.toggleCarryMode(); saveCherryConfig() end
        if kbMatch(M.KB.DropBrainrot, kc) then M.runDrop() end
        if kbMatch(M.KB.TPFloor, kc) then M.runTPFloor() end
        if kbMatch(M.KB.InstaReset, kc) then M.cursedInstaReset() end
        if kbMatch(M.KB.AutoLeft, kc) then
            M.autoLeftEnabled = not M.autoLeftEnabled
            if M.autoLeftEnabled then
                if M.autoRightEnabled then M.autoRightEnabled = false; M.stopAutoRight() end
                if M.autoBatEnabled then M.stopBatAimbot() end
                M.startAutoLeft()
            else M.stopAutoLeft() end
            if M.autoLeftSetVisual then M.autoLeftSetVisual(M.autoLeftEnabled) end
            if M.mobBtnRefs.autoLeft then M.mobBtnRefs.autoLeft(M.autoLeftEnabled) end
            saveCherryConfig()
        end
        if kbMatch(M.KB.AutoRight, kc) then
            M.autoRightEnabled = not M.autoRightEnabled
            if M.autoRightEnabled then
                if M.autoLeftEnabled then M.autoLeftEnabled = false; M.stopAutoLeft() end
                if M.autoBatEnabled then M.stopBatAimbot() end
                M.startAutoRight()
            else M.stopAutoRight() end
            if M.autoRightSetVisual then M.autoRightSetVisual(M.autoRightEnabled) end
            if M.mobBtnRefs.autoRight then M.mobBtnRefs.autoRight(M.autoRightEnabled) end
            saveCherryConfig()
        end
        if kbMatch(M.KB.AutoBat, kc) then
            if not M.autoBatEnabled then
                if M.autoLeftEnabled then M.autoLeftEnabled = false; M.stopAutoLeft() end
                if M.autoRightEnabled then M.autoRightEnabled = false; M.stopAutoRight() end
                M.queueAutoBatStart()
            else M.stopBatAimbot() end
            if M.autoBatSetVisual then M.autoBatSetVisual(M.autoBatEnabled) end
            if M.mobBtnRefs.autoBat then M.mobBtnRefs.autoBat(M.autoBatEnabled) end
            saveCherryConfig()
        end
        if kbMatch(M.KB.BypassAimbot, kc) then
            M.toggleBypassAimbot()
            if M.setBypassVisual then M.setBypassVisual(M.bypassAimbotEnabled) end
            if M.mobBtnRefs.bypass then M.mobBtnRefs.bypass(M.bypassAimbotEnabled) end
            saveCherryConfig()
        end
        if kbMatch(M.KB.GuiHide, kc) then
            if Frame then
                Frame.Visible = not Frame.Visible
                MinPill.Visible = not Frame.Visible
                M.menuOpen = Frame.Visible == true
                pcall(saveCherryConfig)
            end
        end
    end)

    -- ============================================================
