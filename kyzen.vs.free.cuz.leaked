    uiSectionHeader(PCustom, "CUSTOMIZE UI")
    do
        local r = Instance.new("Frame"); r.ClipsDescendants=true; r.Size=UDim2.new(1,0,0,46)
        r.BackgroundColor3=UI_ROW_BG; r.BackgroundTransparency=0.03; r.BorderSizePixel=0; r.Parent=PCustom; uiCardStyle(r)
        local l = Instance.new("TextLabel"); l.Position=UDim2.new(0,13,0,0); l.Size=UDim2.new(0.45,0,1,0)
        l.BackgroundTransparency=1; l.Text="UI Style"; l.TextColor3=UI_TEXT_PRIMARY; l.TextSize=13; l.Font=Enum.Font.GothamMedium; l.TextXAlignment=Enum.TextXAlignment.Left; l.Parent=r
        local styleLbl = Instance.new("TextLabel"); styleLbl.Position=UDim2.new(0.45,0,0,0); styleLbl.Size=UDim2.new(0.55,-10,1,0)
        styleLbl.BackgroundTransparency=1; styleLbl.Text=tostring(M.uiStyle or "Basic"); styleLbl.TextColor3=UI_ACCENT; styleLbl.Font=Enum.Font.GothamBold; styleLbl.TextSize=12; styleLbl.TextXAlignment=Enum.TextXAlignment.Right; styleLbl.Parent=r
        local styles = {"Basic", "Glossy"}
        local idxStyle = 1
        for i,s in ipairs(styles) do if s == (M.uiStyle or "Basic") then idxStyle = i break end end
        local btn = Instance.new("TextButton", r); btn.Size=UDim2.new(1,0,1,0); btn.BackgroundTransparency=1; btn.Text=""
        btn.Activated:Connect(function()
            idxStyle = idxStyle % #styles + 1
            local s = styles[idxStyle]
            styleLbl.Text = s
            M.uiStyle = s
            if M.applyUiStyle then M.applyUiStyle(s) end
            pcall(saveCherryConfig)
        end)
    end

    uiSectionHeader(PCustom, "COLOUR SCHEME")
    do
        local themeNames = {}
        for name in pairs(CHERRY_THEMES) do table.insert(themeNames, name) end
        table.sort(themeNames)
        local cur = CherryConfig.Theme or "Default"
        local idx = 1
        for i,n in ipairs(themeNames) do if n == cur then idx = i break end end

        local r = Instance.new("Frame"); r.ClipsDescendants=true; r.Size=UDim2.new(1,0,0,46)
        r.BackgroundColor3=UI_ROW_BG; r.BackgroundTransparency=0.03; r.BorderSizePixel=0; r.Parent=PCustom; uiCardStyle(r)
        local l = Instance.new("TextLabel"); l.Position=UDim2.new(0,13,0,0); l.Size=UDim2.new(0.4,0,1,0)
        l.BackgroundTransparency=1; l.Text="Theme"; l.TextColor3=UI_TEXT_PRIMARY; l.TextSize=13
        l.Font=Enum.Font.GothamMedium; l.TextXAlignment=Enum.TextXAlignment.Left; l.Parent=r
        local themeLbl = Instance.new("TextLabel"); themeLbl.Position=UDim2.new(0.4,0,0,0); themeLbl.Size=UDim2.new(0.6,-10,1,0)
        themeLbl.BackgroundTransparency=1; themeLbl.Text=cur; themeLbl.TextColor3=UI_ACCENT
        themeLbl.Font=Enum.Font.GothamBold; themeLbl.TextSize=12; themeLbl.TextXAlignment=Enum.TextXAlignment.Right; themeLbl.Parent=r

        -- color swatches
        local sw = Instance.new("Frame"); sw.Size=UDim2.new(1,0,0,36); sw.BackgroundTransparency=1; sw.Parent=PCustom
        local swLay = Instance.new("UIListLayout"); swLay.FillDirection=Enum.FillDirection.Horizontal
        swLay.Padding=UDim.new(0,6); swLay.VerticalAlignment=Enum.VerticalAlignment.Center; swLay.Parent=sw
        local function applyTheme(name)
            local t = CHERRY_THEMES[name]; if not t then return end
            CherryConfig.Theme = name
            M.colorScheme = name
            M._savedTheme = name
            applyAccentFromTheme()
            themeLbl.Text = name
            themeLbl.TextColor3 = t.Accent
            if M.mainFrame then
                M.mainFrame.BackgroundColor3 = UI_BG_DARK
                local st = M.mainFrame:FindFirstChild("MainStroke")
                if st then st.Color = t.Accent end
                local gr = M.mainFrame:FindFirstChild("MainGradient")
                if gr then
                    gr.Color = ColorSequence.new({
                        ColorSequenceKeypoint.new(0, UI_GRAD_TOP),
                        ColorSequenceKeypoint.new(0.45, UI_BG_DARK),
                        ColorSequenceKeypoint.new(1, UI_GRAD_BOT),
                    })
                end
            end
            -- Recolor any remaining pure-black parts immediately
            pcall(function()
                if M.mainFrame then M.recolorBlacksToTheme(M.mainFrame) end
                if M.mobGuiRef then M.recolorBlacksToTheme(M.mobGuiRef) end
                -- statusGui (steal bar) intentionally not recolored
            end)
            M.applyStealBarTheme(t.Accent)
            M.updateHeadTheme()
            if (M.uiStyle or "Basic") == "Glossy" then
                -- Glossy: theme only tints glass EDGES, no background asset
                pcall(function() M.applyGlassEdgeTheme() end)
            else
                pcall(function() M.applyBackgroundTint() end)
            end
            saveCherryConfig()
            -- Live recolor only (no buildGui — that spawned a second UI when parented to gethui)
            task.defer(function()
                pcall(applyAccentFromTheme)
                pcall(function()
                    if M.mainFrame then
                        M.mainFrame.BackgroundColor3 = UI_BG_DARK or Color3.fromRGB(8,8,10)
                        local st = M.mainFrame:FindFirstChild("MainStroke")
                        if st then st.Color = UI_ACCENT or Color3.fromRGB(255,255,255) end
                        M.recolorBlacksToTheme(M.mainFrame)
                    end
                    if M.mobGuiRef then M.recolorBlacksToTheme(M.mobGuiRef) end
                    -- statusGui (steal bar) intentionally not recolored
                    if M.guiRef then M.recolorBlacksToTheme(M.guiRef) end
                end)
                pcall(function() M.applyStealBarTheme(UI_ACCENT) end)
                pcall(function() M.updateHeadTheme() end)
                pcall(function() M.applyBackground(M.selectedBackground) end)
                pcall(function() if M.refreshSidebarAvatarTheme then M.refreshSidebarAvatarTheme() end end)
                if M.mobileButtonsEnabled then
                    pcall(function() M.buildMobileButtons() end)
                end
                saveCherryConfig()
            end)
        end
        for _, name in ipairs(themeNames) do
            local t = CHERRY_THEMES[name]
            local b = Instance.new("TextButton")
            b.Size = UDim2.new(0, 28, 0, 16)
            b.BackgroundColor3 = t.Accent
            b.Text = ""
            b.AutoButtonColor = false
            b.Parent = sw
            Instance.new("UICorner", b).CornerRadius = UDim.new(0, 12)
            local st = Instance.new("UIStroke"); st.Color = Color3.fromRGB(255,255,255); st.Transparency = 0.4; st.Parent = b
            b.MouseButton1Click:Connect(function() applyTheme(name) end)
        end
        local btn = Instance.new("TextButton", r); btn.Size=UDim2.new(1,0,1,0); btn.BackgroundTransparency=1; btn.Text=""
        btn.Activated:Connect(function()
            idx = idx % #themeNames + 1
            applyTheme(themeNames[idx])
        end)
    end

    -- BACKGROUND THEME (under colours)
    uiSectionHeader(PCustom, "BACKGROUND THEME")
    do
        local previewFrame = Instance.new("Frame")
        previewFrame.Size = UDim2.new(1, 0, 0, 90)
        previewFrame.BackgroundColor3 = UI_ROW_BG
        previewFrame.BackgroundTransparency = 0.03
        previewFrame.BorderSizePixel = 0
        previewFrame.ClipsDescendants = true
        previewFrame.Parent = PCustom
        uiCardStyle(previewFrame)

        local previewImage = Instance.new("ImageLabel")
        previewImage.Size = UDim2.new(1, 0, 1, 0)
        previewImage.BackgroundTransparency = 1
        previewImage.Image = M.getBackgroundAssetByName(M.selectedBackground)
        previewImage.ScaleType = Enum.ScaleType.Crop
        previewImage.Parent = previewFrame
        Instance.new("UICorner", previewImage).CornerRadius = UDim.new(0, 10)
        do
            local accent = UI_ACCENT or Color3.fromRGB(255, 255, 255)
            previewImage.ImageColor3 = Color3.new(
                math.clamp(0.55 + accent.R * 0.45, 0, 1),
                math.clamp(0.55 + accent.G * 0.45, 0, 1),
                math.clamp(0.55 + accent.B * 0.45, 0, 1)
            )
        end

        local previewLabel = Instance.new("TextLabel")
        previewLabel.Size = UDim2.new(1, 0, 0, 22)
        previewLabel.Position = UDim2.new(0, 0, 1, -22)
        previewLabel.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        previewLabel.BackgroundTransparency = 0.45
        previewLabel.Text = M.selectedBackground or "Default"
        previewLabel.TextColor3 = UI_TEXT_PRIMARY
        previewLabel.Font = Enum.Font.GothamBold
        previewLabel.TextSize = 11
        previewLabel.ZIndex = 5
        previewLabel.Parent = previewFrame
        Instance.new("UICorner", previewLabel).CornerRadius = UDim.new(0, 8)

        local container = Instance.new("Frame")
        container.Size = UDim2.new(1, 0, 0, 56)
        container.BackgroundTransparency = 1
        container.Parent = PCustom

        local layout = Instance.new("UIListLayout")
        layout.FillDirection = Enum.FillDirection.Horizontal
        layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
        layout.VerticalAlignment = Enum.VerticalAlignment.Center
        layout.Padding = UDim.new(0, 8)
        layout.Parent = container

        local selectedBtn = nil

        for _, bgInfo in ipairs(M.backgroundAssets) do
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(0, 56, 0, 42)
            btn.BackgroundColor3 = UI_BTN_BG or Color3.fromRGB(20, 20, 26)
            btn.BackgroundTransparency = 0.15
            btn.BorderSizePixel = 0
            btn.Text = ""
            btn.AutoButtonColor = false
            btn.Parent = container
            Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)

            local stroke = Instance.new("UIStroke", btn)
            stroke.Color = UI_ACCENT or Color3.fromRGB(200, 200, 210)
            stroke.Thickness = 1.5
            stroke.Transparency = (M.selectedBackground == bgInfo.Name) and 0.15 or 0.65

            local mini = Instance.new("ImageLabel")
            mini.Size = UDim2.new(1, -6, 1, -6)
            mini.Position = UDim2.new(0, 3, 0, 3)
            mini.BackgroundTransparency = 1
            mini.Image = bgInfo.Asset
            mini.ScaleType = Enum.ScaleType.Crop
            mini.Parent = btn
            Instance.new("UICorner", mini).CornerRadius = UDim.new(0, 6)
            do
                local accent = UI_ACCENT or Color3.fromRGB(255, 255, 255)
                mini.ImageColor3 = Color3.new(
                    math.clamp(0.55 + accent.R * 0.45, 0, 1),
                    math.clamp(0.55 + accent.G * 0.45, 0, 1),
                    math.clamp(0.55 + accent.B * 0.45, 0, 1)
                )
            end

            local nameLbl = Instance.new("TextLabel")
            nameLbl.Size = UDim2.new(1, 0, 0, 12)
            nameLbl.Position = UDim2.new(0, 0, 1, 2)
            nameLbl.BackgroundTransparency = 1
            nameLbl.Text = bgInfo.Name
            nameLbl.TextColor3 = UI_TEXT_DIM or Color3.fromRGB(160, 160, 170)
            nameLbl.Font = Enum.Font.GothamBold
            nameLbl.TextSize = 8
            nameLbl.TextXAlignment = Enum.TextXAlignment.Center
            nameLbl.Parent = btn

            if M.selectedBackground == bgInfo.Name then
                selectedBtn = btn
                btn.BackgroundColor3 = (UI_ACCENT or Color3.fromRGB(200, 200, 210)):Lerp(Color3.fromRGB(30, 30, 35), 0.55)
            end

            btn.MouseEnter:Connect(function()
                if selectedBtn ~= btn then
                    TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundTransparency = 0}):Play()
                end
                previewImage.Image = bgInfo.Asset
                previewLabel.Text = bgInfo.Name
                local accent = UI_ACCENT or Color3.fromRGB(255, 255, 255)
                previewImage.ImageColor3 = Color3.new(
                    math.clamp(0.55 + accent.R * 0.45, 0, 1),
                    math.clamp(0.55 + accent.G * 0.45, 0, 1),
                    math.clamp(0.55 + accent.B * 0.45, 0, 1)
                )
            end)
            btn.MouseLeave:Connect(function()
                if selectedBtn ~= btn then
                    TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundTransparency = 0.15}):Play()
                end
                previewImage.Image = M.getBackgroundAssetByName(M.selectedBackground)
                previewLabel.Text = M.selectedBackground or "Default"
                local accent = UI_ACCENT or Color3.fromRGB(255, 255, 255)
                previewImage.ImageColor3 = Color3.new(
                    math.clamp(0.55 + accent.R * 0.45, 0, 1),
                    math.clamp(0.55 + accent.G * 0.45, 0, 1),
                    math.clamp(0.55 + accent.B * 0.45, 0, 1)
                )
            end)

            btn.MouseButton1Click:Connect(function()
                if selectedBtn == btn then return end
                if selectedBtn then
                    local prevStroke = selectedBtn:FindFirstChildOfClass("UIStroke")
                    if prevStroke then prevStroke.Transparency = 0.65 end
                    selectedBtn.BackgroundColor3 = UI_BTN_BG or Color3.fromRGB(20, 20, 26)
                    selectedBtn.BackgroundTransparency = 0.15
                end
                selectedBtn = btn
                stroke.Transparency = 0.15
                btn.BackgroundColor3 = (UI_ACCENT or Color3.fromRGB(200, 200, 210)):Lerp(Color3.fromRGB(30, 30, 35), 0.55)
                btn.BackgroundTransparency = 0
                previewImage.Image = bgInfo.Asset
                previewLabel.Text = bgInfo.Name
                M.applyBackground(bgInfo.Name)
                saveCherryConfig()
            end)
        end
    end


    uiSectionHeader(PVis, "ESP")
    local _, setLineESP = uiToggleRow(PVis, "Tracer", M.lineESPEnabled, function(on)
        M.lineESPEnabled = on; cherryESPState.LineESP = on
    end)
    local _, setSpeedESP = uiToggleRow(PVis, "Speed Counter", M.speedESPEnabled, function(on)
        M.speedESPEnabled = on; cherryESPState.SpeedESP = on
    end)

    uiSectionHeader(PVis, "AVATAR SKINS")
    local _, setHeadless = uiToggleRow(PVis, "Headless", M.headlessEnabled, function(on)
        M.headlessEnabled = on
        pcall(function() M.applyHeadlessToChar(player.Character, on) end)
        saveCherryConfig()
    end)
    local _, setKorblox = uiToggleRow(PVis, "Korblox", M.korbloxEnabled, function(on)
        M.korbloxEnabled = on
        pcall(function() M.applyKorbloxToChar(player.Character, on) end)
        saveCherryConfig()
    end)
    local _, setFx3 = uiToggleRow(PVis, "FX3 Skin", M.fx3Enabled == true, function(on)
        M.fx3Enabled = on
        if on then
            pcall(function() M.applyAvatarFX3(player.Character) end)
        else
            pcall(function() M.clearAvatarFX3(player.Character) end)
        end
        saveCherryConfig()
    end)
    do
        local r = Instance.new("Frame"); r.ClipsDescendants=true; r.Size=UDim2.new(1,0,0,46)
        r.BackgroundColor3=UI_ROW_BG; r.BackgroundTransparency=0.03; r.BorderSizePixel=0; r.Parent=PVis; uiCardStyle(r)
        local l = Instance.new("TextLabel"); l.Position=UDim2.new(0,13,0,0); l.Size=UDim2.new(0.45,0,1,0)
        l.BackgroundTransparency=1; l.Text="FX3 Color"; l.TextColor3=UI_TEXT_PRIMARY; l.TextSize=13; l.Font=Enum.Font.GothamMedium; l.TextXAlignment=Enum.TextXAlignment.Left; l.Parent=r
        local v = Instance.new("TextLabel"); v.Position=UDim2.new(0.45,0,0,0); v.Size=UDim2.new(0.55,-10,1,0)
        v.BackgroundTransparency=1; v.Text=tostring(M.fx3Variant or "Black"); v.TextColor3=UI_ACCENT; v.Font=Enum.Font.GothamBold; v.TextSize=12; v.TextXAlignment=Enum.TextXAlignment.Right; v.Parent=r
        local btn = Instance.new("TextButton", r); btn.Size=UDim2.new(1,0,1,0); btn.BackgroundTransparency=1; btn.Text=""
        btn.Activated:Connect(function()
            M.fx3Variant = (M.fx3Variant == "White") and "Black" or "White"
            v.Text = M.fx3Variant
            M._fx3AppliedChar = nil
            if M.fx3Enabled then pcall(function() M.applyAvatarFX3(player.Character) end) end
            saveCherryConfig()
        end)
    end

    local _, setPoisonedHorns = uiToggleRow(PVis, "Poisoned Horns", M.poisonedHornsEnabled == true, function(on)
        M.poisonedHornsEnabled = on
        if on then
            pcall(function() M.applyCustomHorns(player.Character, "Poisoned") end)
        else
            pcall(function() M.clearCustomHorns(player.Character, "Poisoned") end)
        end
        saveCherryConfig()
    end)
    local _, setFieryHorns = uiToggleRow(PVis, "Fiery Horns", M.fieryHornsEnabled == true, function(on)
        M.fieryHornsEnabled = on
        if on then
            pcall(function() M.applyCustomHorns(player.Character, "Fiery") end)
        else
            pcall(function() M.clearCustomHorns(player.Character, "Fiery") end)
        end
        saveCherryConfig()
    end)
    local _, setValkyrie = uiToggleRow(PVis, "Valkyrie Helm", M.valkyrieHelmEnabled == true, function(on)
        M.valkyrieHelmEnabled = on
        if on then
            pcall(function() M.applyCustomHorns(player.Character, "Valkyrie") end)
        else
            pcall(function() M.clearCustomHorns(player.Character, "Valkyrie") end)
        end
        saveCherryConfig()
    end)
    uiSectionHeader(PVis, "CUSTOM SHIRTS")
    do
        local shirtOpts = {"None", "Cyber Y2K", "Vkei", "Pink Anime", "Y2K A", "Y2K B"}
        local shirtKeyToLabel = {
            None="None", CyberY2K="Cyber Y2K", Vkei="Vkei", PinkAnime="Pink Anime",
            Y2KA="Y2K A", Y2KB="Y2K B",
        }
        local shirtIdx = 1
        for i, o in ipairs(shirtOpts) do
            if o == (shirtKeyToLabel[M.customShirt or "None"] or "None") then shirtIdx = i break end
        end
        local _, setShirt = uiChoiceRow(PVis, "Shirt", shirtOpts, shirtIdx, function(v)
            local map = {
                ["None"]="None", ["Cyber Y2K"]="CyberY2K", ["Vkei"]="Vkei", ["Pink Anime"]="PinkAnime",
                ["Y2K A"]="Y2KA", ["Y2K B"]="Y2KB",
            }
            M.customShirt = map[v] or "None"
            pcall(function() M.applyCustomClothing(player.Character) end)
            saveCherryConfig()
        end)
    end

    uiSectionHeader(PVis, "CUSTOM PANTS")
    do
        local pantsOpts = {"None", "Polo", "Emo Y2K", "White", "Y2K A", "Y2K B"}
        local pantsKeyToLabel = {
            None="None", Polo="Polo", EmoY2K="Emo Y2K", White="White",
            Y2KA="Y2K A", Y2KB="Y2K B",
        }
        local pantsIdx = 1
        for i, o in ipairs(pantsOpts) do
            if o == (pantsKeyToLabel[M.customPants or "None"] or "None") then pantsIdx = i break end
        end
        local _, setPants = uiChoiceRow(PVis, "Pants", pantsOpts, pantsIdx, function(v)
            local map = {
                ["None"]="None", ["Polo"]="Polo", ["Emo Y2K"]="EmoY2K", ["White"]="White",
                ["Y2K A"]="Y2KA", ["Y2K B"]="Y2KB",
            }
            M.customPants = map[v] or "None"
            pcall(function() M.applyCustomClothing(player.Character) end)
            saveCherryConfig()
        end)
    end

    uiSectionHeader(PVis, "SKIN COMBOS")
    do
        -- Name input
        local nameRow = Instance.new("Frame")
        nameRow.ClipsDescendants = true
        nameRow.Size = UDim2.new(1, 0, 0, 44)
        nameRow.BackgroundColor3 = UI_ROW_BG
        nameRow.BackgroundTransparency = 0.1
        nameRow.BorderSizePixel = 0
        nameRow.Parent = PVis
        uiCardStyle(nameRow)
        local nameLbl = Instance.new("TextLabel")
        nameLbl.Position = UDim2.new(0, 13, 0, 0)
        nameLbl.Size = UDim2.new(0.35, 0, 1, 0)
        nameLbl.BackgroundTransparency = 1
        nameLbl.Text = "Combo Name"
        nameLbl.TextColor3 = UI_TEXT_PRIMARY
        nameLbl.TextSize = 13
        nameLbl.Font = Enum.Font.GothamMedium
        nameLbl.TextXAlignment = Enum.TextXAlignment.Left
        nameLbl.Parent = nameRow
        local nameBox = Instance.new("TextBox")
        nameBox.Position = UDim2.new(0.38, 0, 0.5, -14)
        nameBox.Size = UDim2.new(0.58, -10, 0, 28)
        nameBox.BackgroundColor3 = UI_BTN_BG
        nameBox.BorderSizePixel = 0
        nameBox.Text = ""
        nameBox.PlaceholderText = "e.g. duo look"
        nameBox.PlaceholderColor3 = Color3.fromRGB(120, 120, 130)
        nameBox.TextColor3 = UI_TEXT_PRIMARY
        nameBox.TextSize = 12
        nameBox.Font = Enum.Font.Gotham
        nameBox.ClearTextOnFocus = false
        nameBox.Parent = nameRow
        Instance.new("UICorner", nameBox).CornerRadius = UDim.new(0, 8)

        local statusLbl = Instance.new("TextLabel")
        statusLbl.Size = UDim2.new(1, -24, 0, 18)
        statusLbl.BackgroundTransparency = 1
        statusLbl.Text = ""
        statusLbl.TextColor3 = UI_ACCENT
        statusLbl.TextSize = 11
        statusLbl.Font = Enum.Font.Gotham
        statusLbl.TextXAlignment = Enum.TextXAlignment.Left
        statusLbl.Parent = PVis

        local function refreshComboChoice()
            -- rebuilt via choice row index; status only
        end

        local comboNames = M.getSkinComboNames and M.getSkinComboNames() or {}
        local choiceOpts = {"None"}
        for _, n in ipairs(comboNames) do
            table.insert(choiceOpts, n)
        end
        local choiceIdx = 1
        for i, o in ipairs(choiceOpts) do
            if o == (M.skinComboSelected or "None") then choiceIdx = i break end
        end

        local setComboChoice
        local _, setChoice = uiChoiceRow(PVis, "Load Combo", choiceOpts, choiceIdx, function(v)
            M.skinComboSelected = v
            if v ~= "None" then
                local ok, err = M.applySkinCombo(v)
                if ok then
                    statusLbl.Text = "loaded: " .. v
                    statusLbl.TextColor3 = Color3.fromRGB(100, 200, 120)
                else
                    statusLbl.Text = "fail: " .. tostring(err)
                    statusLbl.TextColor3 = Color3.fromRGB(255, 100, 100)
                end
            end
            saveCherryConfig()
        end)
        setComboChoice = setChoice

        -- Save button row
        local saveRow = Instance.new("Frame")
        saveRow.ClipsDescendants = true
        saveRow.Size = UDim2.new(1, 0, 0, 44)
        saveRow.BackgroundColor3 = UI_ROW_BG
        saveRow.BackgroundTransparency = 0.1
        saveRow.BorderSizePixel = 0
        saveRow.Parent = PVis
        uiCardStyle(saveRow)
        local saveBtn = Instance.new("TextButton")
        saveBtn.Size = UDim2.new(0.48, -8, 0, 30)
        saveBtn.Position = UDim2.new(0, 10, 0.5, -15)
        saveBtn.BackgroundColor3 = UI_BTN_BG
        saveBtn.BorderSizePixel = 0
        saveBtn.Text = "Save Combo"
        saveBtn.TextColor3 = UI_TEXT_PRIMARY
        saveBtn.TextSize = 12
        saveBtn.Font = Enum.Font.GothamBold
        saveBtn.Parent = saveRow
        Instance.new("UICorner", saveBtn).CornerRadius = UDim.new(0, 8)
        local delBtn = Instance.new("TextButton")
        delBtn.Size = UDim2.new(0.48, -8, 0, 30)
        delBtn.Position = UDim2.new(0.52, 0, 0.5, -15)
        delBtn.BackgroundColor3 = UI_BTN_BG
        delBtn.BorderSizePixel = 0
        delBtn.Text = "Delete Combo"
        delBtn.TextColor3 = Color3.fromRGB(255, 140, 140)
        delBtn.TextSize = 12
        delBtn.Font = Enum.Font.GothamBold
        delBtn.Parent = saveRow
        Instance.new("UICorner", delBtn).CornerRadius = UDim.new(0, 8)

        saveBtn.MouseButton1Click:Connect(function()
            local name = nameBox.Text
            local ok, err = M.saveSkinCombo(name)
            if ok then
                statusLbl.Text = "saved: " .. name .. " (rejoin script to refresh list)"
                statusLbl.TextColor3 = Color3.fromRGB(100, 200, 120)
                M.skinComboSelected = name
            else
                statusLbl.Text = "fail: " .. tostring(err)
                statusLbl.TextColor3 = Color3.fromRGB(255, 100, 100)
            end
        end)
        delBtn.MouseButton1Click:Connect(function()
            local name = nameBox.Text
            if name == "" or name == "None" then
                name = M.skinComboSelected
            end
            local ok, err = M.deleteSkinCombo(name)
            if ok then
                statusLbl.Text = "deleted: " .. tostring(name)
                statusLbl.TextColor3 = Color3.fromRGB(100, 200, 120)
            else
                statusLbl.Text = "fail: " .. tostring(err)
                statusLbl.TextColor3 = Color3.fromRGB(255, 100, 100)
            end
        end)

        -- Load by typed name (works immediately without rebuilding choice list)
        local loadRow = Instance.new("Frame")
        loadRow.ClipsDescendants = true
        loadRow.Size = UDim2.new(1, 0, 0, 44)
        loadRow.BackgroundColor3 = UI_ROW_BG
        loadRow.BackgroundTransparency = 0.1
        loadRow.BorderSizePixel = 0
        loadRow.Parent = PVis
        uiCardStyle(loadRow)
        local loadBtn = Instance.new("TextButton")
        loadBtn.Size = UDim2.new(1, -20, 0, 30)
        loadBtn.Position = UDim2.new(0, 10, 0.5, -15)
        loadBtn.BackgroundColor3 = UI_BTN_BG
        loadBtn.BorderSizePixel = 0
        loadBtn.Text = "Load Combo by Name"
        loadBtn.TextColor3 = UI_TEXT_PRIMARY
        loadBtn.TextSize = 12
        loadBtn.Font = Enum.Font.GothamBold
        loadBtn.Parent = loadRow
        Instance.new("UICorner", loadBtn).CornerRadius = UDim.new(0, 8)
        loadBtn.MouseButton1Click:Connect(function()
            local name = nameBox.Text
            if name == "" then name = M.skinComboSelected end
            local ok, err = M.applySkinCombo(name)
            if ok then
                statusLbl.Text = "loaded: " .. tostring(name)
                statusLbl.TextColor3 = Color3.fromRGB(100, 200, 120)
            else
                statusLbl.Text = "fail: " .. tostring(err)
                statusLbl.TextColor3 = Color3.fromRGB(255, 100, 100)
            end
        end)
    end

