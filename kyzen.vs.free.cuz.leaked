    uiActionRow(PUtil, "Reset Mobile Positions", function() M.resetMobilePositions() end)

    uiSectionHeader(PUtil, "AVATAR")
    do
        local packNames = {}
        for n in pairs(M.PACKS or {}) do table.insert(packNames, n) end
        table.sort(packNames)
        if #packNames == 0 then packNames = {"Adidas Sports"} end
        local idx = 1
        for i,n in ipairs(packNames) do if n == M.animPack then idx = i break end end
        local _, setPack = uiCycleRow and uiCycleRow(PUtil, "Animation Pack", packNames, idx, function(name)
            M.animPack = name
            saveCherryConfig()
        end) or nil
        if not uiCycleRow then
            local r = Instance.new("Frame"); r.ClipsDescendants=true; r.Size=UDim2.new(1,0,0,46)
            r.BackgroundColor3=UI_ROW_BG; r.BackgroundTransparency=0.03; r.BorderSizePixel=0; r.Parent=PUtil; uiCardStyle(r)
            local l = Instance.new("TextLabel"); l.Position=UDim2.new(0,13,0,0); l.Size=UDim2.new(0.4,0,1,0)
            l.BackgroundTransparency=1; l.Text="Anim Pack"; l.TextColor3=UI_TEXT_PRIMARY; l.TextSize=13; l.Font=Enum.Font.GothamMedium; l.TextXAlignment=Enum.TextXAlignment.Left; l.Parent=r
            local v = Instance.new("TextLabel"); v.Position=UDim2.new(0.4,0,0,0); v.Size=UDim2.new(0.6,-10,1,0)
            v.BackgroundTransparency=1; v.Text=tostring(M.animPack or ""); v.TextColor3=UI_ACCENT; v.Font=Enum.Font.GothamBold; v.TextSize=11; v.TextXAlignment=Enum.TextXAlignment.Right; v.Parent=r
            local btn = Instance.new("TextButton", r); btn.Size=UDim2.new(1,0,1,0); btn.BackgroundTransparency=1; btn.Text=""
            btn.Activated:Connect(function()
                idx = idx % #packNames + 1
                M.animPack = packNames[idx]
                v.Text = M.animPack
                saveCherryConfig()
            end)
        end
    end
