        posLbl.BackgroundTransparency=1; posLbl.Text=tostring(M.tabSidePosition or "Left"); posLbl.TextColor3=UI_ACCENT; posLbl.Font=Enum.Font.GothamBold; posLbl.TextSize=12; posLbl.TextXAlignment=Enum.TextXAlignment.Right; posLbl.Parent=r
        local order = {"Left", "Top", "Bottom", "None"}
